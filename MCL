# Pull a Windows path out of a finding so the report can render it as its own
# clickable field instead of burying it in a sentence.
function Get-FindingPath($detail, $evidence) {
    foreach ($src in @($detail, $evidence)) {
        if (-not $src) { continue }
        $m = [regex]::Match([string]$src, '[A-Za-z]:\\[^"|<>*?\r\n]+?\.[A-Za-z0-9]{1,6}(?=$|[\s"|,;)])')
        if (-not $m.Success) { $m = [regex]::Match([string]$src, '[A-Za-z]:\\[^"|<>*?\r\n]{3,}') }
        if ($m.Success) { return $m.Value.TrimEnd('.', ' ', ',', ';', ')') }
    }
    return $null
}

