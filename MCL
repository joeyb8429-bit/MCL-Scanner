function Build-FPRegex($patterns) {
    $escaped = $patterns | ForEach-Object { [regex]::Escape($_) }
    return [regex]::new(
        ($escaped -join "|"),
        [System.Text.RegularExpressions.RegexOptions]::IgnoreCase -bor
        [System.Text.RegularExpressions.RegexOptions]::Compiled
    )
}

