# =====================================================
# SNAPSHOT
# =====================================================
function Get-CurrentSnapshot {
    $snap = [ordered]@{
        Timestamp    = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        TimestampUtc = (Get-Date).ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")
        Computer     = $env:COMPUTERNAME
        User         = $env:USERNAME
        BootTime     = ""
        BAM = @(); MUICache = @(); UserAssist = @(); Shimcache = @(); Prefetch = @()
    }
    try {
        $os = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
        $snap.BootTime = $os.LastBootUpTime.ToString("yyyy-MM-dd HH:mm:ss")
    } catch {}

    try {
        $bamBase = "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
        if (Test-Path $bamBase) {
            $tz   = Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\TimeZoneInformation" -ErrorAction SilentlyContinue
            $bias = if ($tz -and $null -ne $tz.ActiveTimeBias) { [int64]$tz.ActiveTimeBias } else { 0L }
            foreach ($bk in @(Get-ChildItem $bamBase -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -ne "S-1-5-18" })) {
                $regKey = Get-Item $bk.PSPath -ErrorAction SilentlyContinue
                if (-not $regKey) { continue }
                $propNames = try { $regKey.GetValueNames() } catch { @() }
                foreach ($prop in $propNames) {
                    if ($prop -in @("SequenceNumber","Version","")) { continue }
                    try {
                        $raw = $regKey.GetValue($prop)
                        if (-not $raw -or $raw -isnot [byte[]] -or $raw.Length -lt 8) { continue }
                        $ft = [System.BitConverter]::ToInt64($raw[0..7], 0)
                        if ($ft -le 0 -or $ft -gt 999999999999999999) { continue }
                        $lr = [DateTime]::FromFileTimeUtc($ft).AddMinutes(-$bias).ToString("yyyy-MM-dd HH:mm:ss")
                        $snap.BAM += @{ Path = $prop; LastRun = $lr; SID = $bk.PSChildName }
                    } catch { continue }
                }
            }
        }
    } catch {}

    try {
        $muiPath = "HKCU:\SOFTWARE\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
        $muiEntries = Get-ItemProperty $muiPath -ErrorAction Stop
        $muiEntries.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
            $snap.MUICache += @{ Entry = $_.Name; Value = if ($_.Value) { $_.Value.ToString() } else { "" } }
        }
    } catch {}

    try {
        $uaBase = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\UserAssist"
        if (Test-Path $uaBase) {
            foreach ($k in @(Get-ChildItem $uaBase -ErrorAction SilentlyContinue)) {
                $countPath = "$($k.PSPath)\Count"
                if (Test-Path $countPath) {
                    $props = Get-ItemProperty $countPath -ErrorAction SilentlyContinue
                    if ($props) {
                        $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                            $snap.UserAssist += @{ Encoded = $_.Name; Decoded = (UnROT13 $_.Name) }
                        }
                    }
                }
            }
        }
    } catch {}

    foreach ($e in (Get-ShimcacheEntries)) { $snap.Shimcache += @{ Path = $e } }

    $pfPath = "C:\Windows\Prefetch"
    if (Test-Path $pfPath) {
        foreach ($pf in @(Get-ChildItem $pfPath -Filter "*.pf" -File -Force -ErrorAction SilentlyContinue)) {
            $info    = Get-PrefetchInfo $pf.FullName
            $lastRun = if ($info.Times.Count -gt 0) { $info.Times[0].ToString("yyyy-MM-dd HH:mm:ss") } else { $pf.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") }
            # key on the EXE name, not the filename -- the filename embeds a path
            # hash that changes on every Roblox client update, which produced
            # bogus ADDED+DELETED pairs for the same program in v4.4.
            $base = [System.IO.Path]::GetFileNameWithoutExtension($pf.Name)
            $exe  = if ($base -match '^(.+)-[0-9A-F]{8}$') { $Matches[1] } else { $base }
            $snap.Prefetch += @{ Name = $pf.Name; Exe = $exe; LastRun = $lastRun; RunCount = $info.RunCount; Parsed = $info.Parsed }
        }
    }
    return $snap
}

# ---- FIX (v4.5): v4.4 regex-scraped the raw AppCompatCache blob, which pulled
# ---- in adjacent bytes -- your own run showed "OneDrive.App.exe$" and
# ---- "tauri-app.exeT". Trailing junk is now stripped and entries validated.
function Get-ShimcacheEntries {
    $out  = [System.Collections.Generic.List[string]]::new()
    $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    try {
        $shimPath = "HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\AppCompatCache"
        if (-not (Test-Path $shimPath)) { return $out }
        $shimRaw = (Get-ItemProperty $shimPath -ErrorAction Stop).AppCompatCache
        if (-not $shimRaw -or $shimRaw.Length -le 16) { return $out }
        $ustr = [System.Text.Encoding]::Unicode.GetString($shimRaw)
        foreach ($m in [regex]::Matches($ustr, '[A-Za-z]:\\[^\x00-\x1F"<>|*?]{4,240}')) {
            $val = $m.Value.Trim()
            # strip trailing non-path junk pulled in from the adjacent record
            $val = $val -replace '[^\x20-\x7E]+$', ''
            if ($val -match '^(.*\.[A-Za-z0-9]{1,6})') { $val = $Matches[1] }
            $val = $val.TrimEnd('$','.',' ')
            if ($val.Length -gt 5 -and $seen.Add($val)) { $out.Add($val) | Out-Null }
        }
    } catch {}
    return $out
}

function Save-Snapshot($snap) {
    try {
        # Archive the outgoing baseline before overwriting it. v4.5.x destroyed
        # the prior state on every run, so a scan that declined the comparison
        # also erased the only record of what the machine looked like before.
        if (Test-Path $snapshotPath) {
            try {
                $stamp = (Get-Item $snapshotPath).LastWriteTime.ToString('yyyyMMdd_HHmmss')
                $archiveDir = Join-Path (Split-Path $snapshotPath -Parent) "cheat_scan_baselines"
                if (-not (Test-Path $archiveDir)) { New-Item -ItemType Directory -Path $archiveDir -Force | Out-Null }
                Copy-Item $snapshotPath (Join-Path $archiveDir "snapshot_$stamp.json") -Force
                if (Test-Path "$snapshotPath.sha256") {
                    Copy-Item "$snapshotPath.sha256" (Join-Path $archiveDir "snapshot_$stamp.json.sha256") -Force
                }
            } catch {}
        }
        $json = $snap | ConvertTo-Json -Depth 6 -Compress
        $json | Out-File $snapshotPath -Encoding UTF8 -Force
        # integrity marker so a tampered baseline is at least detectable
        $h = Get-FileSha256 $snapshotPath
        "$h" | Out-File "$snapshotPath.sha256" -Encoding ASCII -Force
        return $h
    } catch { return $null }
}

function Load-PreviousSnapshot {
    if (-not (Test-Path $snapshotPath)) { return $null }
    try {
        $actual = Get-FileSha256 $snapshotPath
        $expectedFile = "$snapshotPath.sha256"
        $script:BaselineIntact = $null
        if (Test-Path $expectedFile) {
            $expected = (Get-Content $expectedFile -Raw -ErrorAction SilentlyContinue).Trim()
            $script:BaselineIntact = ($expected -eq $actual)
        }
        $raw = Get-Content $snapshotPath -Raw -Encoding UTF8 | ConvertFrom-Json
        return [ordered]@{
            Timestamp  = $raw.Timestamp
            BootTime   = $raw.BootTime
            Computer   = $raw.Computer
            User       = $raw.User
            Hash       = $actual
            BAM        = @($raw.BAM        | ForEach-Object { @{ Path = $_.Path } })
            MUICache   = @($raw.MUICache   | ForEach-Object { @{ Entry = $_.Entry } })
            UserAssist = @($raw.UserAssist | ForEach-Object { @{ Encoded = $_.Encoded } })
            Shimcache  = @($raw.Shimcache  | ForEach-Object { @{ Path = $_.Path } })
            Prefetch   = @($raw.Prefetch   | ForEach-Object { @{ Name = $_.Name; Exe = $_.Exe } })
        }
    } catch { return $null }
}

# =====================================================
# DELTA -- HashSet based (v4.4 used -notcontains, O(n^2) over ~900 entries)
# =====================================================
function Compare-Snapshots($previous, $current) {
    Write-Header "SNAPSHOT DELTA" "Yellow"
    Write-Info "Previous : $($previous.Timestamp)"
    Write-Info "Current  : $($current.Timestamp)"

    if ($null -ne $script:BaselineIntact) {
        if ($script:BaselineIntact) { Write-OK "Baseline integrity marker OK" }
        else {
            Write-Critical "BASELINE HASH MISMATCH -- the snapshot file was modified between scans"
            Add-Finding -Section "Snapshot Delta" -Type "BaselineTampered" `
                -Detail "Snapshot hash does not match its recorded marker" -Severity "Critical" `
                -Evidence $snapshotPath
        }
    } else {
        Write-Warn "No integrity marker found at: $snapshotPath.sha256"
        Write-Warn "  The baseline JSON was read, but its hash sidecar is missing. Either it"
        Write-Warn "  predates v4.5, or the sidecar was deleted/moved after the last scan."
        Write-Warn "  Until it is present, the baseline is NOT tamper-evident."
    }

    # Shimcache only flushes to the registry at SHUTDOWN. Comparing within one
    # boot session can never show a change, so a same-boot 'no change' result
    # is meaningless rather than reassuring.
    $sameBoot = $previous.BootTime -and $current.BootTime -and ($previous.BootTime -eq $current.BootTime)
    if ($sameBoot) {
        Write-Warn "Same boot session as the baseline -- Shimcache CANNOT change; that comparison is not evidence"
    }
    Write-Host ""

    function Compare-Set($label, $prevList, $currList, $fpCheck, $category, $treatDeleteAs) {
        $prevSet = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        foreach ($p in $prevList) { if ($p) { [void]$prevSet.Add([string]$p) } }
        $currSet = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        foreach ($c in $currList) { if ($c) { [void]$currSet.Add([string]$c) } }

        $added   = @($currSet | Where-Object { -not $prevSet.Contains($_) })
        $deleted = @($prevSet | Where-Object { -not $currSet.Contains($_) })

        Write-Host "  $label : prev=$($prevSet.Count) curr=$($currSet.Count) added=$($added.Count) deleted=$($deleted.Count)" -ForegroundColor White

        foreach ($e in ($added | Sort-Object)) {
            $isFP = if ($fpCheck) { & $fpCheck $e } else { $false }
            $m    = if ($isFP) { $null } else { Test-CheatMatch $e }
            if ($isFP) { Add-FP "$category-Added" $e "matched $label false-positive list"; continue }
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                $txt = "$label ADDED: $e -- matches '$($m.Term)' [Tier $($m.Tier)/$($m.Match)]"
                if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                Add-Finding -Section "Snapshot Delta" -Type "$category-Added" -Detail $e `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                $deltaFindings.Add([PSCustomObject]@{ Category=$label; Change="ADDED-HIT"; Entry=$e; Note="$($m.Term) [Tier $($m.Tier)]"; Severity=$sev })
                Add-Timeline "DELTA $label added: $e ($($m.Term))"
            } else {
                $deltaFindings.Add([PSCustomObject]@{ Category=$label; Change="ADDED"; Entry=$e; Note="new, no match"; Severity="Context" })
            }
        }

        # ---- volume check: mass removal is evidence in its own right ----
        if ($prevSet.Count -gt 0) {
            $delPct = [math]::Round(($deleted.Count / $prevSet.Count) * 100, 1)
            $wiped  = ($currSet.Count -eq 0 -and $prevSet.Count -gt 20)
            $bulk   = ($deleted.Count -ge 15) -or ($delPct -ge 10 -and $deleted.Count -ge 5)
            $delProfile = Test-MaintenanceDeletion $deleted
            if ($wiped) {
                Write-Critical "$label WAS EMPTIED: $($prevSet.Count) entries -> 0. This does not happen on its own."
                Add-Finding -Section "Snapshot Delta" -Type "$category-Wiped" `
                    -Detail "$label went from $($prevSet.Count) entries to 0" -Severity "Critical" -Tier "A" `
                    -Evidence "total removal of an artifact store between scans"
                Add-Timeline "CRITICAL: $label emptied between scans"
            } elseif ($bulk -and $delProfile.LooksLikeOS) {
                # Windows trimmed its own caches. Recorded, never escalated.
                Write-Ctx "$label bulk removal: $($deleted.Count) of $($prevSet.Count) ($delPct%) -- $($delProfile.OsCount) are Windows servicing binaries ($($delProfile.OsPercent)%)"
                Write-Ctx "  Consistent with Storage Sense / Disk Cleanup / cache trimming, NOT targeted cleanup."
                Add-Finding -Section "Snapshot Delta" -Type "$category-MaintenanceTrim" `
                    -Detail "$($deleted.Count) of $($prevSet.Count) $label entries removed ($delPct%)" -Severity "Context" `
                    -Evidence "$($delProfile.OsCount) removed entries are Windows servicing binaries (Defender, NGen, defrag, etc). A cleaner has no reason to delete these; the OS trims oldest-first."
            } elseif ($bulk) {
                Write-Critical "$label BULK REMOVAL: $($deleted.Count) of $($prevSet.Count) entries gone ($delPct%)"
                Write-Critical "  Only $($delProfile.OsCount) are Windows servicing binaries -- this removal was SELECTIVE."
                Add-Finding -Section "Snapshot Delta" -Type "$category-BulkDeleted" `
                    -Detail "$($deleted.Count) of $($prevSet.Count) $label entries removed ($delPct%)" -Severity "Critical" -Tier "A" `
                    -Evidence "selective removal: only $($delProfile.OsCount)/$($deleted.Count) were OS servicing binaries, so this is not routine cache trimming"
                Add-Timeline "CRITICAL: $label selective bulk removal ($($deleted.Count) entries)"
            }
        }

        foreach ($e in ($deleted | Sort-Object)) {
            $m   = Test-CheatMatch $e
            # Deletion of a CHEAT-named artifact is meaningful. Deletion of an
            # ordinary one is routine cache eviction and is context only.
            $sev = if ($m -and $m.Tier -eq "A") { "Critical" } else { $treatDeleteAs }
            $txt = "$label DELETED: $e"
            if ($sev -eq "Critical") { Write-Critical "$txt -- was '$($m.Term)'" } else { Write-Ctx $txt }
            Add-Finding -Section "Snapshot Delta" -Type "$category-Deleted" -Detail $e `
                -Value $(if ($m) { $m.Term } else { "" }) -Severity $sev -Tier $(if ($m) { $m.Tier } else { "" })
            $deltaFindings.Add([PSCustomObject]@{ Category=$label; Change="DELETED"; Entry=$e; Note="no longer present"; Severity=$sev })
        }
    }

    Compare-Set "BAM" @($previous.BAM | ForEach-Object { $_.Path }) @($current.BAM | ForEach-Object { $_.Path }) `
        { param($e) Is-BAMFalsePositive $e } "BAM" "Review"
    Compare-Set "MUICache" @($previous.MUICache | ForEach-Object { $_.Entry }) @($current.MUICache | ForEach-Object { $_.Entry }) `
        { param($e) Is-MUIFalsePositive $e } "MUICache" "Context"
    Compare-Set "UserAssist" @($previous.UserAssist | ForEach-Object { UnROT13 $_.Encoded }) @($current.UserAssist | ForEach-Object { UnROT13 $_.Encoded }) `
        { param($e) Is-UAFalsePositive $e } "UserAssist" "Context"

    if ($sameBoot) {
        Write-Skip "Shimcache : comparison skipped (same boot session -- cache has not been flushed)"
        $deltaFindings.Add([PSCustomObject]@{ Category="Shimcache"; Change="SKIPPED"; Entry="same boot session"; Note="AppCompatCache only writes at shutdown"; Severity="Context" })
    } else {
        Compare-Set "Shimcache" @($previous.Shimcache | ForEach-Object { $_.Path }) @($current.Shimcache | ForEach-Object { $_.Path }) `
            { param($e) $script:shimFPRegex.IsMatch($e) } "Shimcache" "Context"
    }

    # Prefetch compared by EXE NAME, not filename -- see Get-CurrentSnapshot.
    Compare-Set "Prefetch" @($previous.Prefetch | ForEach-Object { $_.Exe }) @($current.Prefetch | ForEach-Object { $_.Exe }) `
        $null "Prefetch" "Context"

    Mark-Ran "Snapshot Delta"
    Write-Host ""
    Write-Host "  Delta rows recorded: $($deltaFindings.Count) (scored: $($script:Sections['Snapshot Delta'].Critical + $script:Sections['Snapshot Delta'].Review))" -ForegroundColor DarkGray
    Write-SectionResult "Snapshot Delta"
}

# Names Windows itself runs for servicing/maintenance. A removal set full of
# these is the OS trimming its caches, not somebody cleaning up after a cheat.
$osMaintenanceNames = @(
    "msmpeng","mrt","am_delta","am_base","mpsigstub","mpcmdrun","nissrv",
    "ngen","ngentask","winsat","defrag","cleanmgr","dism","sfc",
    "tiworker","trustedinstaller","sppsvc","sppextcomobj","slui",
    "wuauclt","usoclient","mousocoreworker","sihclient","waasmedic",
    "compattelrunner","devicecensus","dusmsvc","disksnapshot",
    "searchprotocolhost","searchfilterhost","searchindexer",
    "backgroundtaskhost","systemsettings","runtimebroker",
    "wermgr","werfault","dllhost","wmiprvse","taskhostw","conhost",
    "smartscreen","securityhealthservice","securityhealthsystray",
    "consent","lockapp","shellexperiencehost","startmenuexperiencehost",
    "audiodg","spoolsv","fontdrvhost","ctfmon","sihost","dwm"
)

function Test-MaintenanceDeletion($deletedList) {
    # Returns a profile object describing WHY entries disappeared, so the
    # caller can distinguish anti-forensic cleanup from routine trimming.
    $osHits = 0
    foreach ($e in $deletedList) {
        if (-not $e) { continue }
        $leaf = try { [IO.Path]::GetFileNameWithoutExtension(([string]$e).ToLower()) } catch { ([string]$e).ToLower() }
        $leaf = $leaf -replace '-[0-9a-f]{8}$',''
        foreach ($os in $osMaintenanceNames) {
            if ($leaf -eq $os -or $leaf -like "$os*") { $osHits++; break }
        }
    }
    $total = [Math]::Max($deletedList.Count, 1)
    $osPct = [math]::Round(($osHits / $total) * 100, 1)
    return [PSCustomObject]@{
        OsCount      = $osHits
        OsPercent    = $osPct
        LooksLikeOS  = ($osHits -ge 3 -or $osPct -ge 25)
    }
}

# =====================================================
# SECTION 1 -- SYSTEM PROTECTION
# =====================================================
function Run-Section1 {
    Write-Header "SECTION 1 -- SYSTEM PROTECTION"
    Mark-Ran "System Protection"

    Write-Info "Windows Defender..."
    try {
        $mp = Get-MpComputerStatus -ErrorAction Stop
        if ($mp.AntivirusEnabled) { Write-OK "Defender antivirus: Enabled" }
        else { Write-Fail "Defender antivirus: DISABLED"
               Add-Finding -Section "System Protection" -Type "DefenderDisabled" -Detail "Antivirus disabled" -Severity "Review"
               Add-Timeline "Defender antivirus disabled" }
        if ($mp.RealTimeProtectionEnabled) { Write-OK "Real-time protection: Enabled" }
        else { Write-Fail "Real-time protection: DISABLED"
               Add-Finding -Section "System Protection" -Type "RTPDisabled" -Detail "Real-time protection disabled" -Severity "Review" }
        if ($mp.IsTamperProtected) { Write-OK "Tamper protection: Enabled" }
        else { Write-Warn "Tamper protection: Disabled"
               Add-Finding -Section "System Protection" -Type "TamperDisabled" -Detail "Tamper protection disabled" -Severity "Info" }
    } catch { Write-Warn "Could not query Defender status"; Mark-Skipped "System Protection" "Get-MpComputerStatus failed" }

    Write-Info "Defender exclusions..."
    try {
        $prefs = Get-MpPreference -ErrorAction Stop
        $all = @()
        $all += ($prefs.ExclusionPath      | ForEach-Object { @{ Type="Path";      Value=$_ } })
        $all += ($prefs.ExclusionProcess   | ForEach-Object { @{ Type="Process";   Value=$_ } })
        $all += ($prefs.ExclusionExtension | ForEach-Object { @{ Type="Extension"; Value=$_ } })
        $all = @($all | Where-Object { $_.Value })
        if ($all.Count -eq 0) { Write-OK "No Defender exclusions" }
        foreach ($ex in $all) {
            $m = Test-CheatMatch $ex.Value
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Hit "Defender exclusion [$($ex.Type)]: $($ex.Value) -- matches '$($m.Term)'"
                Add-Finding -Section "System Protection" -Type "SuspExclusion" -Detail "$($ex.Type): $($ex.Value)" `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                Add-Timeline "Suspicious Defender exclusion: $($ex.Value)"
            } else {
                Write-Amber "Defender exclusion [$($ex.Type)]: $($ex.Value)"
                Add-Finding -Section "System Protection" -Type "Exclusion" -Detail "$($ex.Type): $($ex.Value)" -Severity "Review"
            }
        }
    } catch { Write-Warn "Could not query Defender exclusions" }

    Write-Info "Memory Integrity (HVCI)..."
    try {
        $dg = Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard -ErrorAction Stop
        if ($dg -and ($dg.SecurityServicesRunning -contains 2)) { Write-OK "Memory Integrity: enforced" }
        else { Write-Warn "Memory Integrity: not enforced"
               Add-Finding -Section "System Protection" -Type "HVCIDisabled" -Detail "Memory Integrity not enforced" -Severity "Info" }
    } catch { Write-Warn "Could not query Memory Integrity" }

    Write-Info "Vulnerable driver blocklist..."
    try {
        $blKey = "HKLM:\SYSTEM\CurrentControlSet\Control\CI\Config"
        if (Test-Path $blKey) {
            $bl = (Get-ItemProperty $blKey -ErrorAction SilentlyContinue).VulnerableDriverBlocklistEnable
            if ($bl -eq 1) { Write-OK "Driver blocklist: Enabled" }
            else { Write-Warn "Driver blocklist: Disabled"
                   Add-Finding -Section "System Protection" -Type "BlocklistDisabled" -Detail "Driver blocklist off" -Severity "Review" }
        }
    } catch {}

    Write-Info "AMSI providers..."
    try {
        $amsiKey = "HKLM:\SOFTWARE\Microsoft\AMSI\Providers"
        if (Test-Path $amsiKey) {
            $providers = @(Get-ChildItem $amsiKey -ErrorAction SilentlyContinue)
            if ($providers.Count -gt 0) { Write-OK "AMSI providers: $($providers.Count)" }
            else { Write-Fail "No AMSI providers -- possible bypass"
                   Add-Finding -Section "System Protection" -Type "AMSIStripped" -Detail "No AMSI providers registered" -Severity "Review" }
        }
    } catch {}

    Write-Info "WMI event subscriptions..."
    try {
        $consumers = @(Get-CimInstance -Namespace root\subscription -ClassName __EventConsumer -ErrorAction Stop)
        $n = 0
        foreach ($c in $consumers) {
            $isFP = $false
            foreach ($kw in $knownWmiConsumers) { if ($c.Name -like "*$kw*") { $isFP = $true; break } }
            if ($isFP) { Add-FP "WMIConsumer" $c.Name "known-good consumer"; continue }
            Write-Amber "Unrecognised WMI consumer: $($c.Name)"
            Add-Finding -Section "Persistence" -Type "WMIConsumer" -Detail $c.Name -Severity "Review"
            Add-Timeline "WMI persistence consumer: $($c.Name)"
            $n++
        }
        if ($n -eq 0) { Write-OK "No unrecognised WMI subscriptions" }
    } catch { Write-Skip "WMI subscription check unavailable" }

    Write-SectionResult "System Protection"
}

# =====================================================
# SECTION 2 -- NETWORK & DNS
# =====================================================
function Run-Section2 {
    Write-Header "SECTION 2 -- NETWORK & DNS"
    Mark-Ran "Network & DNS"

    # ---- FIX (v4.5): v4.4 compared $suspiciousDomains against RemoteAddress,
    # ---- which is an IP. That check could never fire -- a permanent false
    # ---- all-clear. We now resolve the remote IP to a hostname (cached) and
    # ---- match on that, and separately flag suspicious ports.
    Write-Info "Active connections..."
    try {
        $conns = @(Get-NetTCPConnection -State Established -ErrorAction Stop)
        $n = 0
        $dnsCacheMap = @{}
        try {
            foreach ($e in (Get-DnsClientCache -ErrorAction SilentlyContinue)) {
                if ($e.Data) { $dnsCacheMap[$e.Data] = $e.Entry }
            }
        } catch {}
        foreach ($c in $conns) {
            $hostName = $dnsCacheMap[$c.RemoteAddress]
            if ($hostName) {
                foreach ($d in $suspiciousDomains) {
                    if ($hostName.ToLower() -like "*$($d.ToLower())*") {
                        Write-Hit "Connection to $hostName ($($c.RemoteAddress):$($c.RemotePort))"
                        Add-Finding -Section "Network & DNS" -Type "SuspConnection" `
                            -Detail "$hostName ($($c.RemoteAddress):$($c.RemotePort))" -Value $d -Severity "Critical" -Tier "A"
                        $n++
                    }
                }
            }
            if ($suspiciousPorts -contains $c.RemotePort) {
                Write-Amber "Connection on unusual port: $($c.RemoteAddress):$($c.RemotePort)"
                Add-Finding -Section "Network & DNS" -Type "SuspPort" -Detail "$($c.RemoteAddress):$($c.RemotePort)" -Severity "Review"
                $n++
            }
        }
        if ($n -eq 0) { Write-OK "No suspicious active connections" }
    } catch { Write-Skip "Could not query TCP connections"; Mark-Skipped "Network & DNS" "Get-NetTCPConnection failed" }

    Write-Info "DNS cache..."
    try {
        $n = 0
        foreach ($e in (Get-DnsClientCache -ErrorAction Stop)) {
            $name = $e.Entry.ToLower()
            foreach ($d in $suspiciousDomains) {
                if ($name -like "*$($d.ToLower())*") {
                    Write-Hit "DNS cache: $name"
                    Add-Finding -Section "Network & DNS" -Type "DNSCache" -Detail $name -Value $d -Severity "Critical" -Tier "A"
                    Add-Timeline "DNS cache: $name"
                    $n++
                }
            }
        }
        if ($n -eq 0) { Write-OK "No suspicious DNS cache entries" }
    } catch { Write-Skip "DNS cache unavailable" }

    Write-Info "Hosts file..."
    $hostsPath = "C:\Windows\System32\drivers\etc\hosts"
    if (Test-Path $hostsPath) {
        $n = 0
        foreach ($line in (Get-Content $hostsPath -ErrorAction SilentlyContinue | Where-Object { $_ -notmatch "^\s*#" -and $_.Trim() })) {
            foreach ($d in $suspiciousDomains) {
                if ($line -like "*$d*") {
                    Write-Amber "Hosts entry: $line"
                    Add-Finding -Section "Network & DNS" -Type "HostsEntry" -Detail $line -Value $d -Severity "Review"
                    $n++
                }
            }
        }
        if ($n -eq 0) { Write-OK "Hosts file clean" }
    }
    Write-SectionResult "Network & DNS"
}

# =====================================================
# SECTION 3 -- EXECUTION vs PRESENCE ARTIFACTS
#
# v4.4 scored Shimcache/MUICache/AmCache identically to BAM/Prefetch. Those
# artifacts do NOT prove execution -- Shimcache and MUICache are populated by
# Explorer merely displaying or enumerating a file, and AmCache's
# InventoryApplicationFile records files that are simply PRESENT on disk.
# They are now a separate section and can never be the sole basis of a verdict.
# =====================================================
function Run-Section3 {
    Write-Header "SECTION 3 -- EXECUTION & PRESENCE ARTIFACTS"
    Mark-Ran "Execution Artifacts"
    Mark-Ran "Presence Artifacts"

    # ---------- PRESENCE: MUICache ----------
    Write-Info "MUICache (presence, not execution)..."
    try {
        $muiPath = "HKCU:\SOFTWARE\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
        $mui = Get-ItemProperty $muiPath -ErrorAction Stop
        $n = 0
        $mui.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
            $entry = $_.Name
            if (Is-MUIFalsePositive $entry) { Add-FP "MUICache" $entry "MUICache FP list"; return }
            $m = Test-CheatMatch $entry
            if ($m) {
                $sev = Get-SeverityForMatch $m "Review"   # presence never Critical alone
                $txt = "MUICache: $entry -- '$($m.Term)' [Tier $($m.Tier)/$($m.Match)]"
                if ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                Add-Finding -Section "Presence Artifacts" -Type "MUICache" -Detail $entry `
                    -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence "file was displayed by Explorer; does NOT prove execution"
                $n++
            }
        }
        if ($n -eq 0) { Write-OK "MUICache: nothing" }
    } catch { Write-Skip "MUICache unavailable" }

    # ---------- EXECUTION: UserAssist ----------
    Write-Info "UserAssist (proves GUI launch)..."
    try {
        $uaBase = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\UserAssist"
        $n = 0
        foreach ($k in @(Get-ChildItem $uaBase -ErrorAction SilentlyContinue)) {
            $countPath = "$($k.PSPath)\Count"
            if (-not (Test-Path $countPath)) { continue }
            $props = Get-ItemProperty $countPath -ErrorAction SilentlyContinue
            if (-not $props) { continue }
            $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                $decoded = UnROT13 $_.Name
                if (Is-UAFalsePositive $decoded) { Add-FP "UserAssist" $decoded "UserAssist FP list"; return }
                $m = Test-CheatMatch $decoded
                if ($m) {
                    $sev = Get-SeverityForMatch $m "Critical"
                    $txt = "UserAssist: $decoded -- '$($m.Term)' [Tier $($m.Tier)/$($m.Match)]"
                    if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                    Add-Finding -Section "Execution Artifacts" -Type "UserAssist" -Detail $decoded `
                        -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence "Explorer-launched"
                    Add-Timeline "UserAssist: $decoded"
                    $n++
                }
            }
        }
        if ($n -eq 0) { Write-OK "UserAssist: nothing" }
    } catch { Write-Skip "UserAssist unavailable" }

    # ---------- PRESENCE: Shimcache ----------
    Write-Info "Shimcache (presence, not execution)..."
    $shim = Get-ShimcacheEntries
    if ($shim.Count -eq 0) {
        Write-Critical "AppCompatCache returned ZERO entries. It normally holds hundreds."
        Write-Critical "  Either the value was cleared, or it is unreadable. This is NOT a clean result."
        Add-Finding -Section "Presence Artifacts" -Type "ShimcacheEmpty" `
            -Detail "AppCompatCache contains no entries" -Severity "Critical" -Tier "A" `
            -Evidence "the cache is populated by normal Windows use; an empty one indicates removal or read failure"
    }
    $n = 0
    foreach ($val in $shim) {
        if ($script:shimFPRegex.IsMatch($val)) { Add-FP "Shimcache" $val "Shimcache FP list"; continue }
        $m = Test-CheatMatch $val
        if ($m) {
            $sev = Get-SeverityForMatch $m "Review"
            $txt = "Shimcache: $val -- '$($m.Term)' [Tier $($m.Tier)/$($m.Match)]"
            if ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
            Add-Finding -Section "Presence Artifacts" -Type "Shimcache" -Detail $val `
                -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence "path was enumerated; does NOT prove execution"
            $n++
        }
    }
    if ($n -eq 0) { Write-OK "Shimcache: nothing" }

    # ---------- EXECUTION: BAM ----------
    Write-Info "BAM (proves execution)..."
    $bamOk = $false
    try {
        $bamBase = "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings"
        if (Test-Path $bamBase) {
            $bamOk = $true
            $tz   = Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\TimeZoneInformation" -ErrorAction SilentlyContinue
            $bias = if ($tz -and $null -ne $tz.ActiveTimeBias) { [int64]$tz.ActiveTimeBias } else { 0L }
            $n = 0
            foreach ($bk in @(Get-ChildItem $bamBase -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -ne "S-1-5-18" })) {
                $regKey = Get-Item $bk.PSPath -ErrorAction SilentlyContinue
                if (-not $regKey) { continue }
                foreach ($prop in (try { $regKey.GetValueNames() } catch { @() })) {
                    if ($prop -in @("SequenceNumber","Version","")) { continue }
                    try {
                        $raw = $regKey.GetValue($prop)
                        if (-not $raw -or $raw -isnot [byte[]] -or $raw.Length -lt 8) { continue }
                        $ft = [System.BitConverter]::ToInt64($raw[0..7], 0)
                        if ($ft -le 0 -or $ft -gt 999999999999999999) { continue }
                        $lr = [DateTime]::FromFileTimeUtc($ft).AddMinutes(-$bias)
                        if ($script:ScanDaysBack -lt 9999 -and $lr -lt $script:ScanCutoff) { continue }
                        $lrStr = $lr.ToString("yyyy-MM-dd HH:mm:ss")
                        $entry = [PSCustomObject]@{ Path=$prop; LastRun=$lrStr; SID=$bk.PSChildName; Flagged=$false; Match=""; Tier="" }
                        $bamViewerData.Add($entry)
                        if (Is-BAMFalsePositive $prop) { Add-FP "BAM" $prop "BAM FP list"; continue }
                        $m = Test-CheatMatch $prop
                        if ($m) {
                            $sev = Get-SeverityForMatch $m "Critical"
                            $txt = "BAM: $prop (ran $lrStr) -- '$($m.Term)' [Tier $($m.Tier)/$($m.Match)]"
                            if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                            Add-Finding -Section "Execution Artifacts" -Type "BAM" -Detail $prop `
                                -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence "last run $lrStr"
                            Add-Timeline "BAM: $prop ran $lrStr"
                            $entry.Flagged = $true; $entry.Match = $m.Term; $entry.Tier = $m.Tier
                            $n++
                        }
                    } catch { continue }
                }
            }
            if ($n -eq 0) { Write-OK "BAM: nothing" }
        }
    } catch {}
    if (-not $bamOk) { Write-Skip "BAM unavailable" }

    # ---------- EXECUTION: Prefetch ----------
    Write-Info "Prefetch (proves execution)..."
    $pfPath = "C:\Windows\Prefetch"
    if (-not (Test-Path $pfPath)) {
        Write-Skip "Prefetch directory not present -- prefetching may be disabled"
        Mark-Skipped "Execution Artifacts" "Prefetch directory not present"
    } else {
        $pfFiles = @(Get-ChildItem $pfPath -Filter "*.pf" -File -Force -ErrorAction SilentlyContinue)
        Write-Info "Prefetch files: $($pfFiles.Count)"
        $pfResults = Scan-PrefetchParallel $pfFiles
        $parsedOk  = @($pfResults | Where-Object { $_.Parsed }).Count
        Mark-Ran "Execution Artifacts" "prefetch: $parsedOk/$($pfResults.Count) files fully parsed"
        if ($pfResults.Count -gt 0 -and $parsedOk -eq 0) {
            Write-Warn "No prefetch file parsed cleanly -- run counts unavailable, timestamps fall back to file mtime"
        }
        $n = 0
        foreach ($pf in $pfResults) {
            $prefetchViewerData.Add($pf)
            if (-not $pf.Match) { continue }
            $m = @{ Term = $pf.Match; Tier = $pf.Tier; Match = $pf.MatchType }
            $sev = Get-SeverityForMatch $m "Critical"
            $txt = "Prefetch: $($pf.Exe) (ran $($pf.LastRun), $($pf.RunCount)x) -- '$($pf.Match)' [Tier $($pf.Tier)]"
            if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
            Add-Finding -Section "Execution Artifacts" -Type "Prefetch" -Detail $pf.Exe `
                -Value $pf.Match -Severity $sev -Tier $pf.Tier -Evidence "last run $($pf.LastRun), run count $($pf.RunCount)"
            Add-Timeline "Prefetch: $($pf.Exe)"
            $n++
        }
        if ($n -eq 0) { Write-OK "Prefetch: nothing" }
    }

    Write-SectionResult "Execution Artifacts"
    Write-SectionResult "Presence Artifacts"
}

# ---- Prefetch scanned in chunked runspaces (v4.4 created one PowerShell
# ---- instance per .pf file -- 457 runspace allocations on your own machine).
function Scan-PrefetchParallel($pfFiles) {
    $results = [System.Collections.Generic.List[object]]::new()
    if ($pfFiles.Count -eq 0) { return $results }

    $cpu       = [Math]::Max(2, [Environment]::ProcessorCount)
    $chunkSize = [Math]::Max(16, [Math]::Ceiling($pfFiles.Count / $cpu))
    $pool = [RunspaceFactory]::CreateRunspacePool(1, $cpu)
    $pool.Open()
    $jobs = [System.Collections.Generic.List[hashtable]]::new()

    $worker = {
        param($paths, $cutoff, $daysBack, $terms, $fpPatterns)

        function Get-PfInfoLocal($path) {
            $res = @{ Times = @(); RunCount = 0; Parsed = $false }
            try {
                $raw   = [System.IO.File]::ReadAllBytes($path)
                $bytes = [PfDecomp]::Decompress($raw)
                if (-not $bytes -or $bytes.Length -lt 136) { return $res }
                $ver = [System.BitConverter]::ToUInt32($bytes, 0)
                if ($ver -notin @(17,23,26,30,31)) { return $res }
                $times = New-Object System.Collections.Generic.List[DateTime]
                $slots = if ($ver -ge 26) { 8 } else { 1 }
                $tsOff = if ($ver -eq 17) { 0x78 } else { 0x80 }
                for ($i = 0; $i -lt $slots; $i++) {
                    $o = $tsOff + ($i * 8)
                    if ($o + 8 -gt $bytes.Length) { break }
                    $ft = [System.BitConverter]::ToInt64($bytes, $o)
                    if ($ft -gt 0 -and $ft -lt 999999999999999999L) {
                        try { $times.Add([DateTime]::FromFileTimeUtc($ft).ToLocalTime()) } catch {}
                    }
                }
                $rcOff = if ($ver -eq 17) { 0x90 } elseif ($ver -eq 23) { 0x98 } else { 0xD0 }
                $rc = 0
                if ($rcOff + 4 -le $bytes.Length) {
                    $rc = [System.BitConverter]::ToInt32($bytes, $rcOff)
                    if ($rc -lt 0 -or $rc -gt 1000000) { $rc = 0 }
                }
                $res.Times = @($times | Sort-Object -Descending)
                $res.RunCount = $rc
                $res.Parsed = ($times.Count -gt 0)
            } catch {}
            return $res
        }

        $out = New-Object System.Collections.Generic.List[object]
        foreach ($p in $paths) {
            $fi   = Get-Item $p -ErrorAction SilentlyContinue
            if (-not $fi) { continue }
            $base = [System.IO.Path]::GetFileNameWithoutExtension($fi.Name)
            $exe  = if ($base -match '^(.+)-[0-9A-F]{8}$') { $Matches[1] } else { $base }
            $info = Get-PfInfoLocal $fi.FullName
            $last = if ($info.Times.Count -gt 0) { $info.Times[0] } else { $fi.LastWriteTime }
            if ($daysBack -lt 9999 -and $last -lt $cutoff) { continue }

            $lower = $exe.ToLower()
            $isFP = $false
            foreach ($f in $fpPatterns) { if ($lower -like "*$($f.ToLower())*") { $isFP = $true; break } }

            $matchTerm = $null; $matchTier = ""; $matchType = ""
            if (-not $isFP) {
                $stem = [System.IO.Path]::GetFileNameWithoutExtension($lower)
                foreach ($t in $terms) {
                    $term = $t.T
                    if ($lower -eq $term -or $stem -eq $term) { $matchTerm = $term; $matchTier = $t.Tier; $matchType = "Exact"; break }
                    if ($t.Tier -eq "B") { continue }
                    if ($term.Length -lt 6) { continue }
                    if ($lower -match "(^|[^a-z0-9])$([regex]::Escape($term))([^a-z0-9]|`$)") {
                        $matchTerm = $term; $matchTier = $t.Tier; $matchType = "Token"
                        if ($t.Tier -eq "A") { break }
                    }
                }
            }
            $out.Add([PSCustomObject]@{
                FileName    = $fi.Name
                Exe         = $exe
                SizeKB      = [math]::Round($fi.Length / 1KB, 2)
                LastRun     = $last.ToString("yyyy-MM-dd HH:mm:ss")
                AllRunTimes = if ($info.Times.Count -gt 1) { ($info.Times | ForEach-Object { $_.ToString("yyyy-MM-dd HH:mm:ss") }) -join " | " } else { $last.ToString("yyyy-MM-dd HH:mm:ss") }
                RunCount    = $info.RunCount
                Parsed      = $info.Parsed
                Match       = $matchTerm
                Tier        = $matchTier
                MatchType   = $matchType
            }) | Out-Null
        }
        return $out
    }

    for ($i = 0; $i -lt $pfFiles.Count; $i += $chunkSize) {
        $end   = [Math]::Min($i + $chunkSize - 1, $pfFiles.Count - 1)
        $chunk = @($pfFiles[$i..$end] | ForEach-Object { $_.FullName })
        $ps = [PowerShell]::Create()
        $ps.RunspacePool = $pool
        [void]$ps.AddScript($worker)
        [void]$ps.AddArgument($chunk)
        [void]$ps.AddArgument($script:ScanCutoff)
        [void]$ps.AddArgument($script:ScanDaysBack)
        [void]$ps.AddArgument($cheatTerms)
        [void]$ps.AddArgument($globalFPPatterns)
        $jobs.Add(@{ PS = $ps; Handle = $ps.BeginInvoke() })
    }
    foreach ($j in $jobs) {
        try { foreach ($r in $j.PS.EndInvoke($j.Handle)) { if ($r) { $results.Add($r) | Out-Null } } } catch {}
        $j.PS.Dispose()
    }
    $pool.Close(); $pool.Dispose()
    return $results
}

# =====================================================
# SECTION 4 -- PERSISTENCE
# =====================================================
function Run-Section4 {
    Write-Header "SECTION 4 -- PERSISTENCE"
    Mark-Ran "Persistence"

    Write-Info "Registry run keys..."
    $runKeys = @(
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run",
        "HKCU:\Software\Microsoft\Windows\CurrentVersion\RunOnce",
        "HKLM:\Software\Microsoft\Windows\CurrentVersion\Run",
        "HKLM:\Software\Microsoft\Windows\CurrentVersion\RunOnce",
        "HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run"
    )
    $n = 0
    foreach ($key in $runKeys) {
        if (-not (Test-Path $key)) { continue }
        $props = Get-ItemProperty $key -ErrorAction SilentlyContinue
        if (-not $props) { continue }
        $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
            $val = $_.Value
            if (-not $val) { return }
            $m = Test-CheatMatch ([string]$val)
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                $txt = "Run key [$($_.Name)] = $val -- '$($m.Term)'"
                if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
                Add-Finding -Section "Persistence" -Type "RunKey" -Detail "$($_.Name) = $val" `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                Add-Timeline "Run key: $val"
                $n++
            }
        }
    }
    if ($n -eq 0) { Write-OK "Run keys: nothing" }

    # ---- FIX (v4.5): desktop.ini exists in these folders on every Windows
    # ---- install and was generating a finding on every single scan.
    Write-Info "Startup folders..."
    $n = 0
    foreach ($sp in @("$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup",
                      "C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Startup")) {
        if (-not (Test-Path $sp)) { continue }
        foreach ($item in @(Get-ChildItem $sp -File -Force -ErrorAction SilentlyContinue)) {
            if ($startupIgnore -contains $item.Name.ToLower()) { continue }
            $m = Test-CheatMatch $item.FullName
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Hit "Startup: $($item.FullName) -- '$($m.Term)'"
                Add-Finding -Section "Persistence" -Type "StartupFolder" -Detail $item.FullName `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                $n++
            } else {
                Write-Ctx "Startup item: $($item.Name)"
                Add-Finding -Section "Persistence" -Type "StartupItem" -Detail $item.FullName -Severity "Context"
            }
        }
    }
    if ($n -eq 0) { Write-OK "Startup folders: no cheat matches" }

    # ---- FIX (v4.5): v4.4 filtered to State -ne Disabled, so a DISABLED task
    # ---- (trivially re-enabled) was invisible. Now included as context.
    Write-Info "Scheduled tasks (including disabled)..."
    $n = 0
    try {
        foreach ($task in @(Get-ScheduledTask -ErrorAction Stop)) {
            foreach ($a in @($task.Actions | ForEach-Object { "$($_.Execute) $($_.Arguments)" })) {
                if (-not $a -or $a.Trim() -eq "") { continue }
                $m = Test-CheatMatch $a
                if ($m) {
                    $disabled = ($task.State -eq "Disabled")
                    $sev = Get-SeverityForMatch $m "Critical"
                    if ($disabled -and $sev -eq "Critical") { $sev = "Review" }
                    $txt = "Task '$($task.TaskName)'$(if($disabled){' [DISABLED]'}) -> $a -- '$($m.Term)'"
                    if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
                    Add-Finding -Section "Persistence" -Type "ScheduledTask" -Detail "$($task.TaskName): $a" `
                        -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence "state=$($task.State)"
                    $n++
                }
            }
        }
    } catch { Write-Skip "Scheduled task enumeration failed" }
    if ($n -eq 0) { Write-OK "Scheduled tasks: nothing" }

    Write-Info "Hidden process check..."
    try {
        $cimProcs = @(Get-CimInstance Win32_Process -ErrorAction Stop | Select-Object -ExpandProperty ProcessId)
        $psProcs  = @(Get-Process -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Id)
        $hidden   = @($cimProcs | Where-Object { $psProcs -notcontains $_ })
        foreach ($h in $hidden) {
            $p = Get-CimInstance Win32_Process -Filter "ProcessId=$h" -ErrorAction SilentlyContinue
            if ($p) {
                Write-Amber "Process visible to CIM but not Get-Process: $($p.Name) (PID $h)"
                Add-Finding -Section "Persistence" -Type "HiddenProcess" -Detail $p.Name -Value "PID:$h" -Severity "Review"
            }
        }
        if ($hidden.Count -eq 0) { Write-OK "No hidden processes" }
    } catch { Write-Skip "Hidden process check unavailable" }

    Write-SectionResult "Persistence"
}

# =====================================================
# SECTION 5 -- REGISTRY EXECUTION ARTIFACTS (presence class)
# =====================================================
function Run-Section5 {
    Write-Header "SECTION 5 -- REGISTRY ARTIFACTS"
    Mark-Ran "Presence Artifacts"
    $n = 0

    Write-Info "AppCompatFlags..."
    foreach ($key in @(
        "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Compatibility Assistant\Store",
        "HKLM:\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Compatibility Assistant\Store")) {
        if (-not (Test-Path $key)) { continue }
        $props = Get-ItemProperty $key -ErrorAction SilentlyContinue
        if (-not $props) { continue }
        $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
            $m = Test-CheatMatch $_.Name
            if ($m) {
                $sev = Get-SeverityForMatch $m "Review"
                $txt = "AppCompatFlags: $($_.Name) -- '$($m.Term)'"
                if ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                Add-Finding -Section "Presence Artifacts" -Type "AppCompatFlags" -Detail $_.Name `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                $n++
            }
        }
    }

    Write-Info "Explorer TypedPaths..."
    $tpKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\TypedPaths"
    if (Test-Path $tpKey) {
        $props = Get-ItemProperty $tpKey -ErrorAction SilentlyContinue
        if ($props) {
            $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                if (-not $_.Value) { return }
                $m = Test-CheatMatch ([string]$_.Value)
                if ($m) {
                    $sev = Get-SeverityForMatch $m "Review"
                    Write-Amber "TypedPaths: $($_.Value) -- '$($m.Term)'"
                    Add-Finding -Section "Presence Artifacts" -Type "TypedPaths" -Detail ([string]$_.Value) `
                        -Value $m.Term -Severity $sev -Tier $m.Tier
                    $n++
                }
            }
        }
    }

    Write-Info "RecentDocs..."
    $rdKey = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\RecentDocs"
    if (Test-Path $rdKey) {
        Get-ChildItem $rdKey -ErrorAction SilentlyContinue | ForEach-Object {
            $props = Get-ItemProperty $_.PSPath -ErrorAction SilentlyContinue
            if (-not $props) { return }
            $props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" } | ForEach-Object {
                if ($_.Value -isnot [byte[]]) { return }
                $str = ([System.Text.Encoding]::Unicode.GetString($_.Value)) -replace "[^\x20-\x7E]",""
                if (-not $str) { return }
                $m = Test-CheatMatch $str
                if ($m) {
                    $sev = Get-SeverityForMatch $m "Review"
                    Write-Amber "RecentDocs: $str -- '$($m.Term)'"
                    Add-Finding -Section "Presence Artifacts" -Type "RecentDocs" -Detail $str `
                        -Value $m.Term -Severity $sev -Tier $m.Tier
                    $n++
                }
            }
        }
    }

    if ($n -eq 0) { Write-OK "Registry artifacts: nothing" }
    Write-SectionResult "Presence Artifacts"
}

# =====================================================
# SECTION 6 -- POWERSHELL HISTORY & ENTROPY
# =====================================================
function Run-Section6 {
    Write-Header "SECTION 6 -- POWERSHELL HISTORY & ENTROPY"

    Write-Info "PowerShell history..."
    $historyPaths = [System.Collections.Generic.List[string]]::new()
    foreach ($prof in $allUserProfiles) {
        $hp = "$prof\AppData\Roaming\Microsoft\Windows\PowerShell\PSReadLine\ConsoleHost_history.txt"
        if (Test-Path $hp) { $historyPaths.Add($hp) | Out-Null }
    }
    if ($historyPaths.Count -eq 0) {
        Mark-Skipped "PowerShell History" "no ConsoleHost_history.txt found for any profile"
        Write-Skip "No PowerShell history files found"
    } else {
        Mark-Ran "PowerShell History" "$($historyPaths.Count) history file(s)"
        $n = 0
        foreach ($hPath in $historyPaths) {
            try {
                foreach ($line in (Get-Content $hPath -ErrorAction Stop | Where-Object { $_.Trim() })) {
                    $lower = $line.ToLower()
                    $isFP = $false
                    foreach ($fp in $psFPPatterns) { if ($lower -like "*$fp*") { $isFP = $true; break } }
                    if ($isFP) { Add-FP "PSHistory" $line "scanner's own commands"; continue }

                    $matched = $false
                    foreach ($p in $remoteExecPatterns) {
                        if ($lower -like "*$($p.Pattern)*") {
                            Write-Amber "PS history [$($p.Label)]: $line"
                            Add-Finding -Section "PowerShell History" -Type "PSHistory" -Detail $line `
                                -Value $p.Label -Severity "Review" -Evidence $hPath
                            $n++; $matched = $true; break
                        }
                    }
                    if ($matched) { continue }
                    foreach ($p in $remoteExecContext) {
                        if ($lower -like "*$($p.Pattern)*") {
                            Write-Ctx "PS history [$($p.Label)]: $line"
                            Add-Finding -Section "PowerShell History" -Type "PSHistoryContext" -Detail $line `
                                -Value $p.Label -Severity "Context"
                            $matched = $true; break
                        }
                    }
                    if ($matched) { continue }
                    $m = Test-CheatMatch $line
                    if ($m) {
                        $sev = Get-SeverityForMatch $m "Critical"
                        $txt = "PS history cheat term: $line -- '$($m.Term)'"
                        if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
                        Add-Finding -Section "PowerShell History" -Type "PSHistoryCheat" -Detail $line `
                            -Value $m.Term -Severity $sev -Tier $m.Tier
                        $n++
                    }
                }
            } catch { continue }
        }
        if ($n -eq 0) { Write-OK "PowerShell history: nothing" }
    }

    Write-Info "Entropy scan..."
    Mark-Ran "Entropy"
    $n = 0
    foreach ($sp in @("$env:TEMP","$env:LOCALAPPDATA\Temp","$env:APPDATA","$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop")) {
        if (-not (Test-Path $sp)) { continue }
        foreach ($exe in @(Get-ChildItem $sp -Filter "*.exe" -File -Force -ErrorAction SilentlyContinue |
                           Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })) {
            if (Is-GlobalFP $exe.FullName) { Add-FP "Entropy" $exe.FullName "global FP list"; continue }
            # A valid signature is a far stronger signal than entropy. Packed
            # installers routinely exceed 7.6 and are not evidence of anything.
            $sig = Get-SigInfo $exe.FullName
            if ($sig.Status -eq "Valid") { Add-FP "Entropy" $exe.FullName "validly signed: $($sig.Subject)"; continue }
            $ent = Get-FileEntropy $exe.FullName
            if ($ent -ge $entropyHigh) {
                Write-Amber "High entropy unsigned exe ($ent): $($exe.FullName)"
                Add-Finding -Section "Entropy" -Type "HighEntropy" -Detail $exe.FullName -Value "entropy:$ent" -Severity "Review"
                $entropyResults.Add([PSCustomObject]@{ Path=$exe.FullName; Entropy=$ent; Flag="HIGH"; Sig=$sig.Status })
                $n++
            } elseif ($ent -ge $entropyWarn) {
                $entropyResults.Add([PSCustomObject]@{ Path=$exe.FullName; Entropy=$ent; Flag="WARN"; Sig=$sig.Status })
            }
        }
    }
    if ($n -eq 0) { Write-OK "Entropy: nothing above threshold among unsigned binaries" }

    # ---- RESTORED from v4.4: blandly-named executables in Temp. "update.exe"
    # ---- and "loader.exe" in a temp folder are what a dropper names itself.
    # ---- v4.4 scored these outright; here they need elevated entropy AND no
    # ---- valid signature, and they cap at Review.
    Write-Info "Generic-named executables in temp locations..."
    $genericNames = @("update","updater","service","helper","loader","launcher",
                      "runner","install","installer","setup","patch","main","client","host")
    $g = 0
    foreach ($loc in @("$env:TEMP","$env:LOCALAPPDATA\Temp","$env:APPDATA")) {
        if (-not (Test-Path $loc)) { continue }
        foreach ($exe in @(Get-ChildItem $loc -Filter "*.exe" -File -Force -ErrorAction SilentlyContinue |
                           Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })) {
            $baseName = [System.IO.Path]::GetFileNameWithoutExtension($exe.Name).ToLower()
            if ($genericNames -notcontains $baseName) { continue }
            if (Is-GlobalFP $exe.FullName) { Add-FP "GenericExe" $exe.FullName "global FP list"; continue }
            $sig = Get-SigInfo $exe.FullName
            if ($sig.Status -eq "Valid") { Add-FP "GenericExe" $exe.FullName "validly signed: $($sig.Subject)"; continue }
            $ent = Get-FileEntropy $exe.FullName
            if ($ent -lt $entropyWarn) { continue }
            Write-Amber "Generic-named unsigned exe in temp (entropy $ent): $($exe.FullName)"
            Add-Finding -Section "Entropy" -Type "GenericExe" -Detail $exe.FullName `
                -Value "entropy:$ent" -Severity "Review" `
                -Evidence "blandly-named, unsigned, elevated entropy, in a temp path -- also matches many legitimate installers"
            $entropyResults.Add([PSCustomObject]@{ Path=$exe.FullName; Entropy=$ent; Flag="GENERIC"; Sig=$sig.Status })
            $g++
        }
    }
    if ($g -eq 0) { Write-OK "No generic-named unsigned executables in temp" }

    Write-SectionResult "PowerShell History"
    Write-SectionResult "Entropy"
}

# =====================================================
# SECTION 7 -- RECENT ACTIVITY / EVENT LOGS
# =====================================================
function Run-Section7 {
    Write-Header "SECTION 7 -- EVENT LOG EVIDENCE"

    # ---- FIX (v4.5): 4688 auditing is OFF by default on consumer Windows.
    # ---- v4.4 printed "[OK] No suspicious process creation events" whether the
    # ---- log was empty or the policy was simply never enabled.
    $auditOn = $false
    try {
        $probe = Get-WinEvent -FilterHashtable @{ LogName="Security"; Id=4688 } -MaxEvents 1 -ErrorAction Stop
        $auditOn = ($null -ne $probe)
    } catch { $auditOn = $false }

    if (-not $auditOn) {
        Write-Skip "Event 4688 (process creation) auditing is NOT enabled on this machine."
        Write-Skip "No process-creation evidence exists to examine. This is NOT a clean result."
        Mark-Skipped "Event Log Evidence" "4688 process-creation auditing disabled -- no data to examine"
    } else {
        Mark-Ran "Event Log Evidence" "4688 auditing enabled"
        Write-Info "Event 4688 (process creation)..."
        $n = 0
        # 4688 property order: 0 SubjectUserSid, 1 SubjectUserName, 2 SubjectDomain,
        # 3 SubjectLogonId, 4 NewProcessId, 5 NewProcessName, 6 TokenElevationType,
        # 7 ProcessId, 8 CommandLine.
        # v4.4 read [6] as the path -- it is the elevation type token (%%1936 etc).
        try {
            foreach ($ev in (Get-WinEvent -FilterHashtable @{ LogName="Security"; Id=4688; StartTime=$script:ScanCutoff } -MaxEvents 2000 -ErrorAction Stop)) {
                try {
                    $procPath = [string]$ev.Properties[5].Value
                    $cmdLine  = if ($ev.Properties.Count -gt 8) { [string]$ev.Properties[8].Value } else { "" }
                    $elev     = if ($ev.Properties.Count -gt 6) { [string]$ev.Properties[6].Value } else { "" }
                    $logonId  = if ($ev.Properties.Count -gt 3) { [string]$ev.Properties[3].Value } else { "" }
                    $check    = "$procPath $cmdLine"
                    $m = Test-CheatMatch $check
                    if (-not $m) { continue }
                    $sev = Get-SeverityForMatch $m "Critical"
                    $t   = $ev.TimeCreated.ToString("yyyy-MM-dd HH:mm:ss")
                    # elevation type %%1937 == full token (ran elevated)
                    $elevNote = if ($elev -like "*1937*") { " [ELEVATED]" } else { "" }
                    $txt = "4688: $procPath at $t$elevNote -- '$($m.Term)'"
                    if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
                    Add-Finding -Section "Event Log Evidence" -Type "ProcessCreation4688" `
                        -Detail "$procPath ($t)$elevNote" -Value $m.Term -Severity $sev -Tier $m.Tier `
                        -Evidence "cmdline: $cmdLine | logonId: $logonId"
                    Add-Timeline "4688: $procPath ($($m.Term)) at $t"
                    $n++
                } catch { continue }
            }
        } catch {}
        if ($n -eq 0) { Write-OK "Event 4688: nothing" }

        # ---- NEW (v4.5): 4672 was in the design notes and completely absent
        # ---- from v4.4's code. Correlate special-privilege assignment with the
        # ---- logon session of any flagged 4688, so "it ran elevated" is evidenced.
        Write-Info "Event 4672 (special privileges assigned)..."
        try {
            $elevSessions = @{}
            foreach ($ev in (Get-WinEvent -FilterHashtable @{ LogName="Security"; Id=4672; StartTime=$script:ScanCutoff } -MaxEvents 1000 -ErrorAction Stop)) {
                try {
                    $lid = [string]$ev.Properties[3].Value
                    $usr = [string]$ev.Properties[1].Value
                    if ($lid) { $elevSessions[$lid] = "$usr @ $($ev.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss'))" }
                } catch { continue }
            }
            $corr = 0
            foreach ($f in @($findings | Where-Object { $_.Type -eq "ProcessCreation4688" })) {
                if ($f.Evidence -match 'logonId: (\S+)') {
                    $lid = $Matches[1]
                    if ($elevSessions.ContainsKey($lid)) {
                        Write-Critical "4672 correlation: '$($f.Detail)' ran in an ADMIN-privileged session ($($elevSessions[$lid]))"
                        Add-Finding -Section "Event Log Evidence" -Type "AdminPrivilegeCorrelation" `
                            -Detail $f.Detail -Value $elevSessions[$lid] -Severity "Review" `
                            -Evidence "4672 special privileges assigned to logon session $lid"
                        $corr++
                    }
                }
            }
            Write-Info "4672 sessions seen: $($elevSessions.Count) | correlated with flagged processes: $corr"
        } catch { Write-Skip "Event 4672 unavailable" }
    }

    # ---- FIX (v4.5): v4.4 double-deducted here (Add-Finding 50 AND
    # ---- DeductCheat 40 = 90 from one event). Single finding now.
    Write-Info "Security log clear events (1102)..."
    try {
        $clears = @(Get-WinEvent -FilterHashtable @{ LogName="Security"; Id=1102 } -MaxEvents 20 -ErrorAction Stop |
                    Where-Object { $script:ScanDaysBack -ge 9999 -or $_.TimeCreated -ge $script:ScanCutoff })
        foreach ($ev in $clears) {
            $by  = try { [string]$ev.Properties[1].Value } catch { "Unknown" }
            $msg = "Security log CLEARED at $($ev.TimeCreated.ToString('yyyy-MM-dd HH:mm:ss')) by $by"
            Write-Critical $msg
            Add-Finding -Section "Event Log Evidence" -Type "LogClear" -Detail $msg -Value "Event 1102" -Severity "Review" `
                -Evidence "log clearing is also routine during troubleshooting -- verify context before treating as evasion"
            Add-Timeline $msg
            Mark-Ran "Event Log Evidence"
        }
        if ($clears.Count -eq 0) { Write-OK "No Security log clears in range" }
    } catch {
        if ($_.Exception.Message -match 'No events were found') {
            Write-OK "No Security log clears in range"
        } else {
            Write-Skip "Event 1102 could not be read: $($_.Exception.Message)"
        }
    }

    Write-SectionResult "Event Log Evidence"
}

# =====================================================
# ROBLOX CLIENT INTEGRITY
# v4.4 hardcoded three official paths, so on a Fishstrap/Bloxstrap machine it
# printed "[OK] No Roblox installation found" and skipped this section entirely
# while reporting it as a clean pass. That is now NOT CHECKED, and roots are
# resolved from the running process.
# =====================================================
function Run-RobloxClientIntegrity {
    Write-Header "ROBLOX CLIENT INTEGRITY"

    $roots = Get-RobloxInstallRoots
    if ($roots.Count -eq 0) {
        Write-Warn "Roblox install not located -- CLIENT INTEGRITY WAS NOT CHECKED"
        Mark-Skipped "Roblox Client Integrity" "no Roblox install directory found (client not running and no known launcher root)"
        Write-SectionResult "Roblox Client Integrity"
        return
    }

    Mark-Ran "Roblox Client Integrity" "$($roots.Count) install root(s)"
    foreach ($root in $roots) { Write-Info "Root: $root" }

    foreach ($install in $roots) {
        $files = @(Get-ChildItem $install -File -Recurse -Force -ErrorAction SilentlyContinue)
        foreach ($file in $files) {
            $fname = $file.Name.ToLower()
            if ($robloxFolderFPFiles -contains $fname) { Add-FP "RobloxFolder" $file.FullName "known Roblox-shipped dependency"; continue }

            $m = Test-CheatMatch $file.Name
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Hit "Cheat-named file in client folder: $($file.FullName) -- '$($m.Term)'"
                Add-Finding -Section "Roblox Client Integrity" -Type "CheatFile" -Detail $file.FullName `
                    -Value $m.Term -Severity $sev -Tier $m.Tier
                $robloxFolderResults.Add([PSCustomObject]@{ Path=$file.FullName; Issue="CheatMatch"; Match=$m.Term; Signer="" })
                Add-Timeline "Cheat file in client folder: $($file.FullName)"
                continue
            }

            # The real signal: a binary in the client folder that Roblox did not sign.
            if ($fname -match '\.(dll|exe|sys|node)$') {
                $sig = Get-SigInfo $file.FullName
                $isRoblox = ($sig.Status -eq "Valid" -and ($knownRobloxSigners | Where-Object { $sig.Subject -like "*$_*" }))
                if (-not $isRoblox) {
                    $sev = if ($sig.Status -eq "Valid") { "Review" } else { "Critical" }
                    $note = if ($sig.Status -eq "Valid") { "signed by a third party: $($sig.Subject)" } else { "unsigned / invalid: $($sig.Status)" }
                    $txt = "Non-Roblox binary in client folder: $($file.FullName) [$note]"
                    if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
                    Add-Finding -Section "Roblox Client Integrity" -Type "NonRobloxBinary" -Detail $file.FullName `
                        -Value $sig.Status -Severity $sev -Evidence $note
                    $robloxFolderResults.Add([PSCustomObject]@{ Path=$file.FullName; Issue="NonRobloxBinary"; Match=""; Signer=$sig.Subject })
                }
            }
        }
    }

    # ---- NEW (v4.5): launcher Modifications folders. Bloxstrap/Fishstrap copy
    # ---- user-supplied files into the client directory -- a supported path for
    # ---- placing arbitrary files next to RobloxPlayerBeta.exe.
    Write-Info "Launcher Modifications folders..."
    $modFolders = Get-LauncherModFolders
    if ($modFolders.Count -eq 0) { Write-OK "No launcher Modifications folder present" }
    foreach ($mf in $modFolders) {
        foreach ($f in @(Get-ChildItem $mf -File -Recurse -Force -ErrorAction SilentlyContinue)) {
            $isBinary = $f.Name -match '\.(dll|exe|sys|node|scr)$'
            $m = Test-CheatMatch $f.Name
            if ($m) {
                Write-Hit "Cheat-named file in Modifications: $($f.FullName) -- '$($m.Term)'"
                Add-Finding -Section "Roblox Client Integrity" -Type "ModFolderCheatFile" -Detail $f.FullName `
                    -Value $m.Term -Severity (Get-SeverityForMatch $m "Critical") -Tier $m.Tier
            } elseif ($isBinary) {
                Write-Hit "EXECUTABLE in launcher Modifications folder: $($f.FullName)"
                Add-Finding -Section "Roblox Client Integrity" -Type "ModFolderBinary" -Detail $f.FullName `
                    -Severity "Critical" -Evidence "Modifications folders are for assets; a binary here is copied into the client directory at launch"
            } else {
                Add-Finding -Section "Roblox Client Integrity" -Type "ModFolderAsset" -Detail $f.FullName -Severity "Context"
            }
        }
    }

    Write-SectionResult "Roblox Client Integrity"
}

# =====================================================
# LOADED MODULE SIGNER CHECK  (NEW in v4.5)
# The single highest-precision detection that v4.4 did not have. Given that
# Hyperion verifies the integrity of the Roblox process and blocks injection,
# a non-Roblox, non-Microsoft DLL resident inside RobloxPlayerBeta is close to
# dispositive -- and it is far cheaper than scanning gigabytes of heap.
# =====================================================
function Run-ModuleScan {
    Write-Header "LOADED MODULE SCAN"
    $procs = @(Get-RobloxProcs)
    if ($procs.Count -eq 0) {
        Write-Skip "Roblox not running -- module scan NOT PERFORMED"
        Mark-Skipped "Loaded Modules" "Roblox was not running"
        Write-SectionResult "Loaded Modules"
        return
    }

    $checked = 0; $flagged = 0
    foreach ($p in $procs) {
        $mods = $null
        try { $mods = @($p.Modules) } catch {
            Write-Warn "Could not enumerate modules for $($p.ProcessName) PID $($p.Id): $($_.Exception.Message)"
            continue
        }
        Write-Info "$($p.ProcessName) PID $($p.Id): $($mods.Count) module(s)"
        foreach ($mod in $mods) {
            $mp = $null
            try { $mp = $mod.FileName } catch { continue }
            if (-not $mp) { continue }
            $checked++
            $sig = Get-SigInfo $mp
            $lower = $mp.ToLower()

            $trusted = $false
            if ($sig.Status -eq "Valid") {
                foreach ($s in @("Roblox Corporation","Microsoft Windows","Microsoft Corporation")) {
                    if ($sig.Subject -like "*$s*") { $trusted = $true; break }
                }
            }
            # OS modules load from System32/WinSxS and are catalog-signed rather
            # than embedded-signed, which reports as NotSigned. Treat as trusted.
            if (-not $trusted -and ($lower -like "$($env:SystemRoot.ToLower())\system32\*" -or
                                    $lower -like "$($env:SystemRoot.ToLower())\syswow64\*" -or
                                    $lower -like "$($env:SystemRoot.ToLower())\winsxs\*")) { $trusted = $true }
            if ($trusted) { continue }

            $m = Test-CheatMatch $mp
            $sev = if ($m -and $m.Tier -eq "A") { "Critical" }
                   elseif ($sig.Status -ne "Valid") { "Critical" }
                   else { "Review" }
            $note = "signer=$($sig.Subject); status=$($sig.Status)"
            $txt  = "Untrusted module in $($p.ProcessName): $mp [$note]"
            if ($sev -eq "Critical") { Write-Critical $txt } else { Write-Amber $txt }
            Add-Finding -Section "Loaded Modules" -Type "UntrustedModule" -Detail $mp `
                -Value $(if ($m) { $m.Term } else { $sig.Status }) -Severity $sev `
                -Tier $(if ($m) { $m.Tier } else { "" }) -Evidence "$note; host PID $($p.Id)"
            $moduleFindings.Add([PSCustomObject]@{
                Process=$p.ProcessName; PID=$p.Id; Module=$mp; Signer=$sig.Subject; Status=$sig.Status; Severity=$sev
            })
            Add-Timeline "Untrusted module in $($p.ProcessName): $mp"
            $flagged++
        }
    }
    if ($checked -eq 0) {
        Mark-Skipped "Loaded Modules" "module list unavailable (access denied on every Roblox process)"
        Write-Warn "No modules could be enumerated -- this is NOT a clean result"
    } else {
        Mark-Ran "Loaded Modules" "$checked module(s) checked, $flagged untrusted"
        if ($flagged -eq 0) { Write-OK "All loaded modules are Roblox/Microsoft-signed or OS-resident" }
    }
    Write-SectionResult "Loaded Modules"
}

# =====================================================
# PROCESS MEMORY / THREADS / HOLLOW
# =====================================================
function Get-SuspiciousThreads($targetPid) {
    $results = [System.Collections.Generic.List[object]]::new()
    $snap = [Win32Thread]::CreateToolhelp32Snapshot([Win32Thread]::TH32CS_SNAPTHREAD, 0)
    if ($snap -eq [IntPtr]::Zero -or $snap.ToInt64() -eq -1) { return $results }
    try {
        $entry = New-Object Win32Thread+THREADENTRY32
        $entry.dwSize = [uint32][System.Runtime.InteropServices.Marshal]::SizeOf($entry)
        $hProc = [Win32Mem]::OpenProcess([Win32Mem]::PROCESS_VM_READ -bor [Win32Mem]::PROCESS_QUERY_INFORMATION, $false, $targetPid)
        if ($hProc -eq [IntPtr]::Zero) { return $results }
        try {
            $ok = [Win32Thread]::Thread32First($snap, [ref]$entry)
            while ($ok) {
                if ([int]$entry.th32OwnerProcessID -eq $targetPid) {
                    $hThread = [Win32Thread]::OpenThread([Win32Thread]::THREAD_QUERY_INFORMATION, $false, $entry.th32ThreadID)
                    if ($hThread -ne [IntPtr]::Zero -and $hThread.ToInt64() -ne -1) {
                        try {
                            $startAddr = [IntPtr]::Zero; $retLen = 0
                            $status = [Win32Thread]::NtQueryInformationThread($hThread, 9, [ref]$startAddr, [IntPtr]::Size, [ref]$retLen)
                            if ($status -eq 0 -and $startAddr -ne [IntPtr]::Zero) {
                                $mbi = New-Object Win32Mem+MEMORY_BASIC_INFORMATION
                                $sz  = [uint32][System.Runtime.InteropServices.Marshal]::SizeOf($mbi)
                                if ([Win32Mem]::VirtualQueryEx($hProc, $startAddr, [ref]$mbi, $sz) -gt 0) {
                                    if (($mbi.Type -eq [Win32Mem]::MEM_PRIVATE) -and
                                        (($mbi.Protect -band 0xF0) -ne 0) -and
                                        (($mbi.Protect -band [Win32Mem]::PAGE_GUARD) -eq 0)) {
                                        $results.Add([PSCustomObject]@{
                                            ThreadID = $entry.th32ThreadID
                                            StartAddr = "0x$($startAddr.ToInt64().ToString('X16'))"
                                            Protection = Get-ProtectionName $mbi.Protect
                                            RegionKB = [math]::Round($mbi.RegionSize.ToInt64()/1KB,1)
                                        }) | Out-Null
                                    }
                                }
                            }
                        } finally { [void][Win32Thread]::CloseHandle($hThread) }
                    }
                }
                $ok = [Win32Thread]::Thread32Next($snap, [ref]$entry)
            }
        } finally { [void][Win32Mem]::CloseHandle($hProc) }
    } finally { [void][Win32Mem]::CloseHandle($snap) }
    return $results
}

function Test-ProcessHollowing($procPid) {
    $hProc = [Win32Mem]::OpenProcess([Win32Mem]::PROCESS_VM_READ -bor [Win32Mem]::PROCESS_QUERY_INFORMATION, $false, $procPid)
    if ($hProc -eq [IntPtr]::Zero) { return @{ Result = $null; Reason = "access denied" } }
    try {
        # A 64-bit host reading a WOW64 target has a different PEB layout; the
        # 0x10 ImageBaseAddress offset is only valid for a 64-bit PEB.
        $isWow = $false
        try { [void][Win32Mem]::IsWow64Process($hProc, [ref]$isWow) } catch {}
        if ($isWow) { return @{ Result = $null; Reason = "target is WOW64; 64-bit PEB offsets do not apply" } }

        $pbi = New-Object Win32Hollow+PROCESS_BASIC_INFORMATION
        $retLen = 0
        $status = [Win32Hollow]::NtQueryInformationProcess($hProc, 0, [ref]$pbi, [System.Runtime.InteropServices.Marshal]::SizeOf($pbi), [ref]$retLen)
        if ($status -ne 0 -or $pbi.PebBaseAddress -eq [IntPtr]::Zero) { return @{ Result = $null; Reason = "PEB unavailable" } }
        $off = [IntPtr]($pbi.PebBaseAddress.ToInt64() + 0x10)
        $buf = New-Object byte[] 8; $br = 0
        if (-not [Win32Mem]::ReadProcessMemory($hProc, $off, $buf, 8, [ref]$br) -or $br -lt 8) {
            return @{ Result = $null; Reason = "could not read PEB" }
        }
        $imageBase = [IntPtr][System.BitConverter]::ToInt64($buf, 0)
        if ($imageBase -eq [IntPtr]::Zero) { return @{ Result = $null; Reason = "null image base" } }
        $mbi = New-Object Win32Mem+MEMORY_BASIC_INFORMATION
        $sz  = [uint32][System.Runtime.InteropServices.Marshal]::SizeOf($mbi)
        if ([Win32Mem]::VirtualQueryEx($hProc, $imageBase, [ref]$mbi, $sz) -eq 0) { return @{ Result = $null; Reason = "VirtualQueryEx failed" } }
        return @{ Result = ($mbi.Type -eq [Win32Mem]::MEM_PRIVATE); Reason = "" }
    } finally { [void][Win32Mem]::CloseHandle($hProc) }
}

function Scan-RobloxProcessMemory($procPid, $pname, $ppath) {
    $res = [PSCustomObject]@{
        PID=$procPid; Name=$pname; Path=$ppath
        HighHits=[System.Collections.Generic.List[object]]::new()
        ProductHits=[System.Collections.Generic.List[object]]::new()
        ChatHits=[System.Collections.Generic.List[object]]::new()
        UnbackedExec=[System.Collections.Generic.List[object]]::new()
        Regions=0; ScannedBytes=0; TotalPrivateBytes=0; Truncated=$false; Error=$null
    }
    $hProc = [Win32Mem]::OpenProcess([Win32Mem]::PROCESS_VM_READ -bor [Win32Mem]::PROCESS_QUERY_INFORMATION, $false, $procPid)
    if ($hProc -eq [IntPtr]::Zero) { $res.Error = "Access denied (OpenProcess failed)"; return $res }
    try {
        $si = New-Object Win32Mem+SYSTEM_INFO
        [Win32Mem]::GetSystemInfo([ref]$si)
        $addr = $si.lpMinimumApplicationAddress
        $max  = $si.lpMaximumApplicationAddress
        $total = 0
        while ($addr.ToInt64() -lt $max.ToInt64()) {
            $mbi = New-Object Win32Mem+MEMORY_BASIC_INFORMATION
            $sz  = [uint32][System.Runtime.InteropServices.Marshal]::SizeOf($mbi)
            if ([Win32Mem]::VirtualQueryEx($hProc, $addr, [ref]$mbi, $sz) -eq 0) {
                $addr = [IntPtr]($addr.ToInt64() + 0x1000); continue
            }
            $res.Regions++
            $size = $mbi.RegionSize.ToInt64()
            if ($mbi.State -eq [Win32Mem]::MEM_COMMIT -and $mbi.Type -eq [Win32Mem]::MEM_PRIVATE) {
                $res.TotalPrivateBytes += $size
                $protect  = $mbi.Protect
                $guarded  = ($protect -band [Win32Mem]::PAGE_GUARD) -ne 0
                $noaccess = ($protect -band [Win32Mem]::PAGE_NOACCESS) -ne 0
                if ((($protect -band 0xF0) -ne 0) -and -not $guarded -and -not $noaccess) {
                    $res.UnbackedExec.Add([PSCustomObject]@{
                        Address="0x$($mbi.BaseAddress.ToInt64().ToString('X16'))"
                        SizeKB=[math]::Round($size/1KB,1); Protection=(Get-ProtectionName $protect)
                    }) | Out-Null
                }
                if ((($protect -band 0xFE) -ne 0) -and -not $guarded -and -not $noaccess -and $size -gt 0 -and $total -lt $maxBytesPerProcess) {
                    $rs = [int][math]::Min($size, $maxReadSize)
                    $buf = New-Object byte[] $rs; $br = 0
                    if ([Win32Mem]::ReadProcessMemory($hProc, $mbi.BaseAddress, $buf, $rs, [ref]$br) -and $br -gt 0) {
                        $res.ScannedBytes += $br; $total += $br
                        $av = $mbi.BaseAddress.ToInt64()
                        foreach ($h in (Search-MemoryRegion $buf $br)) {
                            $obj = [PSCustomObject]@{
                                String=$h.S; Address="0x$($av.ToString('X16'))"
                                Region="PRIVATE/$(Get-ProtectionName $protect)"; SizeKB=[math]::Round($br/1KB,1)
                            }
                            switch ($h.Class) {
                                "High"    { $res.HighHits.Add($obj)    | Out-Null }
                                "Product" { $res.ProductHits.Add($obj) | Out-Null }
                                default   { $res.ChatHits.Add($obj)    | Out-Null }
                            }
                        }
                    }
                }
            }
            $next = $mbi.BaseAddress.ToInt64() + $size
            if ($next -le $addr.ToInt64()) { $next = $addr.ToInt64() + 0x1000 }
            $addr = [IntPtr]$next
        }
        if ($total -ge $maxBytesPerProcess) { $res.Truncated = $true }
    } finally { [void][Win32Mem]::CloseHandle($hProc) }
    return $res
}

function Get-SuspiciousNamedPipes {
    $out = [PSCustomObject]@{ Pipes = [System.Collections.Generic.List[object]]::new(); Enumerated = $false; Error = "" }
    $names = $null
    try {
        $names = @([System.IO.Directory]::GetFiles("\\.\pipe\") | ForEach-Object { [System.IO.Path]::GetFileName($_).ToLower() })
        $out.Enumerated = $true
    } catch {
        # v4.4 swallowed this and returned an empty list, which was then printed
        # as "Named pipes: Clean" -- indistinguishable from a real clean result.
        $out.Error = $_.Exception.Message
        return $out
    }
    foreach ($pipe in $names) {
        $matched = $null; $tier = "A"
        foreach ($cp in $cheatPipeNames) { if ($pipe -like "*$($cp.ToLower())*") { $matched = $cp; break } }
        if (-not $matched) {
            foreach ($gp in $genericSuspPipeNames) { if ($pipe -like "*$($gp.ToLower())*") { $matched = "generic:$gp"; $tier = "B"; break } }
        }
        if ($matched) { $out.Pipes.Add([PSCustomObject]@{ PipeName=$pipe; Match=$matched; Tier=$tier }) | Out-Null }
    }
    return $out
}

# =====================================================
# HANDLE SCAN
# v4.4 parsed the handle table starting at offset +4. On x64 the array is
# 8-byte aligned because the entry contains a PVOID, so every entry it read was
# garbage; ProcessId was declared uint over a USHORT field; DuplicateHandle was
# declared to return IntPtr over a BOOL; and the Process object type index was
# hardcoded to 7, which is version-dependent. All four are fixed below, and the
# type filter is replaced by "did GetProcessId succeed".
# =====================================================
function Get-ProcessesWithRobloxHandle {
    $out = [PSCustomObject]@{ Hits=[System.Collections.Generic.List[object]]::new(); Enumerated=$false; Error=""; HandlesSeen=0 }
    $robloxPids = @(Get-RobloxProcs | Select-Object -ExpandProperty Id)
    if ($robloxPids.Count -eq 0) { $out.Error = "Roblox not running"; return $out }
    if (-not ([Management.Automation.PSTypeName]'Win32Handle').Type) { $out.Error = "Win32Handle type unavailable"; return $out }

    $bufSize = 4MB
    $buf = [System.Runtime.InteropServices.Marshal]::AllocHGlobal($bufSize)
    try {
        $retLen = 0
        $status = [Win32Handle]::NtQuerySystemInformation([Win32Handle]::SystemExtendedHandleInformation, $buf, $bufSize, [ref]$retLen)
        $tries = 0
        while ($status -eq -1073741820 -and $tries -lt 6) {   # STATUS_INFO_LENGTH_MISMATCH
            [System.Runtime.InteropServices.Marshal]::FreeHGlobal($buf)
            $bufSize = [Math]::Max($retLen + 0x100000, $bufSize * 2)
            $buf = [System.Runtime.InteropServices.Marshal]::AllocHGlobal($bufSize)
            $status = [Win32Handle]::NtQuerySystemInformation([Win32Handle]::SystemExtendedHandleInformation, $buf, $bufSize, [ref]$retLen)
            $tries++
        }
        if ($status -ne 0) { $out.Error = "NtQuerySystemInformation returned 0x$($status.ToString('X8'))"; return $out }

        # SYSTEM_HANDLE_INFORMATION_EX { ULONG_PTR NumberOfHandles; ULONG_PTR Reserved;
        #                                SYSTEM_HANDLE_TABLE_ENTRY_INFO_EX Handles[1]; }
        $handleCount = [System.Runtime.InteropServices.Marshal]::ReadIntPtr($buf, 0).ToInt64()
        $entrySize   = [System.Runtime.InteropServices.Marshal]::SizeOf([type][Win32Handle+SYSTEM_HANDLE_TABLE_ENTRY_INFO_EX])
        $ptr         = [IntPtr]($buf.ToInt64() + ([IntPtr]::Size * 2))
        $currentProc = [Win32Handle]::GetCurrentProcess()
        $seen        = New-Object 'System.Collections.Generic.HashSet[string]'
        $out.Enumerated = $true
        $out.HandlesSeen = $handleCount

        $skipNames = @("lsass","svchost","MsMpEng","csrss","winlogon","services","smss","wininit","System","Registry")

        for ($i = 0L; $i -lt $handleCount; $i++) {
            $sh  = [System.Runtime.InteropServices.Marshal]::PtrToStructure($ptr, [type][Win32Handle+SYSTEM_HANDLE_TABLE_ENTRY_INFO_EX])
            $ptr = [IntPtr]($ptr.ToInt64() + $entrySize)

            $vmRead = ($sh.GrantedAccess -band 0x0010) -ne 0
            $vmWrite= ($sh.GrantedAccess -band 0x0020) -ne 0
            $vmOp   = ($sh.GrantedAccess -band 0x0008) -ne 0
            $create = ($sh.GrantedAccess -band 0x0002) -ne 0   # PROCESS_CREATE_THREAD
            if (-not ($vmRead -or $vmWrite -or $vmOp -or $create)) { continue }

            $ownerPid = [int]$sh.UniqueProcessId.ToInt64()
            if ($ownerPid -le 4) { continue }
            if ($robloxPids -contains $ownerPid) { continue }

            $hOwner = [Win32Handle]::OpenProcess([Win32Handle]::PROCESS_DUP_HANDLE, $false, $ownerPid)
            if ($hOwner -eq [IntPtr]::Zero) { continue }
            try {
                $dupHandle = [IntPtr]::Zero
                $ok = [Win32Handle]::DuplicateHandle($hOwner, $sh.HandleValue, $currentProc, [ref]$dupHandle,
                                                     0, $false, [Win32Handle]::DUPLICATE_SAME_ACCESS)
                if (-not $ok -or $dupHandle -eq [IntPtr]::Zero) { continue }
                try {
                    # If this is not a process handle, GetProcessId returns 0.
                    # That replaces v4.4's hardcoded ObjectTypeNumber -eq 7.
                    $targetPid = [Win32Handle]::GetProcessId($dupHandle)
                    if ($targetPid -eq 0) { continue }
                    if ($robloxPids -notcontains $targetPid) { continue }
                    $key = "$ownerPid-$targetPid"
                    if (-not $seen.Add($key)) { continue }
                    $ownerProc = Get-Process -Id $ownerPid -ErrorAction SilentlyContinue
                    $ownerName = if ($ownerProc) { $ownerProc.ProcessName } else { "(pid $ownerPid)" }
                    if ($skipNames -contains $ownerName) { continue }
                    $ownerPath = ""
                    try { $ownerPath = $ownerProc.MainModule.FileName } catch {}
                    if (Is-GlobalFP $ownerPath) { Add-FP "Handle" $ownerPath "global FP list"; continue }
                    $out.Hits.Add([PSCustomObject]@{
                        OwnerPID=$ownerPid; OwnerName=$ownerName; OwnerPath=$ownerPath; TargetPID=$targetPid
                        Access="0x$($sh.GrantedAccess.ToString('X'))"; VMRead=$vmRead; VMWrite=$vmWrite; CreateThread=$create
                    }) | Out-Null
                } finally { [void][Win32Handle]::CloseHandle($dupHandle) }
            } finally { [void][Win32Handle]::CloseHandle($hOwner) }
        }
    } catch { $out.Error = $_.Exception.Message }
    finally { [System.Runtime.InteropServices.Marshal]::FreeHGlobal($buf) }
    return $out
}

function Run-MemoryScan {
    Write-Header "PROCESS MEMORY / THREADS / PIPES / HANDLES"

    $procs = @(Get-RobloxProcs)
    if ($procs.Count -eq 0) {
        Write-Skip "Roblox not running -- memory, thread, hollow and handle scans NOT PERFORMED"
        Mark-Skipped "Process Memory" "Roblox was not running"
        Mark-Skipped "Process Handles" "Roblox was not running"
    } else {
        $anyOpened = $false
        $covLines = [System.Collections.Generic.List[string]]::new()
        foreach ($proc in $procs) {
            $ppath = try { $proc.MainModule.FileName } catch { "" }
            Write-Info "[1/3] Memory strings: $($proc.ProcessName) PID $($proc.Id)"
            $r = Scan-RobloxProcessMemory $proc.Id $proc.ProcessName $ppath
            if ($r.Error) {
                Write-Warn "  $($r.Error)"
                $covLines.Add("$($proc.ProcessName)/$($proc.Id): NOT SCANNED ($($r.Error))") | Out-Null
            } else {
                $anyOpened = $true
                $pct = if ($r.TotalPrivateBytes -gt 0) { [math]::Round(($r.ScannedBytes / $r.TotalPrivateBytes) * 100, 1) } else { 0 }
                $cov = "$($proc.ProcessName)/$($proc.Id): scanned $([math]::Round($r.ScannedBytes/1MB,1))MB of $([math]::Round($r.TotalPrivateBytes/1MB,1))MB private ($pct%)"
                if ($r.Truncated) { $cov += " [TRUNCATED at cap]" }
                $covLines.Add($cov) | Out-Null
                Write-Info "  $cov"
                if ($r.Truncated) { Write-Warn "  Scan hit the per-process byte cap -- a nil result here is NOT proof of absence" }

                foreach ($h in $r.HighHits) {
                    Write-Hit "Memory: '$($h.String)' @ $($h.Address)"
                    $memoryFindings.Add($h) | Out-Null
                    Add-Finding -Section "Process Memory" -Type "MemStringHigh" -Detail $h.String -Value $h.Address `
                        -Severity "Critical" -Tier "A" -Evidence $h.Region
                    Add-Timeline "Memory string '$($h.String)' in $($proc.ProcessName)"
                }
                foreach ($h in $r.ProductHits) {
                    $shortNote = if ($h.String.Length -lt 6) { " NOTE: only $($h.String.Length) characters -- short strings occur by chance in binary data (e.g. 'krnl' appears in GPU driver text)." } else { "" }
                    Write-Amber "Memory: executor product name '$($h.String)' @ $($h.Address)"
                    $suspiciousMemFindings.Add($h) | Out-Null
                    Add-Finding -Section "Process Memory" -Type "MemStringProduct" -Detail $h.String -Value $h.Address `
                        -Severity "Review" -Tier "B" `
                        -Evidence "executor product name in the client's private heap; may also be chat text or game UI.$shortNote"
                    Add-Timeline "Memory product string '$($h.String)' in $($proc.ProcessName)"
                }
                foreach ($h in $r.ChatHits) {
                    # A player can TYPE any of these in chat and land them in the
                    # private heap. Never escalates without corroboration.
                    Write-Ctx "Memory (chat-reachable): '$($h.String)' @ $($h.Address)"
                    $suspiciousMemFindings.Add($h) | Out-Null
                    Add-Finding -Section "Process Memory" -Type "MemStringChat" -Detail $h.String -Value $h.Address `
                        -Severity "Context" -Evidence "chat text and game UI reach private memory; not evidence on its own"
                }
                foreach ($ub in ($r.UnbackedExec | Where-Object { $_.SizeKB -gt 256 })) {
                    Write-Amber "Large private executable region: $($ub.Address) [$($ub.Protection)] $($ub.SizeKB)KB"
                    Add-Finding -Section "Process Memory" -Type "UnbackedExec" -Detail $ub.Address `
                        -Value "$($ub.SizeKB)KB $($ub.Protection)" -Severity "Review"
                }
            }

            Write-Info "[2/3] Thread start addresses: PID $($proc.Id)"
            foreach ($t in (Get-SuspiciousThreads $proc.Id)) {
                Write-Critical "Thread TID $($t.ThreadID) starts in PRIVATE executable memory @ $($t.StartAddr)"
                $threadFindings.Add([PSCustomObject]@{ PID=$proc.Id; Name=$proc.ProcessName; ThreadID=$t.ThreadID; StartAddr=$t.StartAddr; Protection=$t.Protection }) | Out-Null
                Add-Finding -Section "Process Memory" -Type "SuspThread" -Detail "TID:$($t.ThreadID)" -Value $t.StartAddr `
                    -Severity "Critical" -Tier "A" -Evidence "$($t.Protection), $($t.RegionKB)KB"
                Add-Timeline "Shellcode-style thread TID $($t.ThreadID) in $($proc.ProcessName)"
            }

            Write-Info "[3/3] Hollowing check: PID $($proc.Id)"
            $hol = Test-ProcessHollowing $proc.Id
            if ($null -eq $hol.Result) {
                Write-Skip "  inconclusive: $($hol.Reason)"
            } elseif ($hol.Result) {
                Write-Critical "Process hollowing indicator: PEB ImageBase resides in PRIVATE memory"
                $hollowFindings.Add([PSCustomObject]@{ PID=$proc.Id; Name=$proc.ProcessName; Path=$ppath; Note="PEB ImageBase in PRIVATE memory" }) | Out-Null
                Add-Finding -Section "Process Memory" -Type "ProcessHollowing" -Detail $proc.ProcessName -Value "PID:$($proc.Id)" `
                    -Severity "Critical" -Tier "A" -Evidence "corroborate with the module scan before acting on this alone"
            } else { Write-OK "  not hollowed" }
            Write-Host ""
        }
        if ($anyOpened) { Mark-Ran "Process Memory" ($covLines -join " ; ") }
        else { Mark-Skipped "Process Memory" "OpenProcess failed on every Roblox process" }
    }

    Write-Info "Named pipes..."
    $pipeRes = Get-SuspiciousNamedPipes
    if (-not $pipeRes.Enumerated) {
        Write-Skip "Pipe enumeration failed: $($pipeRes.Error)"
        Mark-Skipped "Named Pipes" "enumeration failed: $($pipeRes.Error)"
    } else {
        Mark-Ran "Named Pipes"
        foreach ($p in $pipeRes.Pipes) {
            $sev = if ($p.Tier -eq "A") { "Critical" } else { "Review" }
            $txt = "Pipe \\.\pipe\$($p.PipeName) -- matches '$($p.Match)'"
            if ($sev -eq "Critical") { Write-Critical $txt } else { Write-Amber $txt }
            $pipeFindings.Add($p) | Out-Null
            Add-Finding -Section "Named Pipes" -Type "SuspPipe" -Detail $p.PipeName -Value $p.Match -Severity $sev -Tier $p.Tier
            Add-Timeline "Named pipe: $($p.PipeName)"
        }
        if ($pipeRes.Pipes.Count -eq 0) { Write-OK "Named pipes: nothing" }
    }

    Write-Info "Processes holding a handle to Roblox..."
    $hres = Get-ProcessesWithRobloxHandle
    if (-not $hres.Enumerated) {
        Write-Skip "Handle enumeration not performed: $($hres.Error)"
        Mark-Skipped "Process Handles" $hres.Error
    } else {
        Mark-Ran "Process Handles" "$($hres.HandlesSeen) system handles examined"
        foreach ($h in $hres.Hits) {
            $m = Test-CheatMatch $h.OwnerName
            $sev = if ($m -and $m.Tier -eq "A") { "Critical" } elseif ($h.VMWrite -or $h.CreateThread) { "Critical" } else { "Review" }
            $txt = "$($h.OwnerName) (PID $($h.OwnerPID)) holds a handle to Roblox PID $($h.TargetPID) [read=$($h.VMRead) write=$($h.VMWrite) createthread=$($h.CreateThread)]"
            if ($sev -eq "Critical") { Write-Critical $txt } else { Write-Amber $txt }
            $handleFindings.Add([PSCustomObject]@{
                OwnerPID=$h.OwnerPID; OwnerName=$h.OwnerName; OwnerPath=$h.OwnerPath
                TargetPID=$h.TargetPID; Access=$h.Access; VMRead=$h.VMRead; VMWrite=$h.VMWrite
                CheatMatch=$(if ($m) { $m.Term } else { "" })
            }) | Out-Null
            Add-Finding -Section "Process Handles" -Type "RobloxHandle" -Detail "$($h.OwnerName) (PID $($h.OwnerPID))" `
                -Value $h.Access -Severity $sev -Tier $(if ($m) { $m.Tier } else { "" }) -Evidence $h.OwnerPath
        }
        if ($hres.Hits.Count -eq 0) { Write-OK "No unexpected process holds a handle to Roblox" }
    }

    Write-SectionResult "Process Memory"
    Write-SectionResult "Named Pipes"
    Write-SectionResult "Process Handles"
}

# =====================================================
# KERNEL DRIVER SCAN
# =====================================================
function Run-KernelDriverScan {
    Write-Header "KERNEL DRIVER SCAN"
    Mark-Ran "Kernel Drivers"

    $robloxStart = $null
    foreach ($rn in $robloxProcessNames) {
        $rp = Get-Process -Name $rn -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($rp) { try { $robloxStart = $rp.StartTime } catch {}; break }
    }

    Write-Info "Event 7045 (service installs)..."
    try {
        foreach ($ev in (Get-WinEvent -FilterHashtable @{ LogName="System"; Id=7045; StartTime=$script:ScanCutoff } -MaxEvents 500 -ErrorAction Stop)) {
            $svcName = try { [string]$ev.Properties[0].Value } catch { "" }
            $svcFile = try { [string]$ev.Properties[1].Value } catch { "" }
            $svcType = try { [string]$ev.Properties[3].Value } catch { "" }
            if (-not $svcName) { continue }
            $isKernel = $svcType -like "*kernel*" -or $svcType -like "*driver*" -or $svcType -eq "1"
            $check = "$svcName $svcFile"
            if (Is-GlobalFP $check) { Add-FP "7045" $check "global FP list"; continue }

            $byovd = $null
            foreach ($bd in $byovdDrivers) { if ($check.ToLower() -like "*$bd*") { $byovd = $bd; break } }
            $m = Test-CheatMatch $check
            $inUserPath = $svcFile -and ($svcFile.ToLower() -match '\\(temp|appdata|downloads)\\')
            $nearRoblox = $robloxStart -and ([math]::Abs(($ev.TimeCreated - $robloxStart).TotalMinutes) -le 5)
            $t = $ev.TimeCreated.ToString("yyyy-MM-dd HH:mm:ss")

            if ($byovd) {
                Write-Critical "7045 BYOVD: '$svcName' matches '$byovd' at $t"
                Add-Finding -Section "Kernel Drivers" -Type "BYOVD-7045" -Detail $svcName -Value $byovd -Severity "Critical" -Tier "A" -Evidence $svcFile
                $kernelFindings.Add([PSCustomObject]@{ Type="BYOVD-Install"; Name=$svcName; File=$svcFile; Time=$t; Note="BYOVD: $byovd"; Severity="Critical" }) | Out-Null
                Add-Timeline "BYOVD driver install: $svcName"
            } elseif ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Hit "7045 cheat service: '$svcName' -- '$($m.Term)'"
                Add-Finding -Section "Kernel Drivers" -Type "CheatService-7045" -Detail $svcName -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence $svcFile
                $kernelFindings.Add([PSCustomObject]@{ Type="CheatService"; Name=$svcName; File=$svcFile; Time=$t; Note="$($m.Term)"; Severity=$sev }) | Out-Null
            } elseif ($isKernel -and $inUserPath) {
                Write-Critical "Driver installed from user-writable path: $svcName | $svcFile"
                Add-Finding -Section "Kernel Drivers" -Type "KernelDriver-UserPath" -Detail $svcName -Value $svcFile -Severity "Critical" -Tier "A"
                $kernelFindings.Add([PSCustomObject]@{ Type="UserPathDriver"; Name=$svcName; File=$svcFile; Time=$t; Note="LOADED FROM USER-WRITABLE PATH"; Severity="Critical" }) | Out-Null
            } elseif ($isKernel -and -not (Is-KnownLegitDriver $svcName)) {
                $sev = if ($nearRoblox) { "Review" } else { "Context" }
                $note = if ($nearRoblox) { "installed within 5 min of Roblox start" } else { "unfamiliar driver -- verify manually" }
                if ($nearRoblox) { Write-Amber "Driver near Roblox start: $svcName ($note)" } else { Write-Ctx "Unknown driver: $svcName" }
                Add-Finding -Section "Kernel Drivers" -Type "UnknownKernelDriver" -Detail $svcName -Value $svcFile -Severity $sev -Evidence $note
                $kernelFindings.Add([PSCustomObject]@{ Type="UnknownKernel"; Name=$svcName; File=$svcFile; Time=$t; Note=$note; Severity=$sev }) | Out-Null
            }
        }
    } catch { Write-Skip "Event 7045 unavailable" }

    Write-Info "Currently loaded drivers..."
    try {
        foreach ($drv in @(Get-CimInstance Win32_SystemDriver -ErrorAction Stop | Where-Object { $_.State -eq "Running" })) {
            $drvName = ($drv.Name -replace "\.sys$","").ToLower()
            $drvPath = $drv.PathName
            if (Is-KnownLegitDriver $drvName) { continue }
            if (Is-GlobalFP $drvPath) { Add-FP "Driver" $drvPath "global FP list"; continue }

            $clean = ($drvPath -replace '^\\\?\?\\','') -replace '"',''
            $sig = Get-SigInfo $clean

            $byovd = $null
            foreach ($bd in $byovdDrivers) {
                $hit = if ($bd.Length -le 5) { $drvName -eq $bd } else { $drvName -like "*$bd*" }
                if ($hit) { $byovd = $bd; break }
            }
            if ($byovd) {
                Write-Critical "LOADED BYOVD driver: $drvName ($drvPath)"
                Add-Finding -Section "Kernel Drivers" -Type "BYOVD-Loaded" -Detail $drvName -Value $drvPath -Severity "Critical" -Tier "A"
                $kernelFindings.Add([PSCustomObject]@{ Type="BYOVD-Loaded"; Name=$drvName; File=$drvPath; Time="NOW"; Note="currently loaded BYOVD"; Severity="Critical" }) | Out-Null
                Add-Timeline "BYOVD driver loaded: $drvName"
                continue
            }
            if ($sig.Thumb -and $knownBadThumbs -contains $sig.Thumb) {
                Write-Critical "Known-abused signing cert: $drvName | $($sig.Thumb)"
                Add-Finding -Section "Kernel Drivers" -Type "AbusedCertDriver" -Detail $drvName -Value $sig.Thumb -Severity "Critical" -Tier "A"
                $kernelFindings.Add([PSCustomObject]@{ Type="AbusedCert"; Name=$drvName; File=$clean; Time="NOW"; Note="abused cert $($sig.Thumb)"; Severity="Critical" }) | Out-Null
                continue
            }
            if ($sig.Status -in @("HashMismatch","NotTrusted")) {
                Write-Critical "Invalid signature on loaded driver: $drvName ($($sig.Status))"
                Add-Finding -Section "Kernel Drivers" -Type "InvalidSigDriver" -Detail $drvName -Value $sig.Status -Severity "Critical" -Tier "A"
                $kernelFindings.Add([PSCustomObject]@{ Type="InvalidSig"; Name=$drvName; File=$clean; Time="NOW"; Note=$sig.Status; Severity="Critical" }) | Out-Null
                continue
            }
            $m = Test-CheatMatch $drvName
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Hit "Loaded driver matches cheat term: $drvName -- '$($m.Term)'"
                Add-Finding -Section "Kernel Drivers" -Type "LoadedDriver-CheatMatch" -Detail $drvName -Value $drvPath -Severity $sev -Tier $m.Tier
                $kernelFindings.Add([PSCustomObject]@{ Type="CheatDriver"; Name=$drvName; File=$drvPath; Time="NOW"; Note=$m.Term; Severity=$sev }) | Out-Null
                continue
            }
            if ($drvPath -and ($drvPath.ToLower() -match '\\(temp|appdata|downloads)\\')) {
                Write-Critical "Driver running from user-writable path: $drvName | $drvPath"
                Add-Finding -Section "Kernel Drivers" -Type "LoadedDriver-UserPath" -Detail $drvName -Value $drvPath -Severity "Critical" -Tier "A"
                $kernelFindings.Add([PSCustomObject]@{ Type="UserPathLoaded"; Name=$drvName; File=$drvPath; Time="NOW"; Note="user-writable path"; Severity="Critical" }) | Out-Null
            }
        }
    } catch { Write-Skip "Driver enumeration unavailable"; Mark-Skipped "Kernel Drivers" "Win32_SystemDriver query failed" }

    Write-SectionResult "Kernel Drivers"
}

# =====================================================
# LAUNCH CHAIN
# v4.4 charged 50 points for a "non-official path" and another 20 for a
# "third-party launcher" -- then matched the launcher on parentPATH, so
# RobloxPlayerBeta.exe itself was labelled a launcher on every Fishstrap
# machine. Bloxstrap/Fishstrap are open-source bootstrappers that do not modify
# the client; they are now CONTEXT. The real check is whether the client binary
# is Roblox-signed, wherever it lives.
# =====================================================
function Run-LaunchChainScan {
    Write-Header "ROBLOX LAUNCH CHAIN"
    $procs = @(Get-RobloxProcs)
    if ($procs.Count -eq 0) {
        Write-Skip "Roblox not running -- launch chain NOT CHECKED"
        Mark-Skipped "Launch Chain" "Roblox was not running"
        Write-SectionResult "Launch Chain"
        return
    }
    Mark-Ran "Launch Chain"
    $neutralParents = @("explorer","userinit","svchost","cmd","powershell","pwsh","wininit","winlogon","services","taskmgr","system","chrome","msedge","firefox","brave","opera")

    foreach ($proc in $procs) {
        Write-Host "  $($proc.ProcessName) PID $($proc.Id)" -ForegroundColor Cyan
        $chain = Get-ProcessAncestry $proc.Id
        foreach ($l in $chain) {
            $marker = if ($l.Suspect) { " <-- $($l.Note)" } else { "" }
            Write-Info "    PID $($l.PID) $($l.Name) | $($l.Path)$marker"
            if ($l.Suspect) {
                Add-Finding -Section "Launch Chain" -Type "AncestryUnreliable" -Detail "PID $($l.PID) $($l.Name)" `
                    -Severity "Context" -Evidence $l.Note
            }
        }

        $procPath = try { $proc.MainModule.FileName } catch { "" }
        if ($procPath) {
            $sig = Get-SigInfo $procPath
            $isRoblox = ($sig.Status -eq "Valid" -and ($knownRobloxSigners | Where-Object { $sig.Subject -like "*$_*" }))
            if ($isRoblox) {
                if (Is-KnownLauncher $procPath) {
                    Write-Ctx "Running from a third-party launcher directory, binary is Roblox-signed: $procPath"
                    Add-Finding -Section "Launch Chain" -Type "ThirdPartyLauncherPath" -Detail $procPath -Severity "Context" `
                        -Evidence "open-source bootstrapper; stock Roblox-signed client binary"
                    $launchChainFindings.Add([PSCustomObject]@{ RobloxProcess="$($proc.ProcessName) PID $($proc.Id)"; ParentName=""; ParentPath=$procPath; Note="third-party launcher (context only)"; Severity="Context" }) | Out-Null
                } else { Write-OK "Client binary is Roblox-signed: $procPath" }
            } else {
                Write-Critical "Roblox client binary is NOT Roblox-signed: $procPath [$($sig.Status)]"
                Add-Finding -Section "Launch Chain" -Type "UnsignedClient" -Detail $procPath -Value $sig.Status -Severity "Critical" -Tier "A" `
                    -Evidence "signer: $($sig.Subject)"
                $launchChainFindings.Add([PSCustomObject]@{ RobloxProcess="$($proc.ProcessName) PID $($proc.Id)"; ParentName=""; ParentPath=$procPath; Note="CLIENT BINARY NOT ROBLOX-SIGNED"; Severity="Critical" }) | Out-Null
                Add-Timeline "Unsigned Roblox client: $procPath"
            }
        }

        for ($i = 1; $i -lt $chain.Count; $i++) {
            $parent = $chain[$i]
            $pn = if ($parent.Name) { $parent.Name.ToLower() -replace '\.exe$','' } else { "" }
            if (-not $pn) { continue }
            # Roblox's own binaries are not "launchers".
            if ($robloxProcessNames -contains ($parent.Name -replace '\.exe$','')) { continue }

            $m = Test-CheatMatch $parent.Name
            if (-not $m -and $parent.Path) { $m = Test-CheatMatch $parent.Path }
            if ($m) {
                $sev = Get-SeverityForMatch $m "Critical"
                Write-Critical "Cheat-matched process in launch chain: $($parent.Name) -- '$($m.Term)'"
                Add-Finding -Section "Launch Chain" -Type "CheatInLaunchChain" -Detail $parent.Name -Value $m.Term -Severity $sev -Tier $m.Tier -Evidence $parent.Path
                $launchChainFindings.Add([PSCustomObject]@{ RobloxProcess="$($chain[0].Name) PID $($chain[0].PID)"; ParentName=$parent.Name; ParentPath=$parent.Path; Note="CHEAT MATCH: $($m.Term)"; Severity=$sev }) | Out-Null
                continue
            }
            # Match the launcher on the parent's NAME, not its path.
            if (Is-KnownLauncher $pn) {
                Write-Ctx "Third-party launcher in chain: $($parent.Name)"
                Add-Finding -Section "Launch Chain" -Type "ThirdPartyLauncher" -Detail $parent.Name -Severity "Context" -Evidence $parent.Path
                $launchChainFindings.Add([PSCustomObject]@{ RobloxProcess="$($chain[0].Name) PID $($chain[0].PID)"; ParentName=$parent.Name; ParentPath=$parent.Path; Note="known launcher (context only)"; Severity="Context" }) | Out-Null
                break
            }
            $isNeutral = $neutralParents -contains $pn
            if (-not $isNeutral) {
                Write-Ctx "Unrecognised parent: $($parent.Name) ($($parent.Path))"
                Add-Finding -Section "Launch Chain" -Type "UnexpectedParent" -Detail $parent.Name -Value $parent.Path -Severity "Context"
                $launchChainFindings.Add([PSCustomObject]@{ RobloxProcess="$($chain[0].Name) PID $($chain[0].PID)"; ParentName=$parent.Name; ParentPath=$parent.Path; Note="unrecognised parent -- verify manually"; Severity="Context" }) | Out-Null
            }
        }
        Write-Host ""
    }
    Write-SectionResult "Launch Chain"
}

# =====================================================
# ROBLOX LOG SCAN
# =====================================================
function Scan-RobloxLogs {
    Write-Header "ROBLOX LOG FILES"
    $logRoots = @("$env:LOCALAPPDATA\Roblox\logs")
    foreach ($l in $knownThirdPartyLaunchers) { $logRoots += "$env:LOCALAPPDATA\$l\Logs" }
    $logFiles = [System.Collections.Generic.List[object]]::new()
    foreach ($lr in $logRoots) {
        if (-not (Test-Path $lr)) { continue }
        Get-ChildItem $lr -File -Filter "*.log" -Recurse -ErrorAction SilentlyContinue |
            Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff } |
            ForEach-Object { $logFiles.Add($_) | Out-Null }
    }
    if ($logFiles.Count -eq 0) {
        Write-Skip "No Roblox log files in range -- NOT CHECKED"
        Mark-Skipped "Roblox Logs" "no log files found within the selected time range"
        Write-SectionResult "Roblox Logs"
        return
    }

    $logFiles = @($logFiles | Sort-Object LastWriteTime -Descending | Select-Object -First 100)
    Mark-Ran "Roblox Logs" "$($logFiles.Count) log file(s)"
    Write-Info "Log files: $($logFiles.Count)"
    $seen = New-Object 'System.Collections.Generic.HashSet[string]'
    $n = 0
    foreach ($log in $logFiles) {
        try {
            $lineNum = 0
            foreach ($line in [System.IO.File]::ReadLines($log.FullName)) {
                $lineNum++
                $ll = $line.ToLower()
                $hi = $null
                foreach ($mk in $robloxLogMarkersHigh) { if ($ll.Contains($mk)) { $hi = $mk; break } }
                if ($hi) {
                    $key = "$($log.Name)|H|$hi"
                    if ($seen.Add($key)) {
                        $snip = $line.Trim(); if ($snip.Length -gt 160) { $snip = $snip.Substring(0,160) + "..." }
                        Write-Hit "Log [$($log.Name):$lineNum] executor API '$hi'"
                        Add-Finding -Section "Roblox Logs" -Type "LogMarkerHigh" -Detail "$($log.Name):$lineNum" `
                            -Value $hi -Severity "Critical" -Tier "A" -Evidence $snip
                        Add-Timeline "Roblox log executor marker '$hi'"
                        $n++
                    }
                    continue
                }
                $noise = $null
                foreach ($mk in $robloxLogMarkersNoise) { if ($ll.Contains($mk)) { $noise = $mk; break } }
                if ($noise) {
                    $key = "$($log.Name)|N|$noise"
                    if ($seen.Add($key)) {
                        # These appear in ordinary client stack traces. Context only.
                        Add-Finding -Section "Roblox Logs" -Type "LogMarkerNoise" -Detail "$($log.Name):$lineNum" `
                            -Value $noise -Severity "Context" -Evidence "also appears in ordinary client script errors"
                    }
                    continue
                }
                $m = Test-CheatMatch $line
                if ($m -and $m.Tier -eq "A") {
                    $key = "$($log.Name)|T|$($m.Term)"
                    if ($seen.Add($key)) {
                        $snip = $line.Trim(); if ($snip.Length -gt 160) { $snip = $snip.Substring(0,160) + "..." }
                        Write-Hit "Log [$($log.Name):$lineNum] cheat term '$($m.Term)'"
                        Add-Finding -Section "Roblox Logs" -Type "LogCheatTerm" -Detail "$($log.Name):$lineNum" `
                            -Value $m.Term -Severity "Critical" -Tier "A" -Evidence $snip
                        $n++
                    }
                }
            }
        } catch { continue }
    }
    if ($n -eq 0) { Write-OK "Roblox logs: nothing" }
    Write-SectionResult "Roblox Logs"
}

# =====================================================
# AMCACHE (presence class) -- with unmount retry
# =====================================================
function Run-AmCacheScan {
    Write-Header "AMCACHE (via VSS)"
    $shadow = Get-CimInstance Win32_ShadowCopy -ErrorAction SilentlyContinue | Sort-Object InstallDate -Descending | Select-Object -First 1
    if (-not $shadow) {
        Write-Skip "No VSS shadow copy -- AmCache NOT CHECKED (the hive is locked while Windows runs)"
        return
    }
    $hive      = "$($shadow.DeviceObject)\Windows\AppCompat\Programs\Amcache.hve"
    $mountKey  = "HKLM\TempAmCache_CheatScan"
    $mountPath = "HKLM:\TempAmCache_CheatScan"
    $mounted   = $false
    try {
        Write-Info "Shadow copy: $($shadow.InstallDate)"
        $null = reg load $mountKey $hive 2>&1
        if ($LASTEXITCODE -ne 0) { Write-Warn "Could not mount AmCache hive"; return }
        $mounted = $true

        $baseKey = [Microsoft.Win32.RegistryKey]::OpenBaseKey('LocalMachine','Registry64')
        $appKey  = $baseKey.OpenSubKey('TempAmCache_CheatScan\Root\InventoryApplicationFile')
        if ($appKey) {
            $names = @($appKey.GetSubKeyNames())
            Write-Info "AmCache entries: $($names.Count)"
            $n = 0
            foreach ($name in $names) {
                $sub = $null
                try {
                    $sub = $appKey.OpenSubKey($name)
                    if (-not $sub) { continue }
                    $check = "$($sub.GetValue('Name')) $($sub.GetValue('LowerCaseLongPath'))"
                    if (Is-GlobalFP $check) { Add-FP "AmCache" $check "global FP list"; continue }
                    $m = Test-CheatMatch $check
                    if ($m) {
                        $sev = Get-SeverityForMatch $m "Review"    # presence, not execution
                        $acName = [string]$sub.GetValue('Name')
                        $acPath = [string]$sub.GetValue('LowerCaseLongPath')
                        $txt = "AmCache: $acName at $acPath -- '$($m.Term)'"
                        if ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
                        Add-Finding -Section "Presence Artifacts" -Type "AmCache" -Detail $acName `
                            -Value $m.Term -Severity $sev -Tier $m.Tier `
                            -Evidence "InventoryApplicationFile records files PRESENT on disk; does NOT prove execution"
                        $n++
                    }
                } catch { continue }
                finally { if ($sub) { $sub.Close(); $sub.Dispose() } }
            }
            if ($n -eq 0) { Write-OK "AmCache: nothing" }
            $appKey.Close(); $appKey.Dispose()
        }

        $drvKey = $baseKey.OpenSubKey('TempAmCache_CheatScan\Root\InventoryDriverBinary')
        if ($drvKey) {
            foreach ($name in @($drvKey.GetSubKeyNames())) {
                $sub = $null
                try {
                    $sub = $drvKey.OpenSubKey($name)
                    if (-not $sub) { continue }
                    $dn = ([string]$sub.GetValue('DriverName') -replace "\.sys$","").ToLower()
                    if ($dn -and $byovdDrivers -contains $dn) {
                        Write-Amber "AmCache BYOVD remnant: $dn"
                        Add-Finding -Section "Kernel Drivers" -Type "AmCache-BYOVD" -Detail $dn -Severity "Review" `
                            -Evidence "driver binary was present on disk at some point"
                    }
                } catch { continue }
                finally { if ($sub) { $sub.Close(); $sub.Dispose() } }
            }
            $drvKey.Close(); $drvKey.Dispose()
        }
        if ($baseKey) { $baseKey.Close(); $baseKey.Dispose() }
    } catch { Write-Warn "AmCache scan error: $_" }
    finally {
        if ($mounted) {
            # v4.4 tried once and gave up, leaving a hive mounted under HKLM on
            # the subject's machine. For a tool whose whole premise is "do not
            # modify the target", that was the one place it did.
            $ok = $false
            for ($try = 1; $try -le 5; $try++) {
                [GC]::Collect(); [GC]::WaitForPendingFinalizers()
                Start-Sleep -Milliseconds (300 * $try)
                $null = reg unload $mountKey 2>&1
                if ($LASTEXITCODE -eq 0) { $ok = $true; break }
            }
            if ($ok) { Write-OK "AmCache hive unmounted cleanly" }
            else {
                Write-Critical "AMCACHE HIVE DID NOT UNMOUNT -- $mountKey is still loaded. Reboot to clear."
                Add-Finding -Section "Presence Artifacts" -Type "ScannerSideEffect" `
                    -Detail "AmCache hive left mounted at $mountKey" -Severity "Review" `
                    -Evidence "the scanner modified the machine state; note this in any report"
            }
        }
    }
}

# =====================================================
# DOWNLOAD PROVENANCE (NEW in v4.5)
# Zone.Identifier alternate data streams carry the URL a file was downloaded
# from. High signal, near-zero false positives, and it answers "where did this
# come from" which no other section could.
# =====================================================
function Run-ProvenanceScan {
    Write-Header "DOWNLOAD PROVENANCE (Zone.Identifier)"
    Mark-Ran "Download Provenance"
    $paths = @("$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop","$env:TEMP","$env:APPDATA","$env:LOCALAPPDATA")
    $n = 0; $checked = 0
    foreach ($p in $paths) {
        if (-not (Test-Path $p)) { continue }
        foreach ($f in @(Get-ChildItem $p -File -Force -ErrorAction SilentlyContinue |
                         Where-Object { $_.Extension -match '^\.(exe|dll|zip|rar|7z|scr|bat|ps1|msi)$' } |
                         Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })) {
            $checked++
            $prov = Get-DownloadProvenance $f.FullName
            if (-not $prov) { continue }
            $urls = "$($prov.HostUrl) $($prov.ReferrerUrl)".ToLower()
            $hitDomain = $null
            foreach ($d in $suspiciousDomains) { if ($urls -like "*$($d.ToLower())*") { $hitDomain = $d; break } }
            $m = Test-CheatMatch $f.Name
            if (-not $m -and $urls) {
                foreach ($t in $cheatTerms) {
                    if ($t.Tier -ne "A") { continue }
                    if ($urls -like "*$($t.T.ToLower())*") { $m = @{ Term=$t.T; Tier="A"; Match="Token" }; break }
                }
            }
            if ($hitDomain -or ($m -and $m.Tier -eq "A")) {
                $term = if ($hitDomain) { $hitDomain } else { $m.Term }
                Write-Hit "Downloaded from cheat source: $($f.Name) <- $($prov.HostUrl)"
                Add-Finding -Section "Download Provenance" -Type "CheatDownload" -Detail $f.FullName `
                    -Value $term -Severity "Critical" -Tier "A" `
                    -Evidence "HostUrl: $($prov.HostUrl) | Referrer: $($prov.ReferrerUrl)"
                $provenanceFindings.Add([PSCustomObject]@{ File=$f.FullName; HostUrl=$prov.HostUrl; Referrer=$prov.ReferrerUrl; Match=$term; Severity="Critical" }) | Out-Null
                Add-Timeline "Downloaded from cheat source: $($f.Name)"
                $n++
            } elseif ($prov.HostUrl) {
                $provenanceFindings.Add([PSCustomObject]@{ File=$f.FullName; HostUrl=$prov.HostUrl; Referrer=$prov.ReferrerUrl; Match=""; Severity="Context" }) | Out-Null
                Add-Finding -Section "Download Provenance" -Type "Download" -Detail $f.FullName -Value $prov.HostUrl -Severity "Context"
            }
        }
    }
    $script:Sections["Download Provenance"].Coverage = "$checked file(s) examined, $($provenanceFindings.Count) with recorded origin"
    if ($n -eq 0) { Write-OK "No file downloaded from a known cheat source" }
    Write-SectionResult "Download Provenance"
}

# =====================================================
# CRASH ARTIFACTS (NEW in v4.5)
# Hyperion crashes the Roblox client when it detects tampering. A cluster of
# Roblox crash reports is therefore evidence of BLOCKED injection attempts --
# which the rest of the tool has no way to see.
# =====================================================
function Run-CrashArtifactScan {
    Write-Header "CRASH ARTIFACTS (WER)"
    $werRoots = @(
        "$env:LOCALAPPDATA\Microsoft\Windows\WER\ReportArchive",
        "$env:LOCALAPPDATA\Microsoft\Windows\WER\ReportQueue",
        "$env:ProgramData\Microsoft\Windows\WER\ReportArchive",
        "$env:ProgramData\Microsoft\Windows\WER\ReportQueue"
    )
    $any = $false
    $crashes = [System.Collections.Generic.List[object]]::new()
    foreach ($root in $werRoots) {
        if (-not (Test-Path $root)) { continue }
        $any = $true
        foreach ($dir in @(Get-ChildItem $root -Directory -ErrorAction SilentlyContinue |
                           Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })) {
            $wer = Get-ChildItem $dir.FullName -Filter "Report.wer" -File -ErrorAction SilentlyContinue | Select-Object -First 1
            if (-not $wer) { continue }
            try {
                $txt = Get-Content $wer.FullName -Raw -ErrorAction Stop
                if ($txt -notmatch '(?i)roblox') { continue }
                $appName = if ($txt -match '(?im)^AppName=(.+)$') { $Matches[1].Trim() } else { "(unknown)" }
                $crashes.Add([PSCustomObject]@{ App=$appName; When=$dir.LastWriteTime; Dir=$dir.FullName }) | Out-Null
            } catch { continue }
        }
    }
    if (-not $any) {
        Write-Skip "No WER directories present -- NOT CHECKED"
        Mark-Skipped "Crash Artifacts" "Windows Error Reporting directories not present"
        Write-SectionResult "Crash Artifacts"
        return
    }
    Mark-Ran "Crash Artifacts" "$($crashes.Count) Roblox-related crash report(s) in range"
    if ($crashes.Count -eq 0) { Write-OK "No Roblox crash reports in range" }
    else {
        Write-Info "Roblox crash reports in range: $($crashes.Count)"
        # Repeated client crashes are consistent with the anti-cheat terminating
        # the process on tamper detection. They are also consistent with a bad
        # GPU driver. Review-only, never a verdict on their own.
        $sev = if ($crashes.Count -ge 5) { "Review" } else { "Context" }
        foreach ($c in ($crashes | Sort-Object When -Descending | Select-Object -First 25)) {
            Write-Ctx "$($c.App) crashed $($c.When.ToString('yyyy-MM-dd HH:mm:ss'))"
        }
        Add-Finding -Section "Crash Artifacts" -Type "RobloxCrashCluster" `
            -Detail "$($crashes.Count) Roblox crash report(s)" -Severity $sev `
            -Evidence "the anti-cheat terminates the client on tamper detection; crashes are also caused by ordinary driver faults"
    }
    Write-SectionResult "Crash Artifacts"
}

# =====================================================
# HASH BLOCKLIST (NEW in v4.5)
# Names are the attacker's free variable. Hashes are not.
# =====================================================
function Run-HashBlocklistScan {
    Write-Header "SHA256 BLOCKLIST"
    if ($script:HashBlocklist.Count -eq 0) {
        Write-Skip "No blocklist supplied (-HashList <file>) -- NOT CHECKED"
        Mark-Skipped "Hash Blocklist" "no -HashList file supplied"
        Write-SectionResult "Hash Blocklist"
        return
    }
    Write-Info "Blocklist entries: $($script:HashBlocklist.Count)"
    $paths = @("$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop","$env:TEMP","$env:APPDATA","$env:LOCALAPPDATA")
    $paths += Get-RobloxInstallRoots
    $n = 0; $checked = 0
    foreach ($p in $paths) {
        if (-not (Test-Path $p)) { continue }
        foreach ($f in @(Get-ChildItem $p -File -Force -Recurse -Depth 2 -ErrorAction SilentlyContinue |
                         Where-Object { $_.Extension -match '^\.(exe|dll|sys|scr)$' -and $_.Length -lt 200MB })) {
            $checked++
            $h = Get-FileSha256 $f.FullName
            if ($h -and $script:HashBlocklist.ContainsKey($h)) {
                Write-Critical "BLOCKLISTED HASH: $($f.FullName) = $($script:HashBlocklist[$h])"
                Add-Finding -Section "Hash Blocklist" -Type "BlocklistedHash" -Detail $f.FullName `
                    -Value $script:HashBlocklist[$h] -Severity "Critical" -Tier "A" -Evidence "SHA256 $h"
                Add-Timeline "Blocklisted hash: $($f.FullName)"
                $n++
            }
        }
    }
    Mark-Ran "Hash Blocklist" "$checked file(s) hashed against $($script:HashBlocklist.Count) entries"
    if ($n -eq 0) { Write-OK "No blocklisted hashes found" }
    Write-SectionResult "Hash Blocklist"
}

# =====================================================
# RENAMED BINARY SCAN  (RESTORED -- was in v4.4, dropped in v4.5)
#
# Renaming is the cheapest evasion there is: solara.exe -> svchost.exe defeats
# every name-based check in this tool at once. This reads the binary's own
# header/string table instead of its filename. v4.5 kept the helper function
# and never called it, so this capability was silently absent for four builds.
#
# Improved over v4.4:
#   * streams 64KB instead of ReadAllBytes (v4.4 could OOM on a large file)
#   * Tier-aware -- a Tier B term inside a binary is REVIEW, not CRITICAL
#   * skips Microsoft/Roblox-signed binaries outright
#   * reports the signer, so "renamed" vs "legitimately named" is visible
# =====================================================
function Run-RenamedBinaryScan {
    Write-Header "RENAMED BINARY SCAN (PE content)"
    Mark-Ran "Renamed Binaries"
    $paths = @("$env:TEMP","$env:LOCALAPPDATA\Temp","$env:APPDATA","$env:LOCALAPPDATA",
               "$env:USERPROFILE\Downloads","$env:USERPROFILE\Desktop")
    $checked = 0; $n = 0
    foreach ($sp in $paths) {
        if (-not (Test-Path $sp)) { continue }
        foreach ($exe in @(Get-ChildItem $sp -File -Force -ErrorAction SilentlyContinue |
                           Where-Object { $_.Extension -match '^\.(exe|dll|scr)$' } |
                           Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })) {
            if (Is-GlobalFP $exe.FullName) { Add-FP "RenamedPE" $exe.FullName "global FP list"; continue }

            $sig = Get-SigInfo $exe.FullName
            $trusted = $false
            if ($sig.Status -eq "Valid") {
                foreach ($t in @("Microsoft Corporation","Microsoft Windows","Roblox Corporation")) {
                    if ($sig.Subject -like "*$t*") { $trusted = $true; break }
                }
            }
            if ($trusted) { Add-FP "RenamedPE" $exe.FullName "validly signed by $($sig.Subject)"; continue }

            $checked++
            $content = Get-PEHeaderString $exe.FullName 65536
            if (-not $content) { continue }
            $lower = $content.ToLower()

            $hitTerm = $null; $hitTier = $null
            foreach ($t in $cheatTerms) {
                if ($t.Tier -eq "C") { continue }          # fragments produce garbage inside binaries
                if ($t.T.Length -lt 5) { continue }        # too short to be meaningful in a byte blob
                if ($lower.Contains($t.T.ToLower())) { $hitTerm = $t.T; $hitTier = $t.Tier; if ($t.Tier -eq "A") { break } }
            }
            if (-not $hitTerm) {
                foreach ($d in $suspiciousDomains) {
                    if ($lower.Contains($d.ToLower())) { $hitTerm = $d; $hitTier = "A"; break }
                }
            }
            if (-not $hitTerm) { continue }

            # If the filename ALSO matches, it is not renamed -- other sections
            # already have it. The interesting case is content != name.
            $nameMatch = Test-CheatMatch $exe.Name
            $renamed   = ($null -eq $nameMatch)
            $sev = if ($hitTier -eq "A") { if ($renamed) { "Critical" } else { "Review" } } else { "Review" }
            $label = if ($renamed) { "RENAMED" } else { "name already matches" }
            $txt = "$label binary: $($exe.FullName) contains '$hitTerm' [Tier $hitTier]"
            if ($sev -eq "Critical") { Write-Hit $txt } else { Write-Amber $txt }
            Add-Finding -Section "Renamed Binaries" -Type $(if ($renamed) { "RenamedPE" } else { "PEContentMatch" }) `
                -Detail $exe.FullName -Value $hitTerm -Severity $sev -Tier $hitTier `
                -Evidence "string found inside the first 64KB of the binary; signature: $($sig.Status) $($sig.Subject)"
            if ($renamed) { Add-Timeline "Renamed cheat binary: $($exe.FullName) contains '$hitTerm'" }
            $n++
        }
    }
    $script:Sections["Renamed Binaries"].Coverage = "$checked unsigned/untrusted binaries inspected"
    if ($n -eq 0) { Write-OK "No cheat strings inside untrusted binaries ($checked inspected)" }
    Write-SectionResult "Renamed Binaries"
}

# =====================================================
# PAN SCAN -- PREFETCH, ALL NAMES, ALL TIME  (RESTORED from v4.4)
#
# The main prefetch pass honours the selected time range. That means a
# participant who accepts the 2-day default hides anything that ran last week.
# This pass ignores the range entirely and checks every .pf file for cheat
# names. It exists precisely because the default answer is the wrong one.
# =====================================================
function Run-PANScan {
    Write-Header "PREFETCH -- ALL NAMES, ALL TIME"
    $pfPath = "C:\Windows\Prefetch"
    if (-not (Test-Path $pfPath)) {
        Write-Skip "Prefetch directory not present -- all-time pass NOT PERFORMED"
        Write-Host ""
        return
    }
    $pfFiles = @(Get-ChildItem $pfPath -Filter "*.pf" -File -Force -ErrorAction SilentlyContinue)
    Write-Info "Checking all $($pfFiles.Count) prefetch files regardless of the selected time range"
    $n = 0
    $alreadySeen = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($r in $prefetchViewerData) { if ($r.Exe) { [void]$alreadySeen.Add([string]$r.Exe) } }

    foreach ($pf in $pfFiles) {
        $base = [System.IO.Path]::GetFileNameWithoutExtension($pf.Name)
        $exe  = if ($base -match '^(.+)-[0-9A-F]{8}$') { $Matches[1] } else { $base }
        if ($alreadySeen.Contains($exe)) { continue }     # in range already, reported above
        if (Is-GlobalFP $exe) { Add-FP "PAN" $exe "global FP list"; continue }
        $m = Test-CheatMatch $exe
        if (-not $m) { continue }
        $info    = Get-PrefetchInfo $pf.FullName
        $lastRun = if ($info.Times.Count -gt 0) { $info.Times[0].ToString("yyyy-MM-dd HH:mm:ss") } else { $pf.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") }
        $sev = Get-SeverityForMatch $m "Critical"
        $txt = "OUTSIDE selected range -- $exe ran $lastRun ($($info.RunCount)x) -- '$($m.Term)' [Tier $($m.Tier)]"
        if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
        Add-Finding -Section "Execution Artifacts" -Type "Prefetch-AllTime" -Detail $exe `
            -Value $m.Term -Severity $sev -Tier $m.Tier `
            -Evidence "last run $lastRun, run count $($info.RunCount) -- found only because this pass ignores the time range"
        Add-Timeline "Prefetch (all-time): $exe ran $lastRun"
        $prefetchViewerData.Add([PSCustomObject]@{
            FileName=$pf.Name; Exe=$exe; SizeKB=[math]::Round($pf.Length/1KB,2)
            LastRun=$lastRun; AllRunTimes=$lastRun; RunCount=$info.RunCount
            Parsed=$info.Parsed; Match=$m.Term; Tier=$m.Tier; MatchType=$m.Match
        }) | Out-Null
        $n++
    }
    if ($n -eq 0) { Write-OK "No additional cheat names in prefetch outside the selected range" }
    Write-Host ""
}

# =====================================================
# RECENT FILES (.lnk shortcuts)  (RESTORED from v4.4)
# Explorer writes a shortcut here when a file is opened. Presence-class:
# it shows a file was accessed, not that it executed.
# =====================================================
function Run-RecentFilesScan {
    Write-Header "RECENT FILES (shortcuts)"
    $recentPath = "$env:APPDATA\Microsoft\Windows\Recent"
    if (-not (Test-Path $recentPath)) {
        Write-Skip "Recent folder not present"
        Write-Host ""
        return
    }
    $items = @(Get-ChildItem $recentPath -File -Force -ErrorAction SilentlyContinue |
               Where-Object { $script:ScanDaysBack -ge 9999 -or $_.LastWriteTime -ge $script:ScanCutoff })
    Write-Info "Recent items in range: $($items.Count)"
    $n = 0
    foreach ($item in $items) {
        if (Is-GlobalFP $item.FullName) { Add-FP "RecentFile" $item.Name "global FP list"; continue }
        $m = Test-CheatMatch $item.Name
        if (-not $m) { continue }
        $sev = Get-SeverityForMatch $m "Review"     # presence, never critical alone
        $txt = "Recent: $($item.Name) -- '$($m.Term)' [Tier $($m.Tier)]"
        if ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
        Add-Finding -Section "Presence Artifacts" -Type "RecentFile" -Detail $item.Name `
            -Value $m.Term -Severity $sev -Tier $m.Tier `
            -Evidence "shortcut written $($item.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')); shows the file was OPENED, not that it ran"
        $n++
    }
    if ($n -eq 0) { Write-OK "Recent files: nothing" }
    Write-Host ""
}

# =====================================================
# RECYCLE BIN  (NEW)
# $I records preserve the ORIGINAL path and the deletion time of every file
# still in the bin. Someone who deleted a cheat rather than shredding it leaves
# the whole story here -- and unlike prefetch, nothing evicts it automatically.
# =====================================================
function Get-RecycleBinRecords {
    $out = [System.Collections.Generic.List[object]]::new()
    foreach ($drive in @(Get-PSDrive -PSProvider FileSystem -ErrorAction SilentlyContinue |
                         Where-Object { $_.Root -match '^[A-Za-z]:\\$' })) {
        $binRoot = Join-Path $drive.Root '$Recycle.Bin'
        if (-not (Test-Path $binRoot)) { continue }
        foreach ($sidDir in @(Get-ChildItem $binRoot -Directory -Force -ErrorAction SilentlyContinue)) {
            foreach ($f in @(Get-ChildItem $sidDir.FullName -Filter '$I*' -File -Force -ErrorAction SilentlyContinue)) {
                try {
                    $b = [System.IO.File]::ReadAllBytes($f.FullName)
                    if ($b.Length -lt 24) { continue }
                    $ver = [System.BitConverter]::ToInt64($b, 0)
                    $size = [System.BitConverter]::ToInt64($b, 8)
                    $ft   = [System.BitConverter]::ToInt64($b, 16)
                    $when = $null
                    if ($ft -gt 0 -and $ft -lt 999999999999999999L) {
                        try { $when = [DateTime]::FromFileTimeUtc($ft).ToLocalTime() } catch {}
                    }
                    $path = ""
                    if ($ver -eq 2) {
                        if ($b.Length -lt 28) { continue }
                        $len = [System.BitConverter]::ToInt32($b, 24)
                        if ($len -gt 0 -and (28 + $len * 2) -le $b.Length) {
                            $path = [System.Text.Encoding]::Unicode.GetString($b, 28, $len * 2).TrimEnd([char]0)
                        }
                    } else {
                        if ($b.Length -ge 24 + 520) {
                            $path = [System.Text.Encoding]::Unicode.GetString($b, 24, 520).TrimEnd([char]0)
                        }
                    }
                    if (-not $path) { continue }
                    $out.Add([PSCustomObject]@{ OriginalPath=$path; SizeBytes=$size; Deleted=$when; Record=$f.FullName }) | Out-Null
                } catch { continue }
            }
        }
    }
    return $out
}

function Run-RecycleBinScan {
    Write-Header "RECYCLE BIN (deleted file records)"
    $recs = Get-RecycleBinRecords
    if ($recs.Count -eq 0) {
        Write-Skip "No readable Recycle Bin records -- NOT CHECKED"
        Mark-Skipped "Deleted Files" 'no readable index records found (bin empty or access denied)'
        Write-SectionResult "Deleted Files"
        return
    }
    Mark-Ran "Deleted Files" "$($recs.Count) deleted-file record(s) read"
    Write-Info "Records: $($recs.Count)"
    $n = 0
    foreach ($r in $recs) {
        if ($script:ScanDaysBack -lt 9999 -and $r.Deleted -and $r.Deleted -lt $script:ScanCutoff) { continue }
        if (Is-GlobalFP $r.OriginalPath) { Add-FP "RecycleBin" $r.OriginalPath "global FP list"; continue }
        $m = Test-CheatMatch $r.OriginalPath
        if (-not $m) { continue }
        $sev = Get-SeverityForMatch $m "Critical"
        $when = if ($r.Deleted) { $r.Deleted.ToString("yyyy-MM-dd HH:mm:ss") } else { "unknown" }
        $txt = "Deleted: $($r.OriginalPath) at $when -- '$($m.Term)' [Tier $($m.Tier)]"
        if ($sev -eq "Critical") { Write-Hit $txt } elseif ($sev -eq "Review") { Write-Amber $txt } else { Write-Ctx $txt }
        Add-Finding -Section "Deleted Files" -Type "RecycleBinCheatFile" -Detail $r.OriginalPath `
            -Value $m.Term -Severity $sev -Tier $m.Tier `
            -Evidence "deleted $when, $([math]::Round($r.SizeBytes/1KB,1))KB; the file itself may still be recoverable from the bin"
        Add-Timeline "Recycle Bin: $($r.OriginalPath) deleted $when"
        $n++
    }
    if ($n -eq 0) { Write-OK "Recycle Bin: no cheat-named deleted files" }
    Write-SectionResult "Deleted Files"
}

# =====================================================
# BROWSER DOWNLOAD HISTORY  (NEW)
#
# Zone.Identifier only survives while the file does. Browser history records
# the download even after the file is deleted -- so this catches what
# provenance cannot.
#
# HONEST LIMIT: this is a raw string scan of the history database, not a
# SQLite parse (PowerShell 5.1 has no SQLite provider). It reliably finds URLs
# that are present, but it cannot tell you the download's status, whether it
# completed, or reconstruct the row. Treat a hit as "this URL appears in the
# browser's history store", which is why nothing here is Critical on its own.
# =====================================================
function Run-BrowserDownloadScan {
    Write-Header "BROWSER DOWNLOAD HISTORY"
    $dbs = [System.Collections.Generic.List[object]]::new()
    foreach ($prof in $allUserProfiles) {
        foreach ($rel in @(
            "AppData\Local\Google\Chrome\User Data\Default\History",
            "AppData\Local\Microsoft\Edge\User Data\Default\History",
            "AppData\Local\BraveSoftware\Brave-Browser\User Data\Default\History",
            "AppData\Roaming\Opera Software\Opera Stable\History"
        )) {
            $f = Join-Path $prof $rel
            if (Test-Path $f) { $dbs.Add([PSCustomObject]@{ Path=$f; Browser=($rel -split '\\')[2] }) | Out-Null }
        }
        $ffRoot = Join-Path $prof "AppData\Roaming\Mozilla\Firefox\Profiles"
        if (Test-Path $ffRoot) {
            foreach ($d in @(Get-ChildItem $ffRoot -Directory -ErrorAction SilentlyContinue)) {
                $f = Join-Path $d.FullName "places.sqlite"
                if (Test-Path $f) { $dbs.Add([PSCustomObject]@{ Path=$f; Browser="Firefox" }) | Out-Null }
            }
        }
    }
    if ($dbs.Count -eq 0) {
        Write-Skip "No browser history stores found -- NOT CHECKED"
        Mark-Skipped "Browser Downloads" "no Chrome/Edge/Brave/Opera/Firefox history store located"
        Write-SectionResult "Browser Downloads"
        return
    }

    $read = 0; $n = 0
    foreach ($db in $dbs) {
        $tmp = Join-Path $env:TEMP ("hist_" + [Guid]::NewGuid().ToString("N") + ".tmp")
        try {
            # the live DB is locked while the browser runs; copy first
            Copy-Item $db.Path $tmp -Force -ErrorAction Stop
            $bytes = [System.IO.File]::ReadAllBytes($tmp)
            $text  = [System.Text.Encoding]::ASCII.GetString($bytes).ToLower()
            $read++
            foreach ($d in $suspiciousDomains) {
                if (-not $text.Contains($d.ToLower())) { continue }
                Write-Amber "$($db.Browser) history references $d"
                Add-Finding -Section "Browser Downloads" -Type "BrowserHistoryDomain" `
                    -Detail "$($db.Browser): $d" -Value $d -Severity "Review" -Tier "A" `
                    -Evidence "raw string match in the history store -- confirms the URL is recorded, not that a download completed. Verify in the browser's own history UI."
                Add-Timeline "Browser history references $d"
                $n++
            }
        } catch {
            Write-Ctx "Could not read $($db.Browser) history (locked or denied): $($db.Path)"
        } finally {
            Remove-Item $tmp -Force -ErrorAction SilentlyContinue
        }
    }
    if ($read -eq 0) {
        Mark-Skipped "Browser Downloads" "all history stores were locked or unreadable"
        Write-Warn "No history store could be read -- this is NOT a clean result"
    } else {
        Mark-Ran "Browser Downloads" "$read of $($dbs.Count) history store(s) read"
        if ($n -eq 0) { Write-OK "No cheat-host references in browser history ($read store(s) read)" }
    }
    Write-SectionResult "Browser Downloads"
}

# =====================================================
# SUMMARY -- replaces the numeric scores entirely
#
# v4.4 averaged 15 category scores. That meant one confirmed BYOVD driver
# produced (14*100 + 20)/15 = 94.7 -> "No cheat evidence found", while pure
# noise across six categories produced 59 -> "Suspicious". The mean inverted
# the severity it was supposed to communicate. It is gone.
# =====================================================
function Get-Verdict {
    $crit = 0; $rev = 0; $ctx = 0; $skip = 0
    foreach ($s in $script:Sections.Values) {
        if (-not $s.Ran) { $skip++; continue }
        $crit += $s.Critical; $rev += $s.Review; $ctx += $s.Context
    }
    $line = if ($crit -gt 0) { "CONFIRMED INDICATORS: $crit" }
            elseif ($rev -gt 0) { "NEEDS REVIEW: $rev item(s)" }
            else { "NO INDICATORS FOUND" }
    $state = if ($crit -gt 0) { "Critical" } elseif ($rev -gt 0) { "Review" } else { "Clear" }
    return [PSCustomObject]@{
        Line = $line; State = $state
        Critical = $crit; Review = $rev; Context = $ctx; Skipped = $skip
    }
}

function Show-Summary {
    Write-Header "SUMMARY" "Magenta"
    $v = Get-Verdict

    Write-Host ""
    Write-Host "  +---------------------------------------------------------+" -ForegroundColor Cyan
    Write-Host "  |  $($v.Line)" -ForegroundColor (Get-StateColor $v.State)
    # This line prints unconditionally. Absence of a warning is not evidence of
    # coverage, and a reader must never infer "checked" from silence.
    Write-Host "  |  NOT CHECKED: $($v.Skipped) section(s)" -ForegroundColor $(if ($v.Skipped -gt 0) { "DarkGray" } else { "Green" })
    Write-Host "  +---------------------------------------------------------+" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "  Note: 'NO INDICATORS FOUND' is not the same as 'clean'." -ForegroundColor DarkGray
    Write-Host "        Coverage is partial. See the per-section coverage notes." -ForegroundColor DarkGray
    Write-Host ""

    foreach ($s in $script:Sections.Values) {
        $state = Get-SectionState $s
        $col   = Get-StateColor $state
        $label = switch ($state) {
            "Critical"  { "CRITICAL " }
            "Review"    { "REVIEW   " }
            "Clear"     { "CLEAR    " }
            default     { "NOT CHECK" }
        }
        $detail = switch ($state) {
            "Critical" { "$($s.Critical) confirmed, $($s.Review) review" }
            "Review"   { "$($s.Review) item(s)" }
            "Clear"    { $s.Coverage }
            default    { $s.Reason }
        }
        Write-Host ("    [{0}] {1,-26} {2}" -f $label, $s.Name, $detail) -ForegroundColor $col
    }
    Write-Host ""
    if ($script:ProcSetChanged) {
        Write-Host "  WARNING: the Roblox process set changed during this scan." -ForegroundColor Yellow
        Write-Host "           Sections do not all describe the same process instance." -ForegroundColor Yellow
        Write-Host ""
    }
    Write-Host "  Findings recorded : $($findings.Count)  (context/unscored: $($v.Context))" -ForegroundColor DarkGray
    Write-Host "  Suppressed as FP  : $($suppressed.Count)" -ForegroundColor DarkGray
    Write-Host ""
    Pause-Step "  Press ENTER to continue"
    return $v
}

# =====================================================
# HTML REPORT
# =====================================================
function Generate-Report($verdict, $scannerHash) {
    Write-Header "GENERATING HTML REPORT"
    $dur = [math]::Round(((Get-Date) - $startTime).TotalSeconds)

    function HtmlEnc($s) {
        if ($null -eq $s) { return "" }
        return $s.ToString().Replace("&","&amp;").Replace("<","&lt;").Replace(">","&gt;").Replace('"',"&quot;")
    }
    function SevClass($s) {
        switch ($s) {
            "Critical" { return "sev-crit" }
            "Review"   { return "sev-rev" }
            "Context"  { return "sev-ctx" }
            default    { return "sev-info" }
        }
    }

    $statusRows = ""
    foreach ($s in $script:Sections.Values) {
        $state = Get-SectionState $s
        $cls = switch ($state) { "Critical" {"st-crit"} "Review" {"st-rev"} "Clear" {"st-clear"} default {"st-skip"} }
        $note = switch ($state) {
            "Critical" { "$($s.Critical) confirmed, $($s.Review) review" }
            "Review"   { "$($s.Review) item(s) need a human" }
            "Clear"    { if ($s.Coverage) { $s.Coverage } else { "nothing found" } }
            default    { "NOT CHECKED -- $($s.Reason)" }
        }
        $statusRows += "<tr class='$cls'><td>$(HtmlEnc $s.Name)</td><td class='stcell'>$state</td><td>$(HtmlEnc $note)</td></tr>`n"
    }

    $scored  = @($findings | Where-Object { $_.Severity -in @("Critical","Review") })
    $context = @($findings | Where-Object { $_.Severity -in @("Context","Info") })

    $findRows = ""
    foreach ($f in ($scored | Sort-Object @{E={ switch ($_.Severity) { "Critical" {0} "Review" {1} default {2} } }}, Section)) {
        $tier = if ($f.Tier) { " <span class='tier'>Tier $($f.Tier)</span>" } else { "" }
        $findRows += "<tr class='$(SevClass $f.Severity)'><td>$($f.Severity)$tier</td><td>$(HtmlEnc $f.Section)</td><td>$(HtmlEnc $f.Type)</td><td>$(HtmlEnc $f.Detail)</td><td>$(HtmlEnc $f.Value)</td><td class='ev'>$(HtmlEnc $f.Evidence)</td></tr>`n"
    }
    $ctxRows = ""
    foreach ($f in $context) {
        $tier = if ($f.Tier) { " <span class='tier'>Tier $($f.Tier)</span>" } else { "" }
        $ctxRows += "<tr class='sev-ctx'><td>$($f.Severity)$tier</td><td>$(HtmlEnc $f.Section)</td><td>$(HtmlEnc $f.Type)</td><td>$(HtmlEnc $f.Detail)</td><td>$(HtmlEnc $f.Value)</td><td class='ev'>$(HtmlEnc $f.Evidence)</td></tr>`n"
    }

    $modRows = ""; foreach ($m in $moduleFindings) { $modRows += "<tr class='$(SevClass $m.Severity)'><td>$(HtmlEnc $m.Process)</td><td>$(HtmlEnc $m.PID)</td><td>$(HtmlEnc $m.Module)</td><td>$(HtmlEnc $m.Signer)</td><td>$(HtmlEnc $m.Status)</td></tr>`n" }
    $provRows = ""; foreach ($p in $provenanceFindings) { $provRows += "<tr class='$(SevClass $p.Severity)'><td>$(HtmlEnc $p.File)</td><td>$(HtmlEnc $p.HostUrl)</td><td>$(HtmlEnc $p.Referrer)</td><td>$(HtmlEnc $p.Match)</td></tr>`n" }
    $memRows = ""; foreach ($m in $memoryFindings) { $memRows += "<tr class='sev-crit'><td>$(HtmlEnc $m.String)</td><td>$(HtmlEnc $m.Address)</td><td>$(HtmlEnc $m.Region)</td></tr>`n" }
    $chatRows = ""; foreach ($m in $suspiciousMemFindings) { $chatRows += "<tr class='sev-ctx'><td>$(HtmlEnc $m.String)</td><td>$(HtmlEnc $m.Address)</td><td>$(HtmlEnc $m.Region)</td></tr>`n" }
    $thrRows = ""; foreach ($t in $threadFindings) { $thrRows += "<tr class='sev-crit'><td>$(HtmlEnc $t.PID)</td><td>$(HtmlEnc $t.Name)</td><td>$(HtmlEnc $t.ThreadID)</td><td>$(HtmlEnc $t.StartAddr)</td><td>$(HtmlEnc $t.Protection)</td></tr>`n" }
    $hndRows = ""; foreach ($h in $handleFindings) { $hndRows += "<tr><td>$(HtmlEnc $h.OwnerPID)</td><td>$(HtmlEnc $h.OwnerName)</td><td>$(HtmlEnc $h.Access)</td><td>$(HtmlEnc $h.VMWrite)</td><td>$(HtmlEnc $h.OwnerPath)</td></tr>`n" }
    $krnRows = ""; foreach ($k in $kernelFindings) { $krnRows += "<tr class='$(SevClass $k.Severity)'><td>$(HtmlEnc $k.Name)</td><td>$(HtmlEnc $k.File)</td><td>$(HtmlEnc $k.Time)</td><td>$(HtmlEnc $k.Note)</td></tr>`n" }
    $lchRows = ""; foreach ($l in $launchChainFindings) { $lchRows += "<tr class='$(SevClass $l.Severity)'><td>$(HtmlEnc $l.RobloxProcess)</td><td>$(HtmlEnc $l.ParentName)</td><td>$(HtmlEnc $l.ParentPath)</td><td>$(HtmlEnc $l.Note)</td></tr>`n" }
    $dltRows = ""; foreach ($d in $deltaFindings) { $dltRows += "<tr class='$(SevClass $d.Severity)'><td>$(HtmlEnc $d.Category)</td><td>$(HtmlEnc $d.Change)</td><td>$(HtmlEnc $d.Entry)</td><td>$(HtmlEnc $d.Note)</td></tr>`n" }
    $tlRows  = ""; foreach ($t in ($timeline | Sort-Object Time)) { $tlRows += "<tr><td>$(HtmlEnc $t.Time)</td><td>$(HtmlEnc $t.TimeUtc)</td><td>$(HtmlEnc $t.Event)</td></tr>`n" }
    $fpRows  = ""; foreach ($f in $suppressed) { $fpRows += "<tr class='sev-ctx'><td>$(HtmlEnc $f.Type)</td><td>$(HtmlEnc $f.Detail)</td><td>$(HtmlEnc $f.Reason)</td></tr>`n" }

    $verdictClass = switch ($verdict.State) { "Critical" {"st-crit"} "Review" {"st-rev"} default {"st-clear"} }
    $skipClass    = if ($verdict.Skipped -gt 0) { "st-skip" } else { "st-clear" }

    $html = @"
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Roblox Cheat Scanner v4.7 -- $env:COMPUTERNAME</title>
<style>
  :root{--bg:#0a0a0f;--bg3:#161b27;--accent:#00d4ff;--red:#ff3d3d;--amber:#ffd700;--green:#00ff88;--grey:#7a8190;--text:#e8e8e8;--muted:#666;--border:#1e2435}
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:Consolas,'Courier New',monospace;padding:24px;line-height:1.6;font-size:13px}
  h1{color:var(--accent);border-bottom:1px solid var(--accent);padding-bottom:8px;margin-bottom:16px;font-size:1.4em}
  h2{color:var(--accent);margin:26px 0 8px;border-left:3px solid var(--accent);padding-left:10px;text-transform:uppercase;font-size:.95em}
  .verdict{border:2px solid var(--border);border-radius:6px;padding:18px;margin:14px 0;background:var(--bg3)}
  .verdict .big{font-size:1.5em;font-weight:bold;letter-spacing:1px}
  .verdict .sub{font-size:1.05em;margin-top:6px}
  .caveat{color:var(--muted);font-size:.85em;margin-top:10px;line-height:1.5}
  .st-crit .stcell,.verdict.st-crit .big{color:var(--red)}
  .st-rev  .stcell,.verdict.st-rev  .big{color:var(--amber)}
  .st-clear .stcell,.verdict.st-clear .big{color:var(--green)}
  .st-skip .stcell{color:var(--grey)}
  .skipline.st-skip{color:var(--grey)} .skipline.st-clear{color:var(--green)}
  .meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:8px;margin:12px 0}
  .card{background:var(--bg3);border:1px solid var(--border);border-radius:4px;padding:10px}
  .card .label{color:var(--muted);font-size:.72em;text-transform:uppercase}
  .card .value{font-size:1em;font-weight:bold;margin-top:3px;word-break:break-all}
  table{border-collapse:collapse;width:100%;margin:6px 0 14px;font-size:.82em}
  th{background:var(--bg3);color:var(--accent);padding:6px 9px;text-align:left;border-bottom:1px solid var(--border)}
  td{padding:4px 9px;border-bottom:1px solid var(--border);word-break:break-word;vertical-align:top}
  .sev-crit td:first-child{color:var(--red);font-weight:bold}
  .sev-rev  td:first-child{color:var(--amber);font-weight:bold}
  .sev-ctx  td{color:var(--grey)}
  .tier{font-size:.85em;opacity:.75}
  .ev{color:var(--muted);font-size:.92em}
  details{margin:8px 0}
  summary{cursor:pointer;color:var(--accent);padding:6px 0}
  footer{margin-top:30px;color:var(--muted);font-size:.75em;border-top:1px solid var(--border);padding-top:10px;line-height:1.6}
</style>
</head>
<body>
<h1>ROBLOX CHEAT SCANNER v4.7 -- PROPERTY OF JD</h1>

<div class="verdict $verdictClass">
  <div class="big">$(HtmlEnc $verdict.Line)</div>
  <div class="sub skipline $skipClass">NOT CHECKED: $($verdict.Skipped) section(s)</div>
  <div class="caveat">
    "NO INDICATORS FOUND" is not the same as "clean". This scan covers a partial
    slice of the machine; per-section coverage is listed below, and any section
    marked NOT CHECKED produced no data at all.<br>
    Tier B (dual-use) and Tier C (fragment) matches are recorded but never
    escalate on their own. Presence artifacts (Shimcache, MUICache, AmCache)
    show that a file existed or was displayed -- they do not prove it ran.
  </div>
</div>

<div class="meta">
  <div class="card"><div class="label">Computer</div><div class="value">$(HtmlEnc $env:COMPUTERNAME)</div></div>
  <div class="card"><div class="label">User</div><div class="value">$(HtmlEnc $env:USERNAME)</div></div>
  <div class="card"><div class="label">Local time</div><div class="value">$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') (UTC$tzOffset)</div></div>
  <div class="card"><div class="label">UTC time</div><div class="value">$($startTimeUtc.ToString('yyyy-MM-dd HH:mm:ss'))</div></div>
  <div class="card"><div class="label">Duration</div><div class="value">${dur}s</div></div>
  <div class="card"><div class="label">Time range</div><div class="value">$(if ($script:ScanDaysBack -ge 9999) { 'all time' } else { "last $($script:ScanDaysBack) day(s)" })</div></div>
  <div class="card"><div class="label">Volume serial</div><div class="value">$(HtmlEnc $script:VolumeSerial)</div></div>
  <div class="card"><div class="label">Scanner build</div><div class="value">$(HtmlEnc $scannerHash)</div></div>
</div>

<h2>Section status</h2>
<table><tr><th>Section</th><th>Status</th><th>Note</th></tr>$statusRows</table>

<h2>Findings that need attention ($($scored.Count))</h2>
<table><tr><th>Severity</th><th>Section</th><th>Type</th><th>Detail</th><th>Match</th><th>Evidence / caveat</th></tr>$findRows</table>

<details><summary>Context items, not scored ($($context.Count)) -- click to expand</summary>
<table><tr><th>Severity</th><th>Section</th><th>Type</th><th>Detail</th><th>Match</th><th>Evidence</th></tr>$ctxRows</table>
</details>

<h2>Loaded modules flagged</h2>
<table><tr><th>Process</th><th>PID</th><th>Module</th><th>Signer</th><th>Sig status</th></tr>$modRows</table>

<h2>Download provenance (Zone.Identifier)</h2>
<table><tr><th>File</th><th>Host URL</th><th>Referrer</th><th>Match</th></tr>$provRows</table>

<h2>Memory -- cheat-only strings</h2>
<table><tr><th>String</th><th>Address</th><th>Region</th></tr>$memRows</table>

<details><summary>Memory -- chat-reachable strings (context only)</summary>
<table><tr><th>String</th><th>Address</th><th>Region</th></tr>$chatRows</table>
</details>

<h2>Threads starting in private executable memory</h2>
<table><tr><th>PID</th><th>Process</th><th>TID</th><th>Start</th><th>Protection</th></tr>$thrRows</table>

<h2>Processes holding a Roblox handle</h2>
<table><tr><th>Owner PID</th><th>Owner</th><th>Access</th><th>VM Write</th><th>Path</th></tr>$hndRows</table>

<h2>Kernel drivers</h2>
<table><tr><th>Name</th><th>File</th><th>Time</th><th>Note</th></tr>$krnRows</table>

<h2>Launch chain</h2>
<table><tr><th>Process</th><th>Parent</th><th>Path</th><th>Note</th></tr>$lchRows</table>

<h2>Snapshot delta</h2>
<table><tr><th>Category</th><th>Change</th><th>Entry</th><th>Note</th></tr>$dltRows</table>

<h2>Timeline</h2>
<table><tr><th>Local</th><th>UTC</th><th>Event</th></tr>$tlRows</table>

<details><summary>Suppressed as false positives ($($suppressed.Count))</summary>
<table><tr><th>Type</th><th>Detail</th><th>Reason</th></tr>$fpRows</table>
</details>

<footer>
Roblox Cheat Scanner v4.7 | $(HtmlEnc $env:COMPUTERNAME) | $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') local / $($startTimeUtc.ToString('yyyy-MM-dd HH:mm:ss')) UTC<br>
This report is plain HTML and is NOT tamper-evident. It can be edited by anyone
with access to the machine. Verify the report hash out of band before relying
on it in any decision.<br>
Scanner build (SHA256 of the .ps1 that produced this report): $(HtmlEnc $scannerHash)
</footer>
</body></html>
"@
    try {
        $html | Out-File $reportPath -Encoding UTF8 -Force
        $reportHash = Get-FileSha256 $reportPath
        Write-OK "Report saved: $reportPath"
        Write-Host ""
        Write-Host "  REPORT SHA256: $reportHash" -ForegroundColor Cyan
        Write-Host "  Record this hash separately. The HTML itself is editable." -ForegroundColor DarkGray
        return $reportPath
    } catch {
        Write-Fail "Could not save report: $($_.Exception.Message)"
        return $null
    }
}

# =====================================================
# GUI VIEWERS
# =====================================================
function New-DarkForm($title) {
    $form = New-Object System.Windows.Forms.Form
    $form.Text = "$title | ENTER to close"
    $form.WindowState = 'Maximized'
    $form.BackColor = [System.Drawing.Color]::FromArgb(13,13,18)
    $form.ControlBox = $false
    return $form
}
function New-CloseBar($text) {
    $bar = New-Object System.Windows.Forms.Label
    $bar.Dock = 'Bottom'; $bar.Height = 28
    $bar.Text = "  ENTER to close  |  $text"
    $bar.ForeColor = [System.Drawing.Color]::FromArgb(0,212,255)
    $bar.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
    $bar.Font = New-Object System.Drawing.Font("Consolas",9)
    $bar.TextAlign = 'MiddleLeft'
    return $bar
}
function New-DarkListView($cols) {
    $lv = New-Object System.Windows.Forms.ListView
    $lv.View='Details'; $lv.FullRowSelect=$true; $lv.GridLines=$true; $lv.Dock='Fill'
    $lv.Scrollable = $true
    $lv.HideSelection = $false
    $lv.Font = New-Object System.Drawing.Font("Consolas",9)
    $lv.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
    $lv.ForeColor = [System.Drawing.Color]::FromArgb(224,224,224)
    foreach ($c in $cols) { [void]$lv.Columns.Add($c[0],$c[1]) }
    return $lv
}
function Set-RowSeverity($item, $sev) {
    switch ($sev) {
        "Critical" { $item.BackColor = [System.Drawing.Color]::FromArgb(60,0,0);  $item.ForeColor = [System.Drawing.Color]::FromArgb(255,80,80) }
        "Review"   { $item.ForeColor = [System.Drawing.Color]::FromArgb(255,215,0) }
        "Clear"    { $item.ForeColor = [System.Drawing.Color]::FromArgb(0,255,136) }
        default    { $item.ForeColor = [System.Drawing.Color]::FromArgb(140,146,160) }
    }
}
function Add-EmptyRow($lv, $msg, $sev = "Clear") {
    $it = New-Object System.Windows.Forms.ListViewItem($(if ($sev -eq "Clear") { "Clear" } else { "Not checked" }))
    Set-RowSeverity $it $sev
    [void]$it.SubItems.Add($msg)
    [void]$lv.Items.Add($it)
}
function New-DetailPane {
    $tb = New-Object System.Windows.Forms.TextBox
    $tb.Multiline   = $true
    $tb.ReadOnly    = $true
    $tb.Dock        = 'Bottom'
    $tb.Height      = 130
    $tb.ScrollBars  = 'Vertical'
    $tb.WordWrap    = $true
    $tb.Font        = New-Object System.Drawing.Font("Consolas",9)
    $tb.BackColor   = [System.Drawing.Color]::FromArgb(22,27,39)
    $tb.ForeColor   = [System.Drawing.Color]::FromArgb(224,224,224)
    $tb.BorderStyle = 'FixedSingle'
    $tb.Text        = "Select a row to read every column in full here (including Evidence, which is cut off in the grid above)."
    return $tb
}

function Wire-Detail($lv, $tb) {
    $lv.Add_SelectedIndexChanged({
        if ($lv.SelectedItems.Count -eq 0) { return }
        $it = $lv.SelectedItems[0]
        $sb = New-Object System.Text.StringBuilder
        for ($i = 0; $i -lt $lv.Columns.Count; $i++) {
            $hdr = $lv.Columns[$i].Text
            $val = if ($i -lt $it.SubItems.Count) { $it.SubItems[$i].Text } else { "" }
            [void]$sb.AppendLine(("{0,-16}: {1}" -f $hdr, $val))
        }
        $tb.Text = $sb.ToString()
    }.GetNewClosure())
    # Ctrl+C copies the selected row, so a long Evidence string can leave the GUI
    $lv.Add_KeyDown({
        param($sender,$e)
        if ($e.Control -and $e.KeyCode -eq [System.Windows.Forms.Keys]::C -and $tb.Text) {
            [System.Windows.Forms.Clipboard]::SetText($tb.Text)
        }
    }.GetNewClosure())
}

function Show-FinalForm($form) {
    $form.KeyPreview = $true
    $form.Add_KeyDown({ param($s,$e); if ($e.KeyCode -eq [System.Windows.Forms.Keys]::Enter) { $form.Close() } })
    [void]$form.ShowDialog()
}

# Single overview viewer -- replaces v4.4's six sequential modal dialogs.
function Show-OverviewGui($verdict) {
    $form = New-DarkForm "Scan Overview -- $($verdict.Line)"
    $form.Controls.Add((New-CloseBar "Red=confirmed  Amber=review  Grey=not checked/context  |  Columns run off the right: use the horizontal scrollbar or arrow keys, or click a row to read it in full below.  Ctrl+C copies the selected row."))
    $tab = New-Object System.Windows.Forms.TabControl
    $tab.Dock='Fill'; $tab.Font = New-Object System.Drawing.Font("Consolas",9)

    function New-Tab($name) {
        $tp = New-Object System.Windows.Forms.TabPage($name)
        $tp.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
        $tp.ForeColor = [System.Drawing.Color]::FromArgb(0,212,255)
        return $tp
    }

    # --- Status
    $tp = New-Tab "Status"
    $lv = New-DarkListView @(("Section",240),("Status",120),("Note",760))
    foreach ($s in $script:Sections.Values) {
        $state = Get-SectionState $s
        $it = New-Object System.Windows.Forms.ListViewItem([string]$s.Name)
        [void]$it.SubItems.Add($state)
        $note = switch ($state) {
            "Critical" { "$($s.Critical) confirmed, $($s.Review) review" }
            "Review"   { "$($s.Review) item(s)" }
            "Clear"    { $s.Coverage }
            default    { "NOT CHECKED -- $($s.Reason)" }
        }
        [void]$it.SubItems.Add([string]$note)
        Set-RowSeverity $it $(if ($state -eq "Clear") { "Clear" } elseif ($state -eq "Unchecked") { "Context" } else { $state })
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Findings
    $scored = @($findings | Where-Object { $_.Severity -in @("Critical","Review") })
    $tp = New-Tab "Findings ($($scored.Count))"
    $lv = New-DarkListView @(("Severity",90),("Tier",50),("Section",180),("Type",180),("Detail",520),("Evidence",380))
    if ($scored.Count -eq 0) { Add-EmptyRow $lv "No scored findings" }
    foreach ($f in ($scored | Sort-Object @{E={ if ($_.Severity -eq 'Critical') {0} else {1} }})) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$f.Severity)
        [void]$it.SubItems.Add([string]$f.Tier)
        [void]$it.SubItems.Add([string]$f.Section)
        [void]$it.SubItems.Add([string]$f.Type)
        [void]$it.SubItems.Add([string]$f.Detail)
        [void]$it.SubItems.Add([string]$f.Evidence)
        Set-RowSeverity $it $f.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Modules
    $tp = New-Tab "Modules ($($moduleFindings.Count))"
    $lv = New-DarkListView @(("Process",160),("PID",70),("Module",600),("Signer",380),("Status",120))
    if ($moduleFindings.Count -eq 0) {
        if ($script:Sections["Loaded Modules"].Ran) { Add-EmptyRow $lv "All modules Roblox/Microsoft-signed or OS-resident" }
        else { Add-EmptyRow $lv $script:Sections["Loaded Modules"].Reason "Context" }
    }
    foreach ($m in $moduleFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$m.Process)
        [void]$it.SubItems.Add([string]$m.PID); [void]$it.SubItems.Add([string]$m.Module)
        [void]$it.SubItems.Add([string]$m.Signer); [void]$it.SubItems.Add([string]$m.Status)
        Set-RowSeverity $it $m.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Provenance
    $tp = New-Tab "Downloads ($($provenanceFindings.Count))"
    $lv = New-DarkListView @(("File",520),("Host URL",520),("Referrer",380),("Match",140))
    if ($provenanceFindings.Count -eq 0) { Add-EmptyRow $lv "No files with a recorded download origin" }
    foreach ($p in $provenanceFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$p.File)
        [void]$it.SubItems.Add([string]$p.HostUrl); [void]$it.SubItems.Add([string]$p.Referrer); [void]$it.SubItems.Add([string]$p.Match)
        Set-RowSeverity $it $p.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Memory / threads / handles / pipes
    $tp = New-Tab "Memory"
    $lv = New-DarkListView @(("Kind",120),("Detail",420),("Address / info",300),("Region",260))
    if ($memoryFindings.Count -eq 0 -and $threadFindings.Count -eq 0 -and $hollowFindings.Count -eq 0 -and $handleFindings.Count -eq 0 -and $pipeFindings.Count -eq 0) {
        if ($script:Sections["Process Memory"].Ran) { Add-EmptyRow $lv $script:Sections["Process Memory"].Coverage }
        else { Add-EmptyRow $lv $script:Sections["Process Memory"].Reason "Context" }
    }
    foreach ($m in $memoryFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("String");  [void]$it.SubItems.Add([string]$m.String); [void]$it.SubItems.Add([string]$m.Address); [void]$it.SubItems.Add([string]$m.Region); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($t in $threadFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Thread");  [void]$it.SubItems.Add("TID $($t.ThreadID) in $($t.Name)"); [void]$it.SubItems.Add([string]$t.StartAddr); [void]$it.SubItems.Add([string]$t.Protection); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($h in $hollowFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Hollow");  [void]$it.SubItems.Add("$($h.Name) PID $($h.PID)"); [void]$it.SubItems.Add([string]$h.Path); [void]$it.SubItems.Add([string]$h.Note); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($h in $handleFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Handle");  [void]$it.SubItems.Add("$($h.OwnerName) PID $($h.OwnerPID)"); [void]$it.SubItems.Add([string]$h.Access); [void]$it.SubItems.Add([string]$h.OwnerPath); Set-RowSeverity $it $(if ($h.CheatMatch -or $h.VMWrite) { "Critical" } else { "Review" }); [void]$lv.Items.Add($it) }
    foreach ($p in $pipeFindings)          { $it = New-Object System.Windows.Forms.ListViewItem("Pipe");    [void]$it.SubItems.Add([string]$p.PipeName); [void]$it.SubItems.Add([string]$p.Match); [void]$it.SubItems.Add([string]$p.Tier); Set-RowSeverity $it $(if ($p.Tier -eq "A") { "Critical" } else { "Review" }); [void]$lv.Items.Add($it) }
    foreach ($m in $suspiciousMemFindings) { $it = New-Object System.Windows.Forms.ListViewItem("Chat str"); [void]$it.SubItems.Add([string]$m.String); [void]$it.SubItems.Add([string]$m.Address); [void]$it.SubItems.Add("context only"); Set-RowSeverity $it "Context"; [void]$lv.Items.Add($it) }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Prefetch
    $tp = New-Tab "Prefetch ($($prefetchViewerData.Count))"
    $lv = New-DarkListView @(("Exe",240),("Last run",170),("Runs",60),("Parsed",70),("Tier",50),("Match",140),("All run times",520))
    foreach ($r in ($prefetchViewerData | Sort-Object LastRun -Descending)) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$r.Exe)
        [void]$it.SubItems.Add([string]$r.LastRun); [void]$it.SubItems.Add([string]$r.RunCount)
        [void]$it.SubItems.Add($(if ($r.Parsed) { "yes" } else { "NO" }))
        [void]$it.SubItems.Add([string]$r.Tier); [void]$it.SubItems.Add([string]$r.Match)
        [void]$it.SubItems.Add([string]$r.AllRunTimes)
        $sev = if ($r.Tier -eq "A") { "Critical" } elseif ($r.Tier -eq "B") { "Review" } elseif ($r.Match) { "Context" } else { "Clear" }
        Set-RowSeverity $it $sev
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- BAM
    $tp = New-Tab "BAM ($($bamViewerData.Count))"
    $lv = New-DarkListView @(("Last run",170),("Path",700),("Tier",50),("Match",160))
    foreach ($r in ($bamViewerData | Sort-Object LastRun -Descending)) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$r.LastRun)
        [void]$it.SubItems.Add([string]$r.Path); [void]$it.SubItems.Add([string]$r.Tier); [void]$it.SubItems.Add([string]$r.Match)
        Set-RowSeverity $it $(if ($r.Tier -eq "A") { "Critical" } elseif ($r.Tier -eq "B") { "Review" } else { "Clear" })
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Delta
    $tp = New-Tab "Delta ($($deltaFindings.Count))"
    $lv = New-DarkListView @(("Category",140),("Change",120),("Entry",620),("Note",420))
    if ($deltaFindings.Count -eq 0) { Add-EmptyRow $lv "No baseline comparison performed" "Context" }
    foreach ($d in $deltaFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$d.Category)
        [void]$it.SubItems.Add([string]$d.Change); [void]$it.SubItems.Add([string]$d.Entry); [void]$it.SubItems.Add([string]$d.Note)
        Set-RowSeverity $it $d.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Suppressed
    $tp = New-Tab "Suppressed ($($suppressed.Count))"
    $lv = New-DarkListView @(("Type",180),("Detail",760),("Reason",460))
    if ($suppressed.Count -eq 0) { Add-EmptyRow $lv "Nothing suppressed" }
    foreach ($f in $suppressed) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$f.Type)
        [void]$it.SubItems.Add([string]$f.Detail); [void]$it.SubItems.Add([string]$f.Reason)
        Set-RowSeverity $it "Context"
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    $form.Controls.Add($tab)
    Show-FinalForm $form
}

# =====================================================
# MAIN
# =====================================================
Write-Banner
Select-TimeRange

$scannerHash = if ($PSCommandPath) { Get-FileSha256 $PSCommandPath }
               else { "UNAVAILABLE -- script was pasted into the console, not run from a file" }
$script:VolumeSerial = ""
try { $script:VolumeSerial = (Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'" -ErrorAction Stop).VolumeSerialNumber } catch {}

if (-not $Unattended) {
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host "  |  FIRST SCAN : Roblox CLOSED  -- saves baseline snapshot   |" -ForegroundColor Yellow
    Write-Host "  |  SECOND SCAN: Roblox OPEN, in a game, 1-3 min, run again  |" -ForegroundColor Yellow
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host ""
}
if ($PSCommandPath) {
    Write-Info "Scanner build  : $scannerHash"
} else {
    Write-Warn "Scanner build  : UNAVAILABLE -- run the .ps1 from disk, not pasted into the console."
    Write-Warn "                 This report will not identify which build produced it."
}
Write-Info "Volume serial  : $script:VolumeSerial"
Write-Host ""

$robloxRunning = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $robloxProcessNames -contains $_.ProcessName })
$script:RobloxBaselinePids = @($robloxRunning | Select-Object -ExpandProperty Id | Sort-Object)
if ($robloxRunning.Count -gt 0) {
    Write-OK "Roblox running: $(($robloxRunning | ForEach-Object { "$($_.ProcessName) PID $($_.Id)" }) -join ', ')"
} else {
    Write-Warn "Roblox NOT running -- module, memory, handle, pipe and launch-chain sections will report NOT CHECKED"
}
Write-Host ""

$previousSnapshot = Load-PreviousSnapshot
$runDelta = $false
if ($previousSnapshot) {
    Write-Info "Previous snapshot: $($previousSnapshot.Timestamp)"
    if ($Unattended) { $runDelta = $true }
    else {
        $resp = Read-Host "  Compare against previous scan? (Y/N)"
        if ($resp -match '^[Yy]') { $runDelta = $true }
        else { Mark-Skipped "Snapshot Delta" "operator declined the baseline comparison at the prompt" }
    }
} else {
    Write-Info "No previous snapshot -- this run is the baseline"
    Mark-Skipped "Snapshot Delta" "no previous snapshot to compare against"
    Pause-Step "  Press ENTER to begin"
}
Write-Host ""

Write-Info "Taking snapshot..."
$currentSnapshot = Get-CurrentSnapshot
Write-OK "Snapshot: BAM=$($currentSnapshot.BAM.Count) MUI=$($currentSnapshot.MUICache.Count) UA=$($currentSnapshot.UserAssist.Count) Shim=$($currentSnapshot.Shimcache.Count) PF=$($currentSnapshot.Prefetch.Count)"
Pause-Step "  Press ENTER to begin the scan"

Run-Section1
Run-Section2
Run-Section3
Run-Section4
Run-Section5
Run-Section6
Run-Section7
Run-RobloxClientIntegrity
Run-ModuleScan
Run-MemoryScan
Run-KernelDriverScan
Run-LaunchChainScan
Scan-RobloxLogs
Run-ProvenanceScan
Run-RenamedBinaryScan
Run-PANScan
Run-RecentFilesScan
Run-RecycleBinScan
Run-BrowserDownloadScan
Run-CrashArtifactScan
Run-HashBlocklistScan
Run-AmCacheScan

if ($runDelta -and $previousSnapshot) { Compare-Snapshots $previousSnapshot $currentSnapshot }

$snapHash = Save-Snapshot $currentSnapshot
if ($snapHash) { Write-OK "Snapshot saved: $snapshotPath (sha256 $snapHash)" }
else { Write-Warn "Could not save snapshot" }
Write-Host ""
Write-Host "  NOTE: the baseline lives on this machine. Anyone with access to it" -ForegroundColor DarkGray
Write-Host "        can edit it between scans. Keep a copy of the hash elsewhere," -ForegroundColor DarkGray
Write-Host "        or hold the baseline off-machine with -BaselinePath." -ForegroundColor DarkGray
Write-Host ""

$verdict = Show-Summary
$reportFile = Generate-Report $verdict $scannerHash

if (-not $Unattended) {
    Pause-Step "  Press ENTER to open the overview viewer"
    Show-OverviewGui $verdict
}

Write-Host ""
Write-OK "Done. Report: $reportFile"
if ($verdict.Skipped -gt 0) {
    Write-Host "  $($verdict.Skipped) section(s) were NOT CHECKED. Read the status table before drawing a conclusion." -ForegroundColor DarkGray
}
