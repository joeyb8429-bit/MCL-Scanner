# Split a path into matchable tokens and DROP the user-profile prefix, so a
# username can never match a term. v4.4 substring-matched the whole path, which
# meant a user called "Isabelle" had every single artifact flagged.
function Get-MatchTokens($str) {
    if (-not $str) { return @() }
    $lower = $str.ToLower()
    $lower = $lower -replace '^\\device\\harddiskvolume\d+', ''
    $lower = $lower -replace '^\\\\\?\\', ''
    $parts = @($lower -split '[\\/]' | Where-Object { $_ -ne "" })
    if     ($parts.Count -ge 4 -and $parts[1] -eq 'users') { $parts = @($parts[3..($parts.Count-1)]) }
    elseif ($parts.Count -ge 3 -and $parts[0] -eq 'users') { $parts = @($parts[2..($parts.Count-1)]) }
    return $parts
}

function Test-TokenBoundary($token, $term) {
    return $token -match "(^|[^a-z0-9])$([regex]::Escape($term))([^a-z0-9]|`$)"
}

# Returns $null, or @{ Term; Tier; Match = 'Exact'|'Token' }
function Test-CheatMatch($str) {
    if (-not $str) { return $null }
    if (Is-GlobalFP $str) { return $null }

    $tokens = Get-MatchTokens $str
    if ($tokens.Count -eq 0) { return $null }

    $bases = [System.Collections.Generic.List[string]]::new()
    foreach ($t in $tokens) {
        $bases.Add($t) | Out-Null
        $b = try { [IO.Path]::GetFileNameWithoutExtension($t) } catch { $t }
        if ($b -and $b -ne $t) { $bases.Add($b) | Out-Null }
    }

    $best = $null
    foreach ($entry in $cheatTerms) {
        $term = $entry.T
        $tier = $entry.Tier
        foreach ($b in $bases) {
            if ($b -eq $term) {
                return @{ Term = $term; Tier = $tier; Match = "Exact" }
            }
        }
        # Tier B is EXACT ONLY. Token matching is for A and C.
        if ($tier -eq "B") { continue }
        if ($term.Length -lt 6) { continue }
        foreach ($b in $bases) {
            if (Test-TokenBoundary $b $term) {
                if ($tier -eq "A") { return @{ Term = $term; Tier = "A"; Match = "Token" } }
                if (-not $best)    { $best = @{ Term = $term; Tier = $tier; Match = "Token" } }
            }
        }
    }
    return $best
}

function Get-SeverityForMatch($m, $baseSeverity) {
