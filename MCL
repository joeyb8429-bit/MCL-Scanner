function Write-SectionResult($sectionName) {
    Write-Host ""
    if (-not $script:Sections.Contains($sectionName)) { Pause-Step; return }
    $sec   = $script:Sections[$sectionName]
    $state = Get-SectionState $sec
    $col   = Get-StateColor $state
    switch ($state) {
        "Unchecked" { Write-Host "  --- STATUS: NOT CHECKED -- $($sec.Reason)" -ForegroundColor $col }
        "Clear"     { Write-Host "  --- STATUS: CLEAR (nothing found)" -ForegroundColor $col }
        "Review"    { Write-Host "  --- STATUS: REVIEW -- $($sec.Review) item(s) need a human" -ForegroundColor $col }
        "Critical"  { Write-Host "  --- STATUS: CRITICAL -- $($sec.Critical) confirmed indicator(s)" -ForegroundColor $col }
    }
    if ($sec.Coverage) { Write-Host "      coverage: $($sec.Coverage)" -ForegroundColor DarkGray }
    if ($sec.Context -gt 0) { Write-Host "      ($($sec.Context) context item(s) recorded, not scored)" -ForegroundColor DarkGray }
    Write-Host ""
    Pause-Step
}

