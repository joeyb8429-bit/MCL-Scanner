# Signature results are cached: Get-AuthenticodeSignature can trigger CRL/OCSP
# network fetches, which is both slow and leaks from the subject's machine.
$script:SigCache = @{}
function Get-SigInfo($filePath) {
    if (-not $filePath) { return $null }
    if ($script:SigCache.ContainsKey($filePath)) { return $script:SigCache[$filePath] }
    $info = $null
    try {
        $sig = Get-AuthenticodeSignature $filePath -ErrorAction Stop
        $info = [PSCustomObject]@{
            Status  = $sig.Status.ToString()
            Subject = if ($sig.SignerCertificate) { $sig.SignerCertificate.Subject } else { "" }
            Thumb   = if ($sig.SignerCertificate) { $sig.SignerCertificate.Thumbprint } else { "" }
        }
    } catch {
        $info = [PSCustomObject]@{ Status = "Unreadable"; Subject = ""; Thumb = "" }
    }
    $script:SigCache[$filePath] = $info
    return $info
}

function Is-SignedByRoblox($filePath) {
    $info = Get-SigInfo $filePath
    if (-not $info -or $info.Status -ne "Valid") { return $false }
    foreach ($signer in $knownRobloxSigners) {
        if ($info.Subject -like "*$signer*") { return $true }
    }
    return $false
}

function Get-FileSha256($path) {
    try { return (Get-FileHash -Path $path -Algorithm SHA256 -ErrorAction Stop).Hash.ToUpper() }
    catch { return $null }
}

# ---- FIX (v4.5): v4.4 used $buf[0..($read-1)], which allocates an object[] of
# ---- up to 512K elements per file. Straight indexed loop instead.
function Get-FileEntropy($path) {
    try {
        $info = Get-Item $path -ErrorAction Stop
        if ($info.Length -lt 4096) { return -1.0 }
        $sample = [int][math]::Min([int64]$info.Length, 512KB)
        $fs   = [System.IO.File]::OpenRead($path)
        try {
            $buf  = New-Object byte[] $sample
            $read = $fs.Read($buf, 0, $sample)
        } finally { $fs.Dispose() }
        if ($read -lt 64) { return -1.0 }
        $freq = New-Object int[] 256
        for ($i = 0; $i -lt $read; $i++) { $freq[$buf[$i]]++ }
        $entropy = 0.0
        for ($i = 0; $i -lt 256; $i++) {
            $f = $freq[$i]
            if ($f -gt 0) {
                $p = $f / $read
                $entropy -= $p * [math]::Log($p, 2)
            }
        }
        return [math]::Round($entropy, 4)
    } catch { return -1.0 }
}

# ---- FIX (v4.5): v4.4 called ReadAllBytes() on every exe just to read the
# ---- first 64KB. A large file in Downloads could OOM the whole scan.
function Get-PEHeaderString($path, $bytesToRead = 65536) {
    try {
        $fs = [System.IO.File]::OpenRead($path)
        try {
            $len = [int][math]::Min([int64]$bytesToRead, $fs.Length)
            if ($len -lt 64) { return "" }
            $buf  = New-Object byte[] $len
            $read = $fs.Read($buf, 0, $len)
            if ($read -le 0) { return "" }
            return [System.Text.Encoding]::ASCII.GetString($buf, 0, $read)
        } finally { $fs.Dispose() }
    } catch { return "" }
}

# ---- FIX (v4.5): prefetch files on Win10/11 are MAM-compressed. v4.4 read the
# ---- MAM signature as a version number, fell through to the else branch, and
# ---- read garbage at offset 128 -- so RunCount was always 0 and LastRun was
# ---- silently falling back to the file's mtime.
function Get-PrefetchInfo($path) {
    $result = [PSCustomObject]@{ Times = @(); RunCount = 0; Parsed = $false }
    try {
        $raw = [System.IO.File]::ReadAllBytes($path)
        $bytes = [PfDecomp]::Decompress($raw)
        if (-not $bytes -or $bytes.Length -lt 136) { return $result }

        $version = [System.BitConverter]::ToUInt32($bytes, 0)
        # 23=WinVista/7, 26=Win8, 30=Win10, 31=Win11
        if ($version -notin @(17,23,26,30,31)) { return $result }

        $times = [System.Collections.Generic.List[DateTime]]::new()
        $slots = if ($version -ge 26) { 8 } else { 1 }
        $tsOffset = switch ($version) {
            17      { 0x78 }
            23      { 0x80 }
            26      { 0x80 }
            default { 0x80 }
        }
        for ($i = 0; $i -lt $slots; $i++) {
            $off = $tsOffset + ($i * 8)
            if ($off + 8 -gt $bytes.Length) { break }
            $ft = [System.BitConverter]::ToInt64($bytes, $off)
            if ($ft -gt 0 -and $ft -lt 999999999999999999L) {
                try { $times.Add([DateTime]::FromFileTimeUtc($ft).ToLocalTime()) } catch {}
            }
        }
        $rcOffset = switch ($version) { 17 { 0x90 } 23 { 0x98 } default { 0xD0 } }
        $runCount = 0
        if ($rcOffset + 4 -le $bytes.Length) {
            $runCount = [System.BitConverter]::ToInt32($bytes, $rcOffset)
            if ($runCount -lt 0 -or $runCount -gt 1000000) { $runCount = 0 }
        }
        $result.Times    = @($times | Sort-Object -Descending)
        $result.RunCount = $runCount
        $result.Parsed   = ($times.Count -gt 0)
    } catch {}
    return $result
}

# Roblox process set is captured once at scan start. If it changes mid-scan the
# sections are no longer describing the same process instance, and the report
# must say so rather than silently mixing them.
$script:RobloxBaselinePids = @()
$script:ProcSetChanged     = $false

function Get-RobloxProcs {
    $procs = @(Get-Process -ErrorAction SilentlyContinue |
               Where-Object { $robloxProcessNames -contains $_.ProcessName })
    $ids = @($procs | Select-Object -ExpandProperty Id | Sort-Object)
    if ($script:RobloxBaselinePids.Count -gt 0 -and -not $script:ProcSetChanged) {
        $a = ($script:RobloxBaselinePids -join ',')
        $b = ($ids -join ',')
        if ($a -ne $b) {
            $script:ProcSetChanged = $true
            Write-Warn "Roblox process set CHANGED mid-scan (was PIDs $a, now $b)"
            Write-Warn "  Sections before this point examined a different process instance."
            Add-Timeline "Roblox process set changed mid-scan: $a -> $b"
        }
    }
    return $procs
}

# 24-hour timestamps are hard to scan quickly in a GUI. Reports keep ISO
# format (sortable, unambiguous); the on-screen viewer uses 12-hour local.
$script:TzAbbr = ""
try {
    $tz = [System.TimeZoneInfo]::Local
    $isDst = $tz.IsDaylightSavingTime((Get-Date))
    $nm = if ($isDst) { $tz.DaylightName } else { $tz.StandardName }
    $script:TzAbbr = -join ($nm -split '\s+' | ForEach-Object { if ($_.Length -gt 0) { $_[0] } })
} catch { $script:TzAbbr = "" }

function Format-ViewTime($val) {
    if (-not $val) { return "" }
    $d = $null
    try { $d = [DateTime]::Parse([string]$val) } catch { return [string]$val }
    $out = $d.ToString("MMM dd, yyyy h:mm:ss tt")
    if ($script:TzAbbr) { $out = "$out $script:TzAbbr" }
    return $out
}

function Format-ViewTimeList($val) {
    if (-not $val) { return "" }
    return (([string]$val) -split '\s*\|\s*' | Where-Object { $_ } | ForEach-Object { Format-ViewTime $_ }) -join "  |  "
}

# ---- Time formatting -------------------------------------------------
# Reports were printing 24-hour local time with no zone, so a moderator in a
# different region could not line a finding up against a match recording.
$script:TzInfo = [System.TimeZoneInfo]::Local
$script:TzAbbr = ""
try {
    $tzName = if ($script:TzInfo.IsDaylightSavingTime((Get-Date))) { $script:TzInfo.DaylightName } else { $script:TzInfo.StandardName }
    $script:TzAbbr = -join (@($tzName -split '\s+') | ForEach-Object { if ($_.Length -gt 0) { $_[0] } })
} catch { $script:TzAbbr = "local" }
if (-not $script:TzAbbr) { $script:TzAbbr = "local" }

function Format-Stamp($dt) {
    if (-not $dt) { return "" }
    try { return "$($dt.ToString('MMM dd, yyyy h:mm:ss tt')) $script:TzAbbr" } catch { return [string]$dt }
}

# Re-format the "yyyy-MM-dd HH:mm:ss" strings held in the viewer collections.
function Format-StampStr($str) {
    if (-not $str) { return "" }
    $d = [datetime]::MinValue
    if ([datetime]::TryParseExact([string]$str, 'yyyy-MM-dd HH:mm:ss', $null, 'None', [ref]$d)) {
        return Format-Stamp $d
    }
    return [string]$str
}

function Get-RegionTypeName($type) {
    switch ($type) {
        0x1000000 { return "IMAGE" }    # backed by a file on disk
        0x40000   { return "MAPPED" }   # backed by a section object
        0x20000   { return "PRIVATE" }  # anonymous -- VirtualAlloc
        default   { return "UNKNOWN" }
    }
}

function Get-ProtectionName($protect) {
    switch ($protect -band 0xFF) {
        0x01 { return "NOACCESS" }
        0x02 { return "READONLY" }
        0x04 { return "READWRITE" }
        0x08 { return "WRITECOPY" }
        0x10 { return "EXECUTE" }
        0x20 { return "EXECUTE_READ" }
        0x40 { return "EXECUTE_READWRITE" }
        0x80 { return "EXECUTE_WRITECOPY" }
        default { return "UNKNOWN(0x$($protect.ToString('X')))" }
    }
}

function Search-MemoryRegion([byte[]]$buf, [int]$bytesRead) {
    $found = [System.Collections.Generic.List[object]]::new()
    if ($bytesRead -le 0) { return $found }
    $ascii = [System.Text.Encoding]::ASCII.GetString($buf, 0, $bytesRead).ToLower()
    $uni   = [System.Text.Encoding]::Unicode.GetString($buf, 0, $bytesRead).ToLower()
    # odd-offset UTF-16 strings are missed by a single decode at offset 0
    $uniOdd = if ($bytesRead -gt 2) { [System.Text.Encoding]::Unicode.GetString($buf, 1, $bytesRead - 1).ToLower() } else { "" }
    foreach ($sig in $memStringsHigh) {
        $sl = $sig.ToLower()
        if ($ascii.Contains($sl) -or $uni.Contains($sl) -or $uniOdd.Contains($sl)) {
            $found.Add(@{ S = $sig; Class = "High" }) | Out-Null
        }
    }
    foreach ($sig in $memStringsProduct) {
        $sl = $sig.ToLower()
        if ($ascii.Contains($sl) -or $uni.Contains($sl) -or $uniOdd.Contains($sl)) {
            $found.Add(@{ S = $sig; Class = "Product" }) | Out-Null
        }
    }
    foreach ($sig in $memStringsChat) {
        $sl = $sig.ToLower()
        if ($ascii.Contains($sl) -or $uni.Contains($sl) -or $uniOdd.Contains($sl)) {
            $found.Add(@{ S = $sig; Class = "Chat" }) | Out-Null
        }
    }
    return $found
}

# ---- FIX (v4.5): validate parent creation time. A PID that was recycled after
# ---- its owner exited produced a completely fabricated launch chain in v4.4.
function Get-ProcessAncestry($procPid) {
    $chain   = [System.Collections.Generic.List[object]]::new()
    $current = $procPid
    $visited = [System.Collections.Generic.HashSet[int]]::new()
    $childCreated = $null
    while ($current -gt 0 -and -not $visited.Contains($current)) {
        [void]$visited.Add($current)
        try {
            $p = Get-CimInstance Win32_Process -Filter "ProcessId=$current" -ErrorAction Stop | Select-Object -First 1
            if (-not $p) { break }
            $created = $p.CreationDate
            if ($childCreated -and $created -and $created -gt $childCreated) {
                $chain.Add([PSCustomObject]@{
                    PID = [int]$p.ProcessId; Name = $p.Name; Path = $p.ExecutablePath
                    PPID = [int]$p.ParentProcessId; Created = $created
                    Suspect = $true
                    Note = "PID REUSED -- parent started after child; ancestry beyond this point is unreliable"
                })
                break
            }
            $chain.Add([PSCustomObject]@{
                PID = [int]$p.ProcessId; Name = $p.Name; Path = $p.ExecutablePath
                PPID = [int]$p.ParentProcessId; Created = $created; Suspect = $false; Note = ""
            })
            $childCreated = $created
            $current = [int]$p.ParentProcessId
        } catch { break }
    }
    return $chain
}

# ---- NEW (v4.5): resolve Roblox install roots from the RUNNING process plus
# ---- known launcher roots. v4.4 hardcoded three official paths, so on any
# ---- machine using Fishstrap/Bloxstrap the entire client integrity scan was
# ---- skipped and printed "[OK] No Roblox installation found".
function Get-RobloxInstallRoots {
    $roots = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    foreach ($p in @(Get-RobloxProcs)) {
        try { [void]$roots.Add((Split-Path $p.MainModule.FileName -Parent)) } catch {}
    }
    $bases = @(
        "$env:LOCALAPPDATA\Roblox\Versions",
        "$env:PROGRAMFILES\Roblox\Versions",
        "${env:PROGRAMFILES(X86)}\Roblox\Versions"
    )
    foreach ($l in $knownThirdPartyLaunchers) {
        $bases += "$env:LOCALAPPDATA\$l\Versions"
    }
    foreach ($b in $bases) {
        if (Test-Path $b) {
            Get-ChildItem $b -Directory -ErrorAction SilentlyContinue |
                Where-Object { $_.Name -match '^version-' } |
                ForEach-Object { [void]$roots.Add($_.FullName) }
        }
    }
    return @($roots)
}

function Get-LauncherModFolders {
    $mods = [System.Collections.Generic.List[string]]::new()
    foreach ($l in $knownThirdPartyLaunchers) {
        foreach ($sub in @("Modifications","Mods")) {
            $p = "$env:LOCALAPPDATA\$l\$sub"
            if (Test-Path $p) { $mods.Add($p) | Out-Null }
        }
    }
    return $mods
}

# ---- NEW (v4.5): Zone.Identifier alternate data stream. Downloaded files carry
# ---- their source URL. High signal, near-zero false positives.
function Get-DownloadProvenance($path) {
    try {
        $ads = Get-Content -Path $path -Stream Zone.Identifier -ErrorAction Stop
        $hostUrl = ($ads | Where-Object { $_ -like "HostUrl=*" } | Select-Object -First 1)
        $refUrl  = ($ads | Where-Object { $_ -like "ReferrerUrl=*" } | Select-Object -First 1)
        $zone    = ($ads | Where-Object { $_ -like "ZoneId=*" } | Select-Object -First 1)
        if (-not $hostUrl -and -not $refUrl) { return $null }
        return [PSCustomObject]@{
            HostUrl     = if ($hostUrl) { $hostUrl -replace '^HostUrl=','' } else { "" }
            ReferrerUrl = if ($refUrl)  { $refUrl  -replace '^ReferrerUrl=','' } else { "" }
            ZoneId      = if ($zone)    { $zone    -replace '^ZoneId=','' } else { "" }
        }
    } catch { return $null }
}

