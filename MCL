    public class WinInfo {
        public IntPtr Handle; public string Title; public string ClassName;
        public uint Pid; public uint Affinity; public bool Visible;
    }

    public static List<WinInfo> GetHiddenFromCapture() {
        var hits = new List<WinInfo>();
        EnumWindows(delegate(IntPtr h, IntPtr l) {
            uint aff;
            if (GetWindowDisplayAffinity(h, out aff) && aff != WDA_NONE) {
                var t = new StringBuilder(512); GetWindowTextW(h, t, 512);
                var c = new StringBuilder(256); GetClassNameW(h, c, 256);
                uint pid; GetWindowThreadProcessId(h, out pid);
                hits.Add(new WinInfo {
                    Handle = h, Title = t.ToString(), ClassName = c.ToString(),
                    Pid = pid, Affinity = aff, Visible = IsWindowVisible(h)
                });
            }
            return true;
        }, IntPtr.Zero);
        return hits;
    }
}
