# ---- NEW (v4.5): MAM (XPRESS_HUFF) decompression for Windows 10/11 prefetch.
# Without this, prefetch run counts and per-run timestamps never parse.
if (-not ([Management.Automation.PSTypeName]'PfDecomp').Type) {
    Add-Type -TypeDefinition @"
using System;
using System.Runtime.InteropServices;
public class PfDecomp {
    const ushort COMPRESSION_FORMAT_XPRESS_HUFF = 0x0004;

    [DllImport("ntdll.dll")]
    static extern uint RtlGetCompressionWorkSpaceSize(
        ushort CompressionFormatAndEngine,
        out uint CompressBufferWorkSpaceSize,
        out uint CompressFragmentWorkSpaceSize);

    [DllImport("ntdll.dll")]
    static extern uint RtlDecompressBufferEx(
        ushort CompressionFormat,
        byte[] UncompressedBuffer, int UncompressedBufferSize,
        byte[] CompressedBuffer,   int CompressedBufferSize,
        out int FinalUncompressedSize,
        byte[] WorkSpace);

    // Returns the decompressed prefetch body, or the original bytes if the
    // file is not MAM-compressed. Returns null on failure.
    public static byte[] Decompress(byte[] raw) {
        if (raw == null || raw.Length < 8) return raw;
        if (!(raw[0] == 0x4D && raw[1] == 0x41 && raw[2] == 0x4D)) return raw; // not "MAM"

        bool hasCrc = (raw[3] & 0x80) != 0;
        int headerLen = hasCrc ? 12 : 8;
        if (raw.Length <= headerLen) return null;

        int uncompressedSize = BitConverter.ToInt32(raw, 4);
        if (uncompressedSize <= 0 || uncompressedSize > 64 * 1024 * 1024) return null;

        uint wsCompress, wsFragment;
        if (RtlGetCompressionWorkSpaceSize(COMPRESSION_FORMAT_XPRESS_HUFF,
                out wsCompress, out wsFragment) != 0) return null;

        byte[] workspace  = new byte[wsFragment];
        byte[] output     = new byte[uncompressedSize];
        int    compLen    = raw.Length - headerLen;
        byte[] compressed = new byte[compLen];
        Buffer.BlockCopy(raw, headerLen, compressed, 0, compLen);

        int finalSize;
        uint status = RtlDecompressBufferEx(
            COMPRESSION_FORMAT_XPRESS_HUFF,
            output, output.Length,
            compressed, compressed.Length,
            out finalSize, workspace);

        if (status != 0) return null;
        if (finalSize == output.Length) return output;
        byte[] trimmed = new byte[finalSize];
        Buffer.BlockCopy(output, 0, trimmed, 0, finalSize);
        return trimmed;
    }
}
"@ -ErrorAction SilentlyContinue
}

