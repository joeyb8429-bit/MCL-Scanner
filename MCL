# Tier A hits are tracked so Tier B findings can be promoted if corroborated.
$script:TierAHits = [System.Collections.Generic.List[string]]::new()

function Add-Finding {
    param(
        [string]$Section,
        [string]$Type,
        [string]$Detail,
        [string]$Value    = "",
        [ValidateSet("Critical","Review","Info","Context")]
        [string]$Severity = "Review",
        [string]$Tier     = "",
        [string]$Evidence = ""
    )
    if (-not $script:Sections.Contains($Section)) { return }
    Mark-Ran $Section

    # Tier B and C can never be Critical on their own (item: dual-use terms).
    if ($Tier -eq "B" -and $Severity -eq "Critical") { $Severity = "Review" }
    if ($Tier -eq "C") { $Severity = "Context" }

    $findings.Add([PSCustomObject]@{
        Section   = $Section
        Type      = $Type
        Detail    = $Detail
        Value     = $Value
        Severity  = $Severity
        Tier      = $Tier
        Evidence  = $Evidence
        Timestamp = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
    })
    switch ($Severity) {
        "Critical" { $script:Sections[$Section].Critical++ }
        "Review"   { $script:Sections[$Section].Review++   }
        "Info"     { $script:Sections[$Section].Info++     }
        "Context"  { $script:Sections[$Section].Context++  }
    }
    if ($Tier -eq "A") { $script:TierAHits.Add($Detail) | Out-Null }
}

function Add-Timeline($event) {
    $timeline.Add([PSCustomObject]@{
        Event   = $event
        Time    = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
        TimeUtc = (Get-Date).ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")
    })
}

