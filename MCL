function New-DarkForm($title) {
    $form = New-Object System.Windows.Forms.Form
    $form.Text = "$title | ENTER to close"
    $form.WindowState = 'Maximized'
    $form.BackColor = [System.Drawing.Color]::FromArgb(13,13,18)
    $form.ControlBox = $false
    return $form
}
function New-CloseBar($text) {
    $bar = New-Object System.Windows.Forms.Label
    $bar.Dock = 'Bottom'; $bar.Height = 28
    $bar.Text = "  ENTER to close  |  $text"
    $bar.ForeColor = [System.Drawing.Color]::FromArgb(0,212,255)
    $bar.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
    $bar.Font = New-Object System.Drawing.Font("Consolas",9)
    $bar.TextAlign = 'MiddleLeft'
    return $bar
}
function New-DarkListView($cols) {
    $lv = New-Object System.Windows.Forms.ListView
    $lv.View='Details'; $lv.FullRowSelect=$true; $lv.GridLines=$true; $lv.Dock='Fill'
    $lv.Scrollable = $true
    $lv.HideSelection = $false
    $lv.Font = New-Object System.Drawing.Font("Consolas",9)
    $lv.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
    $lv.ForeColor = [System.Drawing.Color]::FromArgb(224,224,224)
    foreach ($c in $cols) { [void]$lv.Columns.Add($c[0],$c[1]) }
    return $lv
}
function Set-RowSeverity($item, $sev) {
    switch ($sev) {
        "Critical" { $item.BackColor = [System.Drawing.Color]::FromArgb(60,0,0);  $item.ForeColor = [System.Drawing.Color]::FromArgb(255,80,80) }
        "Review"   { $item.ForeColor = [System.Drawing.Color]::FromArgb(255,215,0) }
        "Clear"    { $item.ForeColor = [System.Drawing.Color]::FromArgb(0,255,136) }
        default    { $item.ForeColor = [System.Drawing.Color]::FromArgb(140,146,160) }
    }
}
function Add-EmptyRow($lv, $msg, $sev = "Clear") {
    $it = New-Object System.Windows.Forms.ListViewItem($(if ($sev -eq "Clear") { "Clear" } else { "Not checked" }))
    Set-RowSeverity $it $sev
    [void]$it.SubItems.Add($msg)
    [void]$lv.Items.Add($it)
}
function New-DetailPane {
    $tb = New-Object System.Windows.Forms.TextBox
    $tb.Multiline   = $true
    $tb.ReadOnly    = $true
    $tb.Dock        = 'Bottom'
    $tb.Height      = 130
    $tb.ScrollBars  = 'Vertical'
    $tb.WordWrap    = $true
    $tb.Font        = New-Object System.Drawing.Font("Consolas",9)
    $tb.BackColor   = [System.Drawing.Color]::FromArgb(22,27,39)
    $tb.ForeColor   = [System.Drawing.Color]::FromArgb(224,224,224)
    $tb.BorderStyle = 'FixedSingle'
    $tb.Text        = "Select a row to read every column in full here (including Evidence, which is cut off in the grid above)."
    return $tb
}

function Wire-Detail($lv, $tb) {
    $lv.Add_SelectedIndexChanged({
        if ($lv.SelectedItems.Count -eq 0) { return }
        $it = $lv.SelectedItems[0]
        $sb = New-Object System.Text.StringBuilder
        for ($i = 0; $i -lt $lv.Columns.Count; $i++) {
            $hdr = $lv.Columns[$i].Text
            $val = if ($i -lt $it.SubItems.Count) { $it.SubItems[$i].Text } else { "" }
            [void]$sb.AppendLine(("{0,-16}: {1}" -f $hdr, $val))
        }
        $tb.Text = $sb.ToString()
    }.GetNewClosure())
    # Ctrl+C copies the selected row, so a long Evidence string can leave the GUI
    $lv.Add_KeyDown({
        param($sender,$e)
        if ($e.Control -and $e.KeyCode -eq [System.Windows.Forms.Keys]::C -and $tb.Text) {
            [System.Windows.Forms.Clipboard]::SetText($tb.Text)
        }
    }.GetNewClosure())
}

function Show-FinalForm($form) {
    $form.KeyPreview = $true
    $form.Add_KeyDown({ param($s,$e); if ($e.KeyCode -eq [System.Windows.Forms.Keys]::Enter) { $form.Close() } })
    [void]$form.ShowDialog()
}

# Single overview viewer -- replaces v4.4's six sequential modal dialogs.
function Show-OverviewGui($verdict) {
    $form = New-DarkForm "Scan Overview -- $($verdict.Line)"
    $form.Controls.Add((New-CloseBar "Red=confirmed  Amber=review  Grey=not checked/context  |  Columns run off the right: use the horizontal scrollbar or arrow keys, or click a row to read it in full below.  Ctrl+C copies the selected row."))
    $tab = New-Object System.Windows.Forms.TabControl
    $tab.Dock='Fill'; $tab.Font = New-Object System.Drawing.Font("Consolas",9)

    function New-Tab($name) {
        $tp = New-Object System.Windows.Forms.TabPage($name)
        $tp.BackColor = [System.Drawing.Color]::FromArgb(17,24,39)
        $tp.ForeColor = [System.Drawing.Color]::FromArgb(0,212,255)
        return $tp
    }

    # --- Status
    $tp = New-Tab "Status"
    $lv = New-DarkListView @(("Section",240),("Status",120),("Note",760))
    foreach ($env in @(
        @("Windows",       $script:OsCaption),
        @("Installed",     "$script:InstallDate $script:InstallAge"),
        @("Last boot",     "$script:BootTime (up $script:UptimeStr)"),
        @("Activation",    $script:ActivationState),
        @("Shadow copies", [string]$script:ShadowCount),
        @("Timezone",      "$script:TzAbbr (UTC$tzOffset)")
    )) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$env[0])
        [void]$it.SubItems.Add("info")
        [void]$it.SubItems.Add([string]$env[1])
        Set-RowSeverity $it "Context"
        [void]$lv.Items.Add($it)
    }
    foreach ($s in $script:Sections.Values) {
        $state = Get-SectionState $s
        $it = New-Object System.Windows.Forms.ListViewItem([string]$s.Name)
        [void]$it.SubItems.Add($state)
        $note = switch ($state) {
            "Critical" { "$($s.Critical) confirmed, $($s.Review) review" }
            "Review"   { "$($s.Review) item(s)" }
            "Clear"    { $s.Coverage }
            default    { "NOT CHECKED -- $($s.Reason)" }
        }
        [void]$it.SubItems.Add([string]$note)
        Set-RowSeverity $it $(if ($state -eq "Clear") { "Clear" } elseif ($state -eq "Unchecked") { "Context" } else { $state })
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Findings
    $scored = @($findings | Where-Object { $_.Severity -in @("Critical","Review") })
    $tp = New-Tab "Findings ($($scored.Count))"
    $lv = New-DarkListView @(("Severity",90),("Tier",50),("Section",180),("Type",180),("Detail",520),("Evidence",380))
    if ($scored.Count -eq 0) { Add-EmptyRow $lv "No scored findings" }
    $tierOrder = @{E={ switch ($_.Tier) { "A" {0} "B" {1} "C" {2} default {3} } }}
    foreach ($f in ($scored | Sort-Object $tierOrder, Section, Type, Detail)) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$f.Severity)
        [void]$it.SubItems.Add([string]$f.Tier)
        [void]$it.SubItems.Add([string]$f.Section)
        [void]$it.SubItems.Add([string]$f.Type)
        [void]$it.SubItems.Add([string]$f.Detail)
        [void]$it.SubItems.Add([string]$f.Evidence)
        Set-RowSeverity $it $f.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Modules
    $tp = New-Tab "Modules ($($moduleFindings.Count))"
    $lv = New-DarkListView @(("Process",160),("PID",70),("Module",600),("Signer",380),("Status",120))
    if ($moduleFindings.Count -eq 0) {
        if ($script:Sections["Loaded Modules"].Ran) { Add-EmptyRow $lv "All modules Roblox/Microsoft-signed or OS-resident" }
        else { Add-EmptyRow $lv $script:Sections["Loaded Modules"].Reason "Context" }
    }
    foreach ($m in $moduleFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$m.Process)
        [void]$it.SubItems.Add([string]$m.PID); [void]$it.SubItems.Add([string]$m.Module)
        [void]$it.SubItems.Add([string]$m.Signer); [void]$it.SubItems.Add([string]$m.Status)
        Set-RowSeverity $it $m.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Provenance
    $tp = New-Tab "Downloads ($($provenanceFindings.Count))"
    $lv = New-DarkListView @(("File",520),("Host URL",520),("Referrer",380),("Match",140))
    if ($provenanceFindings.Count -eq 0) { Add-EmptyRow $lv "No files with a recorded download origin" }
    foreach ($p in $provenanceFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$p.File)
        [void]$it.SubItems.Add([string]$p.HostUrl); [void]$it.SubItems.Add([string]$p.Referrer); [void]$it.SubItems.Add([string]$p.Match)
        Set-RowSeverity $it $p.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Memory / threads / handles / pipes
    $tp = New-Tab "Memory"
    $lv = New-DarkListView @(("Kind",120),("Detail",420),("Address / info",300),("Region",260))
    if ($memoryFindings.Count -eq 0 -and $threadFindings.Count -eq 0 -and $hollowFindings.Count -eq 0 -and $handleFindings.Count -eq 0 -and $pipeFindings.Count -eq 0) {
        if ($script:Sections["Process Memory"].Ran) { Add-EmptyRow $lv $script:Sections["Process Memory"].Coverage }
        else { Add-EmptyRow $lv $script:Sections["Process Memory"].Reason "Context" }
    }
    foreach ($m in $memoryFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("String");  [void]$it.SubItems.Add([string]$m.String); [void]$it.SubItems.Add([string]$m.Address); [void]$it.SubItems.Add([string]$m.Region); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($t in $threadFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Thread");  [void]$it.SubItems.Add("TID $($t.ThreadID) in $($t.Name)"); [void]$it.SubItems.Add([string]$t.StartAddr); [void]$it.SubItems.Add([string]$t.Protection); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($h in $hollowFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Hollow");  [void]$it.SubItems.Add("$($h.Name) PID $($h.PID)"); [void]$it.SubItems.Add([string]$h.Path); [void]$it.SubItems.Add([string]$h.Note); Set-RowSeverity $it "Critical"; [void]$lv.Items.Add($it) }
    foreach ($h in $handleFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Handle");  [void]$it.SubItems.Add("$($h.OwnerName) PID $($h.OwnerPID)"); [void]$it.SubItems.Add([string]$h.Access); [void]$it.SubItems.Add([string]$h.OwnerPath); Set-RowSeverity $it $(if ($h.CheatMatch -or $h.VMWrite) { "Critical" } else { "Review" }); [void]$lv.Items.Add($it) }
    foreach ($p in $pipeFindings)          { $it = New-Object System.Windows.Forms.ListViewItem("Pipe");    [void]$it.SubItems.Add([string]$p.PipeName); [void]$it.SubItems.Add([string]$p.Match); [void]$it.SubItems.Add([string]$p.Tier); Set-RowSeverity $it $(if ($p.Tier -eq "A") { "Critical" } else { "Review" }); [void]$lv.Items.Add($it) }
    foreach ($m in $moduleFindings)        { $it = New-Object System.Windows.Forms.ListViewItem("Module");  [void]$it.SubItems.Add("$($m.Process) PID $($m.PID)"); [void]$it.SubItems.Add([string]$m.Module); [void]$it.SubItems.Add([string]$m.Signer); Set-RowSeverity $it $m.Severity; [void]$lv.Items.Add($it) }
    foreach ($m in $suspiciousMemFindings) { $it = New-Object System.Windows.Forms.ListViewItem("Chat str"); [void]$it.SubItems.Add([string]$m.String); [void]$it.SubItems.Add([string]$m.Address); [void]$it.SubItems.Add("context only"); Set-RowSeverity $it "Context"; [void]$lv.Items.Add($it) }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Prefetch
    $tp = New-Tab "Prefetch ($($prefetchViewerData.Count))"
    $lv = New-DarkListView @(("Exe",240),("Last run",230),("Runs",60),("Parsed",70),("Tier",50),("Match",140),("All run times",640))
    $pfSorted = $prefetchViewerData |
        Sort-Object @{E={[int]$_.RunCount}; Descending=$true}, @{E={$_.LastRun}; Descending=$true}
    foreach ($r in $pfSorted) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$r.Exe)
        [void]$it.SubItems.Add((Format-ViewTime $r.LastRun)); [void]$it.SubItems.Add([string]$r.RunCount)
        [void]$it.SubItems.Add($(if ($r.Parsed) { "yes" } else { "NO" }))
        [void]$it.SubItems.Add([string]$r.Tier); [void]$it.SubItems.Add([string]$r.Match)
        [void]$it.SubItems.Add((Format-ViewTimeList $r.AllRunTimes))
        $sev = if ($r.Tier -eq "A") { "Critical" } elseif ($r.Tier -eq "B") { "Review" } elseif ($r.Match) { "Context" } else { "Clear" }
        Set-RowSeverity $it $sev
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- BAM
    $tp = New-Tab "BAM ($($bamViewerData.Count))"
    $lv = New-DarkListView @(("Last run",230),("Path",700),("Tier",50),("Match",160))
    foreach ($r in ($bamViewerData | Sort-Object @{E={ switch ($_.Tier) { "A" {0} "B" {1} default {2} } }}, @{E={$_.LastRun}; Descending=$true})) {
        $it = New-Object System.Windows.Forms.ListViewItem((Format-ViewTime $r.LastRun))
        [void]$it.SubItems.Add([string]$r.Path); [void]$it.SubItems.Add([string]$r.Tier); [void]$it.SubItems.Add([string]$r.Match)
        Set-RowSeverity $it $(if ($r.Tier -eq "A") { "Critical" } elseif ($r.Tier -eq "B") { "Review" } else { "Clear" })
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Delta
    $tp = New-Tab "Delta ($($deltaFindings.Count))"
    $lv = New-DarkListView @(("Category",140),("Change",120),("Entry",620),("Note",420))
    if ($deltaFindings.Count -eq 0) { Add-EmptyRow $lv "No baseline comparison performed" "Context" }
    foreach ($d in $deltaFindings) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$d.Category)
        [void]$it.SubItems.Add([string]$d.Change); [void]$it.SubItems.Add([string]$d.Entry); [void]$it.SubItems.Add([string]$d.Note)
        Set-RowSeverity $it $d.Severity
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    # --- Suppressed
    $tp = New-Tab "Suppressed ($($suppressed.Count))"
    $lv = New-DarkListView @(("Type",180),("Detail",760),("Reason",460))
    if ($suppressed.Count -eq 0) { Add-EmptyRow $lv "Nothing suppressed" }
    foreach ($f in $suppressed) {
        $it = New-Object System.Windows.Forms.ListViewItem([string]$f.Type)
        [void]$it.SubItems.Add([string]$f.Detail); [void]$it.SubItems.Add([string]$f.Reason)
        Set-RowSeverity $it "Context"
        [void]$lv.Items.Add($it)
    }
    $det = New-DetailPane; Wire-Detail $lv $det
    $tp.Controls.Add($lv); $tp.Controls.Add($det); [void]$tab.TabPages.Add($tp)

    $form.Controls.Add($tab)
    Show-FinalForm $form
}

# =====================================================
# MAIN
# =====================================================
Write-Banner
Select-TimeRange

$scannerHash = if ($PSCommandPath) { Get-FileSha256 $PSCommandPath }
               else { "UNAVAILABLE -- script was pasted into the console, not run from a file" }
$script:OsCaption       = "unknown"
$script:BootTime        = "unknown"
$script:UptimeStr       = "unknown"
$script:InstallDate     = "unknown"
$script:InstallAge      = ""
$script:ActivationState = "unknown"
$script:ShadowCount     = 0
$script:VolumeSerial = ""
try { $script:VolumeSerial = (Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'" -ErrorAction Stop).VolumeSerialNumber } catch {}

if (-not $Unattended) {
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host "  |  FIRST SCAN : Roblox CLOSED  -- saves baseline snapshot   |" -ForegroundColor Yellow
    Write-Host "  |  SECOND SCAN: Roblox OPEN, in a game, 1-3 min, run again  |" -ForegroundColor Yellow
    Write-Host "  +============================================================+" -ForegroundColor Yellow
    Write-Host ""
}
if ($PSCommandPath) {
    Write-Info "Scanner build  : $scannerHash"
} else {
    Write-Warn "Scanner build  : UNAVAILABLE -- run the .ps1 from disk, not pasted into the console."
    Write-Warn "                 This report will not identify which build produced it."
}
Write-Info "Volume serial  : $script:VolumeSerial"
Write-Host ""

$robloxRunning = @(Get-Process -ErrorAction SilentlyContinue | Where-Object { $robloxProcessNames -contains $_.ProcessName })
$script:RobloxBaselinePids = @($robloxRunning | Select-Object -ExpandProperty Id | Sort-Object)
if ($robloxRunning.Count -gt 0) {
    Write-OK "Roblox running: $(($robloxRunning | ForEach-Object { "$($_.ProcessName) PID $($_.Id)" }) -join ', ')"
} else {
    Write-Warn "Roblox NOT running -- module, memory, handle, pipe and launch-chain sections will report NOT CHECKED"
}
Write-Host ""

$previousSnapshot = Load-PreviousSnapshot
$runDelta = $false
if ($previousSnapshot) {
    Write-Info "Previous snapshot: $($previousSnapshot.Timestamp)"
    if ($Unattended) { $runDelta = $true }
    else {
        $resp = Read-Host "  Compare against previous scan? (Y/N)"
        if ($resp -match '^[Yy]') { $runDelta = $true }
        else { Mark-Skipped "Snapshot Delta" "operator declined the baseline comparison at the prompt" }
    }
} else {
    Write-Info "No previous snapshot -- this run is the baseline"
    Mark-Skipped "Snapshot Delta" "no previous snapshot to compare against"
    Pause-Step "  Press ENTER to begin"
}
Write-Host ""

Write-Info "Taking snapshot..."
$currentSnapshot = Get-CurrentSnapshot
Write-OK "Snapshot: BAM=$($currentSnapshot.BAM.Count) MUI=$($currentSnapshot.MUICache.Count) UA=$($currentSnapshot.UserAssist.Count) Shim=$($currentSnapshot.Shimcache.Count) PF=$($currentSnapshot.Prefetch.Count)"
Pause-Step "  Press ENTER to begin the scan"

Run-SecurityProductScan
Run-Section1
Run-Section2
Run-Section3
Run-BAMParser
Run-Section4
Run-Section5
Run-Section6
Run-Section7
Run-RobloxClientIntegrity
Run-ModuleScan
Run-MemoryScan
Run-InjectionHostScan
Run-CaptureEvasionScan
Run-BrowserHistoryScan
Run-CheatConfigScan
Run-PESignatureScan
Run-SignatureScan
Run-KernelDriverScan
Run-LaunchChainScan
Run-ProvenanceScan
Run-RenamedBinaryScan
Run-PANScan
Run-RecentFilesScan
Run-RecycleBinScan
Run-BrowserDownloadScan
Run-CrashArtifactScan
Run-HashBlocklistScan
Run-AmCacheScan

if ($runDelta -and $previousSnapshot) { Compare-Snapshots $previousSnapshot $currentSnapshot }

$snapHash = Save-Snapshot $currentSnapshot
if ($snapHash) { Write-OK "Snapshot saved: $snapshotPath (sha256 $snapHash)" }
else { Write-Warn "Could not save snapshot" }
Write-Host ""
Write-Host "  NOTE: the baseline lives on this machine. Anyone with access to it" -ForegroundColor DarkGray
Write-Host "        can edit it between scans. Keep a copy of the hash elsewhere," -ForegroundColor DarkGray
Write-Host "        or hold the baseline off-machine with -BaselinePath." -ForegroundColor DarkGray
Write-Host ""

$verdict = Show-Summary
$reportFile = Generate-Report $verdict $scannerHash

if (-not $Unattended) {
    Pause-Step "  Press ENTER to open the overview viewer"
    Show-OverviewGui $verdict
}

Write-Host ""
Write-OK "Done. Report: $reportFile"
if ($verdict.Skipped -gt 0) {
    Write-Host "  $($verdict.Skipped) section(s) were NOT CHECKED. Read the status table before drawing a conclusion." -ForegroundColor DarkGray
}
