function Mark-Ran($section, $coverage = "") {
    if ($script:Sections.Contains($section)) {
        $script:Sections[$section].Ran = $true
        if ($coverage) { $script:Sections[$section].Coverage = $coverage }
    }
}
function Mark-Skipped($section, $reason) {
    if ($script:Sections.Contains($section)) {
        $script:Sections[$section].Ran    = $false
        $script:Sections[$section].Reason = $reason
    }
}
function Get-SectionState($sec) {
    if (-not $sec.Ran)       { return "Unchecked" }
    if ($sec.Critical -gt 0) { return "Critical"  }
    if ($sec.Review   -gt 0) { return "Review"    }
    return "Clear"
}
function Get-StateColor($state) {
    switch ($state) {
        "Critical"  { return "Red" }
        "Review"    { return "Yellow" }
        "Clear"     { return "Green" }
        default     { return "DarkGray" }
    }
}

