# ---- FIX (v4.5): v4.4 used $buf[0..($read-1)], which allocates an object[] of
# ---- up to 512K elements per file. Straight indexed loop instead.
function Get-FileEntropy($path) {
    try {
        $info = Get-Item $path -ErrorAction Stop
        if ($info.Length -lt 4096) { return -1.0 }
        $sample = [int][math]::Min([int64]$info.Length, 512KB)
        $fs   = [System.IO.File]::OpenRead($path)
        try {
            $buf  = New-Object byte[] $sample
            $read = $fs.Read($buf, 0, $sample)
        } finally { $fs.Dispose() }
        if ($read -lt 64) { return -1.0 }
        $freq = New-Object int[] 256
        for ($i = 0; $i -lt $read; $i++) { $freq[$buf[$i]]++ }
        $entropy = 0.0
        for ($i = 0; $i -lt 256; $i++) {
            $f = $freq[$i]
            if ($f -gt 0) {
                $p = $f / $read
                $entropy -= $p * [math]::Log($p, 2)
            }
        }
        return [math]::Round($entropy, 4)
    } catch { return -1.0 }
}

# ---- FIX (v4.5): v4.4 called ReadAllBytes() on every exe just to read the
# ---- first 64KB. A large file in Downloads could OOM the whole scan.
function Get-PEHeaderString($path, $bytesToRead = 65536) {
    try {
        $fs = [System.IO.File]::OpenRead($path)
        try {
            $len = [int][math]::Min([int64]$bytesToRead, $fs.Length)
            if ($len -lt 64) { return "" }
            $buf  = New-Object byte[] $len
            $read = $fs.Read($buf, 0, $len)
            if ($read -le 0) { return "" }
            return [System.Text.Encoding]::ASCII.GetString($buf, 0, $read)
        } finally { $fs.Dispose() }
    } catch { return "" }
}

# ---- FIX (v4.5): prefetch files on Win10/11 are MAM-compressed. v4.4 read the
# ---- MAM signature as a version number, fell through to the else branch, and
# ---- read garbage at offset 128 -- so RunCount was always 0 and LastRun was
# ---- silently falling back to the file's mtime.
function Get-PrefetchInfo($path) {
    $result = [PSCustomObject]@{ Times = @(); RunCount = 0; Parsed = $false }
    try {
        $raw = [System.IO.File]::ReadAllBytes($path)
        $bytes = [PfDecomp]::Decompress($raw)
        if (-not $bytes -or $bytes.Length -lt 136) { return $result }

        $version = [System.BitConverter]::ToUInt32($bytes, 0)
        # 23=WinVista/7, 26=Win8, 30=Win10, 31=Win11
        if ($version -notin @(17,23,26,30,31)) { return $result }

        $times = [System.Collections.Generic.List[DateTime]]::new()
        $slots = if ($version -ge 26) { 8 } else { 1 }
        $tsOffset = switch ($version) {
            17      { 0x78 }
            23      { 0x80 }
            26      { 0x80 }
            default { 0x80 }
        }
        for ($i = 0; $i -lt $slots; $i++) {
            $off = $tsOffset + ($i * 8)
            if ($off + 8 -gt $bytes.Length) { break }
            $ft = [System.BitConverter]::ToInt64($bytes, $off)
            if ($ft -gt 0 -and $ft -lt 999999999999999999L) {
                try { $times.Add([DateTime]::FromFileTimeUtc($ft).ToLocalTime()) } catch {}
            }
        }
        $rcOffset = switch ($version) { 17 { 0x90 } 23 { 0x98 } default { 0xD0 } }
        $runCount = 0
        if ($rcOffset + 4 -le $bytes.Length) {
            $runCount = [System.BitConverter]::ToInt32($bytes, $rcOffset)
            if ($runCount -lt 0 -or $runCount -gt 1000000) { $runCount = 0 }
        }
        $result.Times    = @($times | Sort-Object -Descending)
        $result.RunCount = $runCount
        $result.Parsed   = ($times.Count -gt 0)
    } catch {}
    return $result
}

# Roblox process set is captured once at scan start. If it changes mid-scan the
# sections are no longer describing the same process instance, and the report
# must say so rather than silently mixing them.
